diff --git a/d16coverage/main.go b/d16coverage/main.go
new file mode 100644
index 0000000..87f1ec0
--- /dev/null
+++ b/d16coverage/main.go
@@ -0,0 +1,419 @@
+// d16coverage measures how much of real Ethereum mainnet traffic the EPR extractor (the same code the
+// fabric-x-evm endorser runs: EPRTracer + EPRProgTracer + EPRRewriteTx) turns into repairable writes.
+//
+// For every transaction of the sampled blocks it fetches the pre-state of the accounts and slots the
+// transaction touches (debug_traceTransaction with prestateTracer), replays the transaction in a fresh
+// in-memory go-ethereum state with the EPR tracers attached, checks the replay against the receipt
+// (status and gas), builds the endorser's read-write set ("str:<addr>:<slot>" keys, every pre-existing
+// slot read at a ledger version) and classifies every storage write as a guarded delta, part of a signed
+// program, or plain. Two settings: "strict" keeps the gas headroom rule (assumption A7: 20k gas left per
+// written slot, with the transaction's real gas limit, which mainnet wallets set for plain execution);
+// "capable" assumes the client leaves enough headroom.
+//
+// Output: one JSON line per transaction. Usage:
+//
+//	d16coverage -rpc https://eth.drpc.org -start 24000000 -runs 20 -run-len 10 -stride 50000 -out cov.jsonl
+package main
+
+import (
+	"bufio"
+	"bytes"
+	"compress/gzip"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"log"
+	"math/big"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/common/hexutil"
+	"github.com/ethereum/go-ethereum/consensus"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+	"github.com/hyperledger/fabric-x-sdk/blocks"
+
+	"github.com/hyperledger/fabric-x-evm/endorser/execution"
+)
+
+var rpcURL string
+
+// cacheDir, if set, keeps every successful RPC result (gzip, keyed by the request), so that a rerun with
+// another extractor version replays exactly the same inputs without the network.
+var cacheDir string
+
+func cachePath(body []byte) string {
+	h := sha256.Sum256(body)
+	return filepath.Join(cacheDir, hex.EncodeToString(h[:16])+".json.gz")
+}
+
+func cacheGet(body []byte) ([]byte, bool) {
+	if cacheDir == "" {
+		return nil, false
+	}
+	f, err := os.Open(cachePath(body))
+	if err != nil {
+		return nil, false
+	}
+	defer f.Close()
+	zr, err := gzip.NewReader(f)
+	if err != nil {
+		return nil, false
+	}
+	b, err := io.ReadAll(zr)
+	return b, err == nil
+}
+
+func cachePut(body, result []byte) {
+	if cacheDir == "" {
+		return
+	}
+	p := cachePath(body)
+	tmp, err := os.CreateTemp(cacheDir, ".tmp-*")
+	if err != nil {
+		return
+	}
+	zw := gzip.NewWriter(tmp)
+	_, err = zw.Write(result)
+	if err2 := zw.Close(); err == nil {
+		err = err2
+	}
+	if err2 := tmp.Close(); err == nil {
+		err = err2
+	}
+	if err != nil {
+		os.Remove(tmp.Name())
+		return
+	}
+	os.Rename(tmp.Name(), p)
+}
+
+func call(method string, params []any, out any) error {
+	body, _ := json.Marshal(map[string]any{"jsonrpc": "2.0", "id": 1, "method": method, "params": params})
+	if b, ok := cacheGet(body); ok {
+		return json.Unmarshal(b, out)
+	}
+	var last error
+	for i := 0; i < 6; i++ {
+		resp, err := http.Post(rpcURL, "application/json", bytes.NewReader(body))
+		if err == nil {
+			b, _ := io.ReadAll(resp.Body)
+			resp.Body.Close()
+			var r struct {
+				Result json.RawMessage `json:"result"`
+				Error  *struct {
+					Message string `json:"message"`
+				} `json:"error"`
+			}
+			if err = json.Unmarshal(b, &r); err == nil {
+				if r.Error != nil {
+					err = fmt.Errorf("rpc: %s", r.Error.Message)
+				} else if len(r.Result) == 0 || string(r.Result) == "null" {
+					err = fmt.Errorf("rpc: empty result")
+				} else {
+					cachePut(body, r.Result)
+					return json.Unmarshal(r.Result, out)
+				}
+			}
+		}
+		last = err
+		time.Sleep(time.Duration(1+2*i) * time.Second)
+	}
+	return last
+}
+
+type account struct {
+	Balance *hexutil.Big                `json:"balance"`
+	Nonce   uint64                      `json:"nonce"`
+	Code    hexutil.Bytes               `json:"code"`
+	Storage map[common.Hash]common.Hash `json:"storage"`
+}
+
+// rpcBlock decodes the header and the transactions separately: types.Header has its own UnmarshalJSON,
+// which would take over the whole object if the header were embedded.
+type rpcBlock struct {
+	Header types.Header
+	Txs    []*types.Transaction
+}
+
+func (b *rpcBlock) UnmarshalJSON(data []byte) error {
+	if err := json.Unmarshal(data, &b.Header); err != nil {
+		return err
+	}
+	var t struct {
+		Txs []*types.Transaction `json:"transactions"`
+	}
+	if err := json.Unmarshal(data, &t); err != nil {
+		return err
+	}
+	b.Txs = t.Txs
+	return nil
+}
+
+type receipt struct {
+	Status  hexutil.Uint64 `json:"status"`
+	GasUsed hexutil.Uint64 `json:"gasUsed"`
+}
+
+type chainCtx struct{}
+
+func (chainCtx) Engine() consensus.Engine                    { return nil }
+func (chainCtx) GetHeader(common.Hash, uint64) *types.Header { return nil }
+func (chainCtx) Config() *params.ChainConfig                 { return params.MainnetChainConfig }
+func (chainCtx) CurrentHeader() *types.Header                { return nil }
+func (chainCtx) GetHeaderByNumber(uint64) *types.Header      { return nil }
+func (chainCtx) GetHeaderByHash(common.Hash) *types.Header   { return nil }
+
+// storeKey is the endorser's storage key (endorser/execution/statedb.go).
+func storeKey(addr common.Address, slot common.Hash) string {
+	return "str:" + addr.Hex() + ":" + slot.Hex()
+}
+
+type writeOut struct {
+	Key    string `json:"k"`
+	Strict string `json:"s"` // delta | program | plain
+	Cap    string `json:"c"`
+}
+
+type txOut struct {
+	WhyStrict map[string]int64 `json:"why_s,omitempty"` // plain-write reasons of the delta extractor
+	WhyCap    map[string]int64 `json:"why_c,omitempty"`
+	ProgLost  string           `json:"prog_lost,omitempty"` // where program extraction gave up (capable run)
+	Block     uint64           `json:"block"`
+	Index     int              `json:"i"`
+	Hash      string           `json:"hash"`
+	To        string           `json:"to"`
+	Status    string           `json:"status"` // ok | replay_mismatch | error:<...>
+	GasLim    uint64           `json:"gas_limit"`
+	GasUsed   uint64           `json:"gas_used"`
+	Writes    []writeOut       `json:"writes"`
+}
+
+func classify(v []byte) string {
+	if len(v) == 30 && bytes.HasPrefix(v, execution.EPRMagic2) {
+		return "delta"
+	}
+	if _, ok := execution.DecodeEPRProgram(v); ok {
+		return "program"
+	}
+	return "plain"
+}
+
+// replay runs one transaction on its pre-state and returns the read-write set and the tracers.
+// capableExtra is the gas added to the limit for the capable setting: a client of an EPR chain leaves
+// room for commit-time evaluation, and the per-opcode gas rule is then checked on that run, so callees with a
+// fixed allowance still count against it.
+const capableExtra = 10_000_000
+
+func replay(hdr *types.Header, tx *types.Transaction, pre map[common.Address]*account, extra uint64) (blocks.ReadWriteSet, *execution.EPRTracer, *execution.EPRProgTracer, *core.ExecutionResult, error) {
+	sdb, err := state.New(types.EmptyRootHash, state.NewDatabaseForTesting())
+	if err != nil {
+		return blocks.ReadWriteSet{}, nil, nil, nil, err
+	}
+	for a, acc := range pre {
+		if acc.Balance != nil {
+			b, _ := uint256.FromBig((*big.Int)(acc.Balance))
+			sdb.SetBalance(a, b, tracing.BalanceChangeUnspecified)
+		}
+		sdb.SetNonce(a, acc.Nonce, tracing.NonceChangeUnspecified)
+		if len(acc.Code) > 0 {
+			sdb.SetCode(a, acc.Code, tracing.CodeChangeUnspecified)
+		}
+		for k, v := range acc.Storage {
+			sdb.SetState(a, k, v)
+		}
+	}
+	sdb.Finalise(true)
+	cfg := params.MainnetChainConfig
+	msg, err := core.TransactionToMessage(tx, types.MakeSigner(cfg, hdr.Number, hdr.Time), hdr.BaseFee)
+	if err != nil {
+		return blocks.ReadWriteSet{}, nil, nil, nil, err
+	}
+	if extra > 0 {
+		// stay within the per-transaction gas cap of EIP-7825 (2^24), which the replayed blocks enforce
+		if msg.GasLimit >= 1<<24 {
+			extra = 0
+		} else if msg.GasLimit+extra > 1<<24 {
+			extra = 1<<24 - msg.GasLimit
+		}
+		msg.GasLimit += extra
+		price := msg.GasPrice
+		if msg.GasFeeCap != nil && (price == nil || msg.GasFeeCap.Cmp(price) > 0) {
+			price = msg.GasFeeCap
+		}
+		if price != nil && price.Sign() > 0 {
+			top := new(uint256.Int).Mul(uint256.NewInt(extra), price)
+			sdb.AddBalance(msg.From, top, tracing.BalanceChangeUnspecified)
+		}
+	}
+	d, p := execution.NewEPRTracer(), execution.NewEPRProgTracer()
+	bctx := core.NewEVMBlockContext(hdr, chainCtx{}, &hdr.Coinbase)
+	evm := vm.NewEVM(bctx, sdb, cfg, vm.Config{Tracer: execution.EPRCombineHooks(d, p)})
+	gp := core.NewGasPool(hdr.GasLimit + extra)
+	res, err := core.ApplyMessage(evm, msg, gp)
+	if err != nil {
+		return blocks.ReadWriteSet{}, nil, nil, nil, err
+	}
+	var rws blocks.ReadWriteSet
+	ver := &blocks.Version{BlockNum: hdr.Number.Uint64() - 1}
+	for a, acc := range pre {
+		for k, v := range acc.Storage {
+			key := storeKey(a, k)
+			rws.Reads = append(rws.Reads, blocks.KVRead{Key: key, Version: ver})
+			if nv := sdb.GetState(a, k); nv != v {
+				rws.Writes = append(rws.Writes, blocks.KVWrite{Key: key, Value: nv.Bytes()})
+			}
+		}
+	}
+	return rws, d, p, res, nil
+}
+
+func main() {
+	var start, stride uint64
+	var runs, runLen int
+	var out string
+	flag.StringVar(&rpcURL, "rpc", "https://eth.drpc.org", "Ethereum JSON-RPC endpoint with debug_traceTransaction")
+	flag.Uint64Var(&start, "start", 24000000, "first block of the first run")
+	flag.IntVar(&runs, "runs", 20, "number of runs of consecutive blocks")
+	flag.IntVar(&runLen, "run-len", 10, "consecutive blocks per run (hotness across blocks)")
+	flag.Uint64Var(&stride, "stride", 50000, "blocks between run starts")
+	flag.StringVar(&out, "out", "coverage.jsonl", "output (appended; blocks already present are skipped)")
+	flag.StringVar(&cacheDir, "cache", "", "directory caching RPC results (reruns replay the same inputs offline)")
+	flag.Parse()
+	if cacheDir != "" {
+		if err := os.MkdirAll(cacheDir, 0o755); err != nil {
+			log.Fatal(err)
+		}
+	}
+	execution.EPREnabled, execution.EPRProgEnabled = true, true
+
+	done := map[uint64]bool{}
+	if f, err := os.Open(out); err == nil {
+		sc := bufio.NewScanner(f)
+		sc.Buffer(make([]byte, 1<<20), 1<<26)
+		for sc.Scan() {
+			var t txOut
+			if json.Unmarshal(sc.Bytes(), &t) == nil {
+				done[t.Block] = true
+			}
+		}
+		f.Close()
+	}
+	f, err := os.OpenFile(out, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)
+	if err != nil {
+		log.Fatal(err)
+	}
+	defer f.Close()
+	enc := json.NewEncoder(f)
+	for r := 0; r < runs; r++ {
+		for j := 0; j < runLen; j++ {
+			bn := start + uint64(r)*stride + uint64(j)
+			if done[bn] {
+				continue
+			}
+			var blk rpcBlock
+			if err := call("eth_getBlockByNumber", []any{hexutil.EncodeUint64(bn), true}, &blk); err != nil {
+				log.Printf("block %d: %v", bn, err)
+				continue
+			}
+			var rcpts []receipt
+			if err := call("eth_getBlockReceipts", []any{hexutil.EncodeUint64(bn)}, &rcpts); err != nil || len(rcpts) != len(blk.Txs) {
+				log.Printf("block %d receipts: %v", bn, err)
+				continue
+			}
+			hdr := &blk.Header
+			nOK := 0
+			for i, tx := range blk.Txs {
+				o := txOut{Block: bn, Index: i, Hash: tx.Hash().Hex(), GasLim: tx.Gas()}
+				if tx.To() != nil {
+					o.To = strings.ToLower(tx.To().Hex())
+				}
+				var pre map[common.Address]*account
+				if err := call("debug_traceTransaction", []any{tx.Hash().Hex(), map[string]any{"tracer": "prestateTracer"}}, &pre); err != nil {
+					o.Status = "error:prestate"
+					_ = enc.Encode(o)
+					continue
+				}
+				// each setting replays with fresh tracers: a rewrite consumes the tracers' state
+				rws, d, p, res, err := replay(hdr, tx, pre, 0)
+				if err != nil {
+					o.Status = "error:" + strings.SplitN(err.Error(), ":", 2)[0]
+					_ = enc.Encode(o)
+					continue
+				}
+				o.GasUsed = res.UsedGas
+				if res.Failed() != (rcpts[i].Status == 0) || res.UsedGas != uint64(rcpts[i].GasUsed) {
+					o.Status = "replay_mismatch"
+					_ = enc.Encode(o)
+					continue
+				}
+				o.Status = "ok"
+				// strict: real headroom (gas limit minus gas used before refunds)
+				headroom := tx.Gas() - res.MaxUsedGas
+				d.GasLeft = headroom
+				r0 := execution.EPRPlainReasons()
+				strict := execution.EPRRewriteTx(copyRWS(rws), d, p)
+				o.WhyStrict = reasonDiff(r0, execution.EPRPlainReasons())
+				// capable: ample headroom (a client of an EPR chain leaves room for commit-time evaluation)
+				rws2, d2, p2, _, err := replay(hdr, tx, pre, capableExtra)
+				if err != nil {
+					o.Status = "error:replay2"
+					_ = enc.Encode(o)
+					continue
+				}
+				d2.GasLeft = 1 << 40
+				r1 := execution.EPRPlainReasons()
+				capable := execution.EPRRewriteTx(rws2, d2, p2)
+				o.WhyCap = reasonDiff(r1, execution.EPRPlainReasons())
+				if l := p2.LostAt(); l != "" {
+					o.ProgLost = l
+				}
+				sv, cv := map[string]string{}, map[string]string{}
+				for _, w := range strict.Writes {
+					sv[w.Key] = classify(w.Value)
+				}
+				for _, w := range capable.Writes {
+					cv[w.Key] = classify(w.Value)
+				}
+				for _, w := range rws.Writes {
+					o.Writes = append(o.Writes, writeOut{Key: w.Key, Strict: sv[w.Key], Cap: cv[w.Key]})
+				}
+				_ = enc.Encode(o)
+				nOK++
+			}
+			log.Printf("block %d: %d txs, %d replayed ok", bn, len(blk.Txs), nOK)
+		}
+	}
+}
+
+func reasonDiff(a, b map[string]int64) map[string]int64 {
+	var out map[string]int64
+	for k, v := range b {
+		if d := v - a[k]; d > 0 {
+			if out == nil {
+				out = map[string]int64{}
+			}
+			out[k] = d
+		}
+	}
+	return out
+}
+
+func copyRWS(r blocks.ReadWriteSet) blocks.ReadWriteSet {
+	return blocks.ReadWriteSet{
+		Reads:  append([]blocks.KVRead(nil), r.Reads...),
+		Writes: append([]blocks.KVWrite(nil), r.Writes...),
+	}
+}
diff --git a/d16dex/main.go b/d16dex/main.go
new file mode 100644
index 0000000..402f96c
--- /dev/null
+++ b/d16dex/main.go
@@ -0,0 +1,273 @@
+// Command d16dex generates a DEX (Uniswap-V2-style) replay workload for fabric-x-evm's perf harness
+// (evaluation workload): a genesis state (tokens, pairs with liquidity, the D16Router, funded and approved users)
+// and signed swap transactions in the harness's dataset format.
+//
+// One base token B and P quote tokens Q_i form P pairs (B, Q_i). Each swap picks a pair by Zipf(theta)
+// (P = 1 is a single hot pair), a random direction and a random input amount; its slippage bound is the
+// quote obtained by replaying all swaps in order, minus slip_bps.
+//
+// usage: go run ./d16dex <router.json> <chain-id-source-dataset.json.gz> <out-genesis.json> <out-dataset.json.gz>
+//
+//	<users> <swaps> <pairs> <theta> <slip_bps> [seed]
+package main
+
+import (
+	"compress/gzip"
+	"crypto/ecdsa"
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"math/rand"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/ethereum/go-ethereum/accounts/abi"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+
+	"github.com/hyperledger/fabric-x-evm/integration/contracts"
+)
+
+type allocEntry struct {
+	Balance string            `json:"balance"`
+	Code    string            `json:"code"`
+	Nonce   string            `json:"nonce"`
+	Storage map[string]string `json:"storage"`
+}
+
+type record struct {
+	BlockID         int    `json:"BlockID"`
+	TransactionHash string `json:"TransactionHash"`
+	TokenAddress    string `json:"TokenAddress"`
+	Sender          string `json:"Sender"`
+	Recipient       string `json:"Recipient"`
+	Value           string `json:"Value"`
+	Transaction     []byte `json:"Transaction"`
+}
+
+func must(err error) {
+	if err != nil {
+		panic(err)
+	}
+}
+
+func main() {
+	if len(os.Args) < 10 {
+		fmt.Fprintln(os.Stderr, "usage: d16dex <router.json> <chainsrc.json.gz> <genesis.json> <dataset.json.gz> <users> <swaps> <pairs> <theta> <slip_bps> [seed]")
+		os.Exit(2)
+	}
+	nUsers, _ := strconv.Atoi(os.Args[5])
+	nSwaps, _ := strconv.Atoi(os.Args[6])
+	nPairs, _ := strconv.Atoi(os.Args[7])
+	theta, _ := strconv.ParseFloat(os.Args[8], 64)
+	slip, _ := strconv.Atoi(os.Args[9])
+	seed := int64(16)
+	if len(os.Args) > 10 {
+		seed, _ = strconv.ParseInt(os.Args[10], 10, 64)
+	}
+	rng := rand.New(rand.NewSource(seed))
+
+	// router artifact (solc-js output) and chain id from an existing harness dataset
+	var routerArt struct {
+		ABI json.RawMessage `json:"abi"`
+		Bin string          `json:"bin"`
+	}
+	raw, err := os.ReadFile(os.Args[1])
+	must(err)
+	must(json.Unmarshal(raw, &routerArt))
+	routerABI, err := abi.JSON(strings.NewReader(string(routerArt.ABI)))
+	must(err)
+	f, err := os.Open(os.Args[2])
+	must(err)
+	zr, err := gzip.NewReader(f)
+	must(err)
+	var src []record
+	must(json.NewDecoder(zr).Decode(&src))
+	first := new(types.Transaction)
+	must(first.UnmarshalBinary(src[0].Transaction))
+	chainID := first.ChainId()
+	signer := types.LatestSignerForChainID(chainID)
+
+	// in-memory deployment; every SSTORE is recorded so the genesis can carry the resulting storage
+	sdb, err := state.New(common.Hash{}, state.NewDatabaseForTesting())
+	must(err)
+	touched := map[common.Address]map[common.Hash]bool{}
+	hooks := &tracing.Hooks{OnOpcode: func(pc uint64, op byte, gas, cost uint64, scope tracing.OpContext, rData []byte, depth int, err error) {
+		if op != 0x55 {
+			return
+		}
+		st := scope.StackData()
+		a := scope.Address()
+		if touched[a] == nil {
+			touched[a] = map[common.Hash]bool{}
+		}
+		touched[a][common.Hash(st[len(st)-1].Bytes32())] = true
+	}}
+	ctx := vm.BlockContext{CanTransfer: core.CanTransfer, Transfer: core.Transfer, BlockNumber: big.NewInt(30_000_000),
+		Time: 1_800_000_000, GasLimit: 1 << 40, Difficulty: big.NewInt(0), BaseFee: big.NewInt(0), Random: &common.Hash{}}
+	evmFor := func(from common.Address) *vm.EVM {
+		e := vm.NewEVM(ctx, sdb, params.MainnetChainConfig, vm.Config{Tracer: hooks})
+		e.SetTxContext(vm.TxContext{Origin: from, GasPrice: new(uint256.Int)})
+		return e
+	}
+	owner := common.HexToAddress("0x00000000000000000000000000000000000d16d0")
+	ercABI, _ := abi.JSON(strings.NewReader(contracts.GenericERC20MetaData.ABI))
+	pairABI, _ := abi.JSON(strings.NewReader(contracts.UniswapV2PairMetaData.ABI))
+	deploy := func(bin string, a abi.ABI, args ...interface{}) common.Address {
+		in, err := a.Pack("", args...)
+		must(err)
+		_, addr, _, err := evmFor(owner).Create(owner, append(common.FromHex(bin), in...), vm.NewGasBudget(30_000_000), new(uint256.Int))
+		must(err)
+		if touched[addr] == nil { // contracts without storage writes (the router) still need their code
+			touched[addr] = map[common.Hash]bool{}
+		}
+		return addr
+	}
+	call := func(from, to common.Address, a abi.ABI, m string, args ...interface{}) []byte {
+		in, err := a.Pack(m, args...)
+		must(err)
+		ret, _, err := evmFor(from).Call(from, to, in, vm.NewGasBudget(30_000_000), new(uint256.Int))
+		if err != nil {
+			panic(fmt.Sprintf("%s: %v", m, err))
+		}
+		return ret
+	}
+	supply := new(big.Int).Exp(big.NewInt(10), big.NewInt(30), nil)
+	base := deploy(contracts.GenericERC20MetaData.Bin, ercABI, "D16 Base", "D16B", supply, uint8(6))
+	router := deploy(routerArt.Bin, routerABI)
+	liq := new(big.Int).Exp(big.NewInt(10), big.NewInt(15), nil) // 1e9 tokens of 6 decimals per side
+	type pairInfo struct {
+		addr, quote, t0 common.Address
+		r0, r1          *big.Int
+	}
+	pairs := make([]pairInfo, nPairs)
+	for i := range pairs {
+		q := deploy(contracts.GenericERC20MetaData.Bin, ercABI, fmt.Sprintf("D16 Quote %d", i), fmt.Sprintf("D16Q%d", i), supply, uint8(6))
+		t0, t1 := base, q
+		if strings.ToLower(t1.Hex()) < strings.ToLower(t0.Hex()) {
+			t0, t1 = t1, t0
+		}
+		p := deploy(contracts.UniswapV2PairMetaData.Bin, pairABI)
+		call(owner, p, pairABI, "initialize", t0, t1)
+		call(owner, t0, ercABI, "transfer", p, liq)
+		call(owner, t1, ercABI, "transfer", p, liq)
+		call(owner, p, pairABI, "mint", owner)
+		pairs[i] = pairInfo{addr: p, quote: q, t0: t0, r0: new(big.Int).Set(liq), r1: new(big.Int).Set(liq)}
+	}
+
+	// Zipf pair popularity
+	cdf := make([]float64, nPairs)
+	acc := 0.0
+	for i := range cdf {
+		acc += 1 / math.Pow(float64(i+1), theta)
+		cdf[i] = acc
+	}
+	pickPair := func() int {
+		u := rng.Float64() * acc
+		return sort.SearchFloat64s(cdf, u)
+	}
+
+	// users: deterministic keys; swaps generated and quoted against the in-order reserves
+	keys := make([]*ecdsaKey, nUsers)
+	for i := range keys {
+		k, err := crypto.ToECDSA(crypto.Keccak256([]byte(fmt.Sprintf("d16dex-user-%d", i))))
+		must(err)
+		keys[i] = &ecdsaKey{k: k, addr: crypto.PubkeyToAddress(k.PublicKey)}
+	}
+	type swap struct {
+		user, pair int
+		tokenIn    common.Address
+		in, minOut *big.Int
+	}
+	swaps := make([]swap, nSwaps)
+	spend := map[[2]common.Address]*big.Int{} // (user, token) -> total spent
+	for i := range swaps {
+		u, pi := rng.Intn(nUsers), pickPair()
+		p := &pairs[pi]
+		in := big.NewInt(1_000_000 + rng.Int63n(999_000_000)) // 1 .. 1000 tokens
+		tokenIn := base
+		if rng.Intn(2) == 0 {
+			tokenIn = p.quote
+		}
+		zeroIn := tokenIn == p.t0
+		rIn, rOut := p.r0, p.r1
+		if !zeroIn {
+			rIn, rOut = p.r1, p.r0
+		}
+		inFee := new(big.Int).Mul(in, big.NewInt(997))
+		out := new(big.Int).Div(new(big.Int).Mul(inFee, rOut), new(big.Int).Add(new(big.Int).Mul(rIn, big.NewInt(1000)), inFee))
+		rIn.Add(rIn, in)
+		rOut.Sub(rOut, out)
+		minOut := new(big.Int).Div(new(big.Int).Mul(out, big.NewInt(int64(10000-slip))), big.NewInt(10000))
+		swaps[i] = swap{user: u, pair: pi, tokenIn: tokenIn, in: in, minOut: minOut}
+		key := [2]common.Address{keys[u].addr, tokenIn}
+		if spend[key] == nil {
+			spend[key] = new(big.Int)
+		}
+		spend[key].Add(spend[key], in)
+	}
+	maxApprove := new(big.Int).Sub(new(big.Int).Lsh(big.NewInt(1), 255), big.NewInt(1))
+	for key, amt := range spend {
+		call(owner, key[1], ercABI, "transfer", key[0], new(big.Int).Mul(amt, big.NewInt(2)))
+		call(key[0], key[1], ercABI, "approve", router, maxApprove)
+	}
+
+	// genesis: code + touched storage of every contract
+	alloc := map[string]allocEntry{}
+	for a, slots := range touched {
+		e := allocEntry{Code: "0x" + common.Bytes2Hex(sdb.GetCode(a)), Storage: map[string]string{}}
+		for s := range slots {
+			v := sdb.GetState(a, s)
+			if v != (common.Hash{}) {
+				e.Storage[s.Hex()] = v.Hex()
+			}
+		}
+		alloc[a.Hex()] = e
+	}
+	g, err := json.Marshal(alloc)
+	must(err)
+	must(os.WriteFile(os.Args[3], g, 0o644))
+
+	// signed transactions in the harness dataset format
+	nonces := map[int]uint64{}
+	recs := make([]record, 0, nSwaps)
+	for i, s := range swaps {
+		data, err := routerABI.Pack("swapExactIn", pairs[s.pair].addr, s.tokenIn, s.in, s.minOut)
+		must(err)
+		tx := types.NewTx(&types.LegacyTx{Nonce: nonces[s.user], GasPrice: big.NewInt(0), Gas: 800_000, To: &router, Data: data})
+		nonces[s.user]++
+		stx, err := types.SignTx(tx, signer, keys[s.user].k)
+		must(err)
+		b, err := stx.MarshalBinary()
+		must(err)
+		recs = append(recs, record{BlockID: 20_000_000 + i/100, TransactionHash: stx.Hash().Hex(),
+			TokenAddress: s.tokenIn.Hex(), Sender: keys[s.user].addr.Hex(), Recipient: router.Hex(), Value: s.in.String(), Transaction: b})
+	}
+	out, err := os.Create(os.Args[4])
+	must(err)
+	zw := gzip.NewWriter(out)
+	must(json.NewEncoder(zw).Encode(recs))
+	must(zw.Close())
+	must(out.Close())
+	storageN := 0
+	for _, e := range alloc {
+		storageN += len(e.Storage)
+	}
+	fmt.Printf("chain=%s router=%s base=%s pairs=%d users=%d swaps=%d theta=%.2f slip=%dbps contracts=%d storage=%d\n",
+		chainID, router.Hex(), base.Hex(), nPairs, nUsers, nSwaps, theta, slip, len(alloc), storageN)
+}
+
+type ecdsaKey struct {
+	k    *ecdsa.PrivateKey
+	addr common.Address
+}
diff --git a/d16oracle/main.go b/d16oracle/main.go
new file mode 100644
index 0000000..ce948a6
--- /dev/null
+++ b/d16oracle/main.go
@@ -0,0 +1,180 @@
+// Command d16oracle checks serial equivalence end to end (Theorem 1): it replays the transactions that
+// the ledger marks valid, serially in ledger order, on the genesis state in an in-memory EVM, and compares
+// every contract storage slot with the committer's database. Every valid transaction must also succeed
+// in the replay (no revert).
+//
+// usage: d16oracle <genesis.json> <order.log> <db_dump.tsv> [chain-id]
+//
+//	order.log: "block txnum valid rawhex" per EVM transaction (FX_ORDER_LOG of the perf harness)
+//	db_dump.tsv: "key<TAB>valuehex" for the storage keys of namespace basic (psql export)
+package main
+
+import (
+	"bufio"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/holiman/uint256"
+
+	fxcommon "github.com/hyperledger/fabric-x-evm/common"
+)
+
+type allocEntry struct {
+	Code    string            `json:"code"`
+	Storage map[string]string `json:"storage"`
+}
+
+type entry struct {
+	block, num uint64
+	raw        []byte
+}
+
+func must(err error) {
+	if err != nil {
+		panic(err)
+	}
+}
+
+func main() {
+	if len(os.Args) < 4 {
+		fmt.Fprintln(os.Stderr, "usage: d16oracle <genesis.json> <order.log> <db_dump.tsv> [chain-id]")
+		os.Exit(2)
+	}
+	chain := int64(4011)
+	if len(os.Args) > 4 {
+		chain, _ = strconv.ParseInt(os.Args[4], 10, 64)
+	}
+	cfg := fxcommon.BuildChainConfig(chain)
+	sdb, err := state.New(common.Hash{}, state.NewDatabaseForTesting())
+	must(err)
+	raw, err := os.ReadFile(os.Args[1])
+	must(err)
+	var alloc map[string]allocEntry
+	must(json.Unmarshal(raw, &alloc))
+	for a, e := range alloc {
+		addr := common.HexToAddress(a)
+		sdb.SetCode(addr, common.FromHex(e.Code), 0)
+		for k, v := range e.Storage {
+			sdb.SetState(addr, common.HexToHash(k), common.HexToHash(v))
+		}
+	}
+
+	f, err := os.Open(os.Args[2])
+	must(err)
+	var txs []entry
+	seen := map[[2]uint64]bool{}
+	sc := bufio.NewScanner(f)
+	sc.Buffer(make([]byte, 1<<20), 1<<24)
+	invalid := 0
+	for sc.Scan() {
+		p := strings.Fields(sc.Text())
+		if len(p) != 4 {
+			continue
+		}
+		b, _ := strconv.ParseUint(p[0], 10, 64)
+		n, _ := strconv.ParseUint(p[1], 10, 64)
+		if p[2] != "1" {
+			invalid++
+			continue
+		}
+		if seen[[2]uint64{b, n}] {
+			continue // the harness may see a block more than once
+		}
+		seen[[2]uint64{b, n}] = true
+		r, err := hex.DecodeString(p[3])
+		must(err)
+		txs = append(txs, entry{b, n, r})
+	}
+	sort.Slice(txs, func(i, j int) bool {
+		if txs[i].block != txs[j].block {
+			return txs[i].block < txs[j].block
+		}
+		return txs[i].num < txs[j].num
+	})
+
+	ctx := vm.BlockContext{CanTransfer: core.CanTransfer, Transfer: core.Transfer, BlockNumber: big.NewInt(1),
+		Time: 1_800_000_000, GasLimit: 1 << 40, Difficulty: big.NewInt(0), BaseFee: big.NewInt(0), Random: &common.Hash{},
+		GetHash: func(uint64) common.Hash { return common.Hash{} }}
+	signer := types.LatestSignerForChainID(big.NewInt(chain))
+	reverted := 0
+	touched := map[common.Address]map[common.Hash]bool{}
+	for _, e := range txs {
+		tx := new(types.Transaction)
+		must(tx.UnmarshalBinary(e.raw))
+		if tx.To() == nil {
+			continue // the harness's state-priming transaction; the genesis is loaded directly
+		}
+		from, err := types.Sender(signer, tx)
+		must(err)
+		evm := vm.NewEVM(ctx, sdb, cfg, vm.Config{})
+		evm.SetTxContext(vm.TxContext{Origin: from, GasPrice: new(uint256.Int)})
+		_, _, err = evm.Call(from, *tx.To(), tx.Data(), vm.NewGasBudget(tx.Gas()), uint256.MustFromBig(tx.Value()))
+		if err != nil {
+			reverted++
+		}
+		if touched[*tx.To()] == nil {
+			touched[*tx.To()] = map[common.Hash]bool{}
+		}
+	}
+
+	// compare every storage slot in the database with the replayed state
+	d, err := os.Open(os.Args[3])
+	must(err)
+	sc = bufio.NewScanner(d)
+	sc.Buffer(make([]byte, 1<<20), 1<<24)
+	compared, mismatched, skipped := 0, 0, 0
+	var examples []string
+	// D16_ORACLE_SKIP: comma-separated small slot indices to ignore (Uniswap V2 pairs store block.timestamp
+	// in slots 8-10, which depends on the endorsement time and cannot be reproduced by a replay)
+	skip := map[common.Hash]bool{}
+	for _, s := range strings.Split(os.Getenv("D16_ORACLE_SKIP"), ",") {
+		if n, err := strconv.ParseUint(strings.TrimSpace(s), 10, 64); err == nil {
+			skip[common.BigToHash(new(big.Int).SetUint64(n))] = true
+		}
+	}
+	for sc.Scan() {
+		p := strings.SplitN(sc.Text(), "\t", 2)
+		if len(p) != 2 || !strings.HasPrefix(p[0], "str:") {
+			continue
+		}
+		parts := strings.Split(p[0], ":") // str:<addr>:<slot>
+		if len(parts) != 3 {
+			continue
+		}
+		addr, slot := common.HexToAddress(parts[1]), common.HexToHash(parts[2])
+		if skip[slot] {
+			skipped++
+			continue
+		}
+		val, err := hex.DecodeString(p[1])
+		must(err)
+		dbv := new(big.Int).SetBytes(val)
+		ev := sdb.GetState(addr, slot).Big()
+		compared++
+		if dbv.Cmp(ev) != 0 {
+			mismatched++
+			if len(examples) < 5 {
+				examples = append(examples, fmt.Sprintf("%s db=%s replay=%s", p[0], dbv, ev))
+			}
+		}
+	}
+	fmt.Printf("D16ORACLE valid_txs=%d invalid_txs=%d replay_reverted=%d slots_compared=%d mismatched=%d skipped=%d\n",
+		len(txs), invalid, reverted, compared, mismatched, skipped)
+	for _, x := range examples {
+		fmt.Println("  mismatch:", x)
+	}
+	if mismatched > 0 || reverted > 0 {
+		os.Exit(1)
+	}
+}
diff --git a/d16prefund/main.go b/d16prefund/main.go
new file mode 100644
index 0000000..4febcdb
--- /dev/null
+++ b/d16prefund/main.go
@@ -0,0 +1,103 @@
+// Command d16prefund writes a state-priming JSON in which every sender of a replay dataset holds a real
+// USDC balance at genesis. Read-time balance priming fakes reads of zero balances, which
+// hides the true base value from both MVCC and guarded deltas; funding senders in the genesis state
+// gives baseline and EPR the same, real starting state instead.
+//
+// usage: go run ./d16prefund <contract.json> <dataset.json.gz> <out.json> <balance-decimal>
+package main
+
+import (
+	"compress/gzip"
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"os"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+)
+
+const usdcBalanceSlot = 9 // FiatTokenV2_2 balanceAndBlacklistStates mapping position
+
+func main() {
+	if len(os.Args) != 5 {
+		fmt.Fprintln(os.Stderr, "usage: d16prefund <contract.json> <dataset.json.gz> <out.json> <balance>")
+		os.Exit(2)
+	}
+	var state map[string]map[string]any
+	raw, err := os.ReadFile(os.Args[1])
+	must(err)
+	must(json.Unmarshal(raw, &state))
+
+	f, err := os.Open(os.Args[2])
+	must(err)
+	zr, err := gzip.NewReader(f)
+	must(err)
+	var transfers []struct {
+		Transaction []byte `json:"Transaction"`
+		Value       string `json:"Value"`
+	}
+	must(json.NewDecoder(zr).Decode(&transfers))
+
+	bal, ok := new(big.Int).SetString(os.Args[4], 10)
+	if !ok || bal.Sign() <= 0 || bal.BitLen() > 255 {
+		panic("bad balance")
+	}
+	// Each sender holds the base balance plus everything it ever sends, so no transfer can fail for lack
+	// of funds in any order (the replay lacks the pre-dataset history).
+	senders := map[common.Address]*big.Int{}
+	for i, tr := range transfers {
+		tx := new(types.Transaction)
+		must(tx.UnmarshalBinary(tr.Transaction))
+		from, err := types.Sender(types.LatestSignerForChainID(tx.ChainId()), tx)
+		if err != nil {
+			panic(fmt.Sprintf("transfer %d: %v", i, err))
+		}
+		v, ok := new(big.Int).SetString(tr.Value, 10)
+		if !ok {
+			panic(fmt.Sprintf("transfer %d: bad value %q", i, tr.Value))
+		}
+		if senders[from] == nil {
+			senders[from] = new(big.Int).Set(bal)
+		}
+		senders[from].Add(senders[from], v)
+	}
+
+	var usdcKey string
+	for k := range state {
+		if common.HexToAddress(k) == common.HexToAddress("0xA0b86991c6218b36c1d19d4a2e9eb0ce3606eb48") {
+			usdcKey = k
+		}
+	}
+	if usdcKey == "" {
+		panic("USDC proxy not found in contract json")
+	}
+	storage, _ := state[usdcKey]["storage"].(map[string]any)
+	if storage == nil {
+		storage = map[string]any{}
+	}
+	slot := common.BigToHash(big.NewInt(usdcBalanceSlot))
+	maxBal := new(big.Int)
+	for a, b := range senders {
+		if b.Cmp(new(big.Int).SetUint64(1<<63-1)) > 0 {
+			panic(fmt.Sprintf("sender %s balance %s exceeds int64", a, b))
+		}
+		if b.Cmp(maxBal) > 0 {
+			maxBal.Set(b)
+		}
+		k := crypto.Keccak256Hash(common.LeftPadBytes(a.Bytes(), 32), slot.Bytes())
+		storage[k.Hex()] = common.BigToHash(b).Hex()
+	}
+	state[usdcKey]["storage"] = storage
+	out, err := json.MarshalIndent(state, "", "  ")
+	must(err)
+	must(os.WriteFile(os.Args[3], out, 0o644))
+	fmt.Printf("prefunded %d senders with %s (storage entries %d)\n", len(senders), bal, len(storage))
+}
+
+func must(err error) {
+	if err != nil {
+		panic(err)
+	}
+}
diff --git a/d16reexec_v2/main.go b/d16reexec_v2/main.go
new file mode 100644
index 0000000..b4fa653
--- /dev/null
+++ b/d16reexec_v2/main.go
@@ -0,0 +1,359 @@
+// Command d16reexec is the post-order re-execution service of the re-execution baselines
+// (XOX / HTFabric / ReX style). It runs next to the validator-committer, inside the committer container,
+// and re-executes conflicting transactions with fabric-x-evm's executor against the latest committed state
+// in the committer's database: the VC sends the raw transactions of a batch in ledger order, the service
+// runs them on the state left by their predecessors (sequentially, or in TSP partitions with -parallel),
+// and returns the final value of every storage slot they wrote. As in a re-executing committer,
+// re-execution runs on the commit path.
+//
+// usage: d16reexec -listen 127.0.0.1:7071 -db postgres://postgres:postgres@localhost:5433/postgres -chain 4011
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"hash/fnv"
+	"log"
+	"math/big"
+	"net/http"
+	"runtime"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/ethereum/go-ethereum"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/hyperledger/fabric-x-sdk/blocks"
+	"github.com/yugabyte/pgx/v5"
+	"github.com/yugabyte/pgx/v5/pgxpool"
+
+	fxcommon "github.com/hyperledger/fabric-x-evm/common"
+	"github.com/hyperledger/fabric-x-evm/endorser/execution"
+)
+
+// store reads the latest committed state from the committer database, overlaid with the writes of the
+// transactions already re-executed in the current request.
+type store struct {
+	ctx      context.Context
+	pool     *pgxpool.Pool
+	table    string
+	overlay  map[string][]byte
+	prefetch map[string][]byte // endorsed read keys fetched in one query per request (optimized mode)
+}
+
+// codeCache holds contract code, which never changes once deployed (optimized mode).
+var codeCache sync.Map
+
+func (s *store) Get(_ string, key string) (*blocks.WriteRecord, error) {
+	if v, ok := s.overlay[key]; ok {
+		return &blocks.WriteRecord{Key: key, Value: v, Version: 1}, nil
+	}
+	if v, ok := s.prefetch[key]; ok {
+		if v == nil {
+			return nil, nil
+		}
+		return &blocks.WriteRecord{Key: key, Value: v, Version: 1}, nil
+	}
+	isCode := *optimized && strings.HasSuffix(key, ":code")
+	if isCode {
+		if v, ok := codeCache.Load(key); ok {
+			return &blocks.WriteRecord{Key: key, Value: v.([]byte), Version: 1}, nil
+		}
+	}
+	var val []byte
+	var ver int64
+	err := s.pool.QueryRow(s.ctx, "SELECT value, version FROM "+s.table+" WHERE key = $1", []byte(key)).Scan(&val, &ver)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	if isCode {
+		codeCache.Store(key, val)
+	}
+	return &blocks.WriteRecord{Key: key, Value: val, Version: uint64(ver)}, nil //nolint:gosec
+}
+
+// prefetchKeys loads the given keys in one query (absent keys are recorded as nil).
+func (s *store) prefetchKeys(keys []string) error {
+	s.prefetch = make(map[string][]byte, len(keys))
+	bk := make([][]byte, len(keys))
+	for i, k := range keys {
+		bk[i] = []byte(k)
+		s.prefetch[k] = nil
+	}
+	rows, err := s.pool.Query(s.ctx, "SELECT key, value FROM "+s.table+" WHERE key = ANY($1)", bk)
+	if err != nil {
+		return err
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var k, v []byte
+		if err := rows.Scan(&k, &v); err != nil {
+			return err
+		}
+		s.prefetch[string(k)] = v
+	}
+	return rows.Err()
+}
+
+var optimized = flag.Bool("optimized", true, "cache contract code and prefetch the endorsed read keys")
+
+func (s *store) Close() error { return nil }
+
+// parallel selects HTFabric's re-execution (Song et al., CIKM'24): the transactions are split into partitions
+// by TSP (hashing each on its key of lowest degree in the batch, so that the hottest keys are the ones cut),
+// and in every round one transaction per partition is re-executed in parallel on the state left by the
+// previous rounds; the round's results are then applied in partition order, and a transaction whose read set
+// was written by one applied before it in the same round is re-executed again, sequentially (its Algorithm 3).
+var parallel = flag.Int("parallel", 0, "HTFabric mode: number of TSP partitions (0: sequential, XOX-style; -1: number of CPUs)")
+
+type request struct {
+	Txs    [][]byte   `json:"txs"`     // carrier values: 20-byte sender | raw signed transaction
+	Keys   []string   `json:"keys"`    // endorsed read keys of the transactions (prefetched in optimized mode)
+	TxKeys [][]string `json:"tx_keys"` // per transaction: its endorsed read keys (TSP partitioning)
+}
+
+// execResult is the outcome of executing one transaction on the store's current state.
+type execResult struct {
+	ok     bool
+	reads  map[string]bool
+	writes map[string][]byte // storage slots written
+}
+
+func execOne(ctx context.Context, st *store, ns string, cfg execution.EVMConfig, c []byte) (execResult, error) {
+	res := execResult{reads: map[string]bool{}, writes: map[string][]byte{}}
+	if len(c) < 21 {
+		return res, errors.New("short carrier")
+	}
+	from := common.BytesToAddress(c[:20])
+	tx := new(types.Transaction)
+	if err := tx.UnmarshalBinary(c[20:]); err != nil {
+		return res, err
+	}
+	sdb, err := execution.NewStateDB(ctx, st, ns, true)
+	if err != nil {
+		return res, err
+	}
+	ex, err := execution.NewExecutor(sdb, st, big.NewInt(1), uint64(time.Now().Unix()), cfg) //nolint:gosec
+	if err != nil {
+		return res, err
+	}
+	if _, _, err := ex.Call(ethereum.CallMsg{From: from, To: tx.To(), Gas: tx.Gas(), Value: tx.Value(), Data: tx.Data()}); err != nil {
+		return res, nil // the transaction aborts, as it would in serial execution
+	}
+	res.ok = true
+	rws := sdb.Result()
+	for _, rd := range rws.Reads {
+		res.reads[rd.Key] = true
+	}
+	for _, wr := range rws.Writes {
+		if strings.HasPrefix(wr.Key, "str:") {
+			res.writes[wr.Key] = wr.Value
+		}
+	}
+	return res, nil
+}
+
+// tspPartitions assigns every transaction to one of np partitions (HTFabric's TSP).
+func tspPartitions(txKeys [][]string, n, np int) [][]int {
+	deg := map[string]int{}
+	for _, ks := range txKeys {
+		for _, k := range ks {
+			deg[k]++
+		}
+	}
+	parts := make([][]int, np)
+	for i := 0; i < n; i++ {
+		p := i % np
+		if i < len(txKeys) && len(txKeys[i]) > 0 {
+			best := ""
+			for _, k := range txKeys[i] {
+				if best == "" || deg[k] < deg[best] || (deg[k] == deg[best] && k < best) {
+					best = k
+				}
+			}
+			h := fnv.New32a()
+			_, _ = h.Write([]byte(best))
+			p = int(h.Sum32() % uint32(np)) //nolint:gosec
+		}
+		parts[p] = append(parts[p], i)
+	}
+	return parts
+}
+
+type response struct {
+	Final    map[string][]byte `json:"final"`
+	OK       []bool            `json:"ok"` // per transaction (request order): re-execution succeeded
+	// per transaction (request order): its storage writes, so that a committer can commit the re-executed
+	// outcome of transactions it cannot repair (XOX and HTFabric re-execute every invalid transaction)
+	TxWrites []map[string][]byte `json:"tx_writes"`
+	Reverted int               `json:"reverted"`
+	Micros   int64             `json:"micros"`
+}
+
+var nTx, nReq, nRev, nMicros, nConflictReexec atomic.Int64
+
+func main() {
+	listen := flag.String("listen", "127.0.0.1:7071", "listen address")
+	dsn := flag.String("db", "postgres://postgres:postgres@localhost:5433/postgres", "committer database")
+	ns := flag.String("ns", "basic", "namespace")
+	chain := flag.Int64("chain", 4011, "chain id")
+	flag.Parse()
+	pool, err := pgxpool.New(context.Background(), *dsn)
+	if err != nil {
+		log.Fatal(err)
+	}
+	cfg := execution.EVMConfig{ChainConfig: fxcommon.BuildChainConfig(*chain)}
+	table := "ns_" + *ns
+	go func() {
+		for range time.Tick(10 * time.Second) {
+			if n := nTx.Load(); n > 0 {
+				log.Printf("D16REEXEC requests=%d txs=%d reverted=%d conflict_reexec=%d avg_us_per_tx=%.1f", nReq.Load(), n, nRev.Load(), nConflictReexec.Load(), float64(nMicros.Load())/float64(n))
+			}
+		}
+	}()
+	http.HandleFunc("/reexec", func(w http.ResponseWriter, r *http.Request) {
+		var req request
+		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		start := time.Now()
+		st := &store{ctx: r.Context(), pool: pool, table: table, overlay: map[string][]byte{}}
+		if *optimized && len(req.Keys) > 0 {
+			if err := st.prefetchKeys(req.Keys); err != nil {
+				http.Error(w, err.Error(), http.StatusInternalServerError)
+				return
+			}
+		}
+		resp := response{Final: map[string][]byte{}}
+		if np := *parallel; np != 0 {
+			if np < 0 {
+				np = runtime.NumCPU()
+			}
+			resp.OK = make([]bool, len(req.Txs))
+			resp.TxWrites = make([]map[string][]byte, len(req.Txs))
+			parts := tspPartitions(req.TxKeys, len(req.Txs), np)
+			apply := func(r execResult) {
+				for k, v := range r.writes {
+					st.overlay[k] = v
+					resp.Final[k] = v
+				}
+			}
+			for round := 0; ; round++ {
+				var batch []int
+				for _, p := range parts {
+					if round < len(p) {
+						batch = append(batch, p[round])
+					}
+				}
+				if len(batch) == 0 {
+					break
+				}
+				results := make([]execResult, len(batch))
+				errs := make([]error, len(batch))
+				var wg sync.WaitGroup
+				for j, i := range batch { // the overlay is only read during the round
+					wg.Add(1)
+					go func(j, i int) {
+						defer wg.Done()
+						results[j], errs[j] = execOne(r.Context(), st, *ns, cfg, req.Txs[i])
+					}(j, i)
+				}
+				wg.Wait()
+				written := map[string]bool{}
+				for j, i := range batch { // apply in partition order
+					if errs[j] != nil {
+						http.Error(w, errs[j].Error(), http.StatusInternalServerError)
+						return
+					}
+					res := results[j]
+					conflict := false
+					for k := range res.reads {
+						if written[k] {
+							conflict = true
+							break
+						}
+					}
+					if conflict { // read a slot an earlier transaction of the round wrote: re-execute sequentially
+						var err error
+						if res, err = execOne(r.Context(), st, *ns, cfg, req.Txs[i]); err != nil {
+							http.Error(w, err.Error(), http.StatusInternalServerError)
+							return
+						}
+						nConflictReexec.Add(1)
+					}
+					resp.OK[i] = res.ok
+					if !res.ok {
+						resp.Reverted++
+						continue
+					}
+					resp.TxWrites[i] = res.writes
+					apply(res)
+					for k := range res.writes {
+						written[k] = true
+					}
+				}
+			}
+			resp.Micros = time.Since(start).Microseconds()
+			nReq.Add(1)
+			nTx.Add(int64(len(req.Txs)))
+			nRev.Add(int64(resp.Reverted))
+			nMicros.Add(resp.Micros)
+			_ = json.NewEncoder(w).Encode(resp)
+			return
+		}
+		for _, c := range req.Txs {
+			if len(c) < 21 {
+				http.Error(w, "short carrier", http.StatusBadRequest)
+				return
+			}
+			from := common.BytesToAddress(c[:20])
+			tx := new(types.Transaction)
+			if err := tx.UnmarshalBinary(c[20:]); err != nil {
+				http.Error(w, err.Error(), http.StatusBadRequest)
+				return
+			}
+			sdb, err := execution.NewStateDB(r.Context(), st, *ns, true)
+			if err != nil {
+				http.Error(w, err.Error(), http.StatusInternalServerError)
+				return
+			}
+			ex, err := execution.NewExecutor(sdb, st, big.NewInt(1), uint64(time.Now().Unix()), cfg) //nolint:gosec
+			if err != nil {
+				http.Error(w, err.Error(), http.StatusInternalServerError)
+				return
+			}
+			if _, _, err := ex.Call(ethereum.CallMsg{From: from, To: tx.To(), Gas: tx.Gas(), Value: tx.Value(), Data: tx.Data()}); err != nil {
+				resp.Reverted++ // the transaction aborts, as it would in serial execution
+				resp.OK = append(resp.OK, false)
+				resp.TxWrites = append(resp.TxWrites, nil)
+				continue
+			}
+			resp.OK = append(resp.OK, true)
+			txw := map[string][]byte{}
+			for _, wr := range sdb.Result().Writes {
+				if strings.HasPrefix(wr.Key, "str:") {
+					st.overlay[wr.Key] = wr.Value
+					resp.Final[wr.Key] = wr.Value
+					txw[wr.Key] = wr.Value
+				}
+			}
+			resp.TxWrites = append(resp.TxWrites, txw)
+		}
+		resp.Micros = time.Since(start).Microseconds()
+		nReq.Add(1)
+		nTx.Add(int64(len(req.Txs)))
+		nRev.Add(int64(resp.Reverted))
+		nMicros.Add(resp.Micros)
+		_ = json.NewEncoder(w).Encode(resp)
+	})
+	log.Printf("d16reexec listening on %s (table %s)", *listen, table)
+	log.Fatal(http.ListenAndServe(*listen, nil))
+}
diff --git a/d16smallbank/main.go b/d16smallbank/main.go
new file mode 100644
index 0000000..5a3d950
--- /dev/null
+++ b/d16smallbank/main.go
@@ -0,0 +1,226 @@
+// Command d16smallbank generates a SmallBank workload for fabric-x-evm's perf harness (evaluation workload):
+// a genesis state (the SmallBank contract with every account funded) and signed transactions in the
+// harness's dataset format.
+//
+// Mix (H-Store SmallBank defaults): Amalgamate 15%, Balance 15%, DepositChecking 15%, SendPayment 25%,
+// TransactSavings 15%, WriteCheck 15%. Accounts are drawn from Zipf(theta) over <accounts> customers
+// (theta = 0 is uniform); two-account transactions draw two distinct accounts, except that Amalgamate's
+// source account (which it empties) is uniform.
+//
+// usage: go run ./d16smallbank <smallbank.json> <chain-id-source-dataset.json.gz> <out-genesis.json>
+//
+//	<out-dataset.json.gz> <accounts> <txs> <theta> <users> [seed]
+package main
+
+import (
+	"compress/gzip"
+	"crypto/ecdsa"
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"math/rand"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/ethereum/go-ethereum/accounts/abi"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+)
+
+type allocEntry struct {
+	Balance string            `json:"balance"`
+	Code    string            `json:"code"`
+	Nonce   string            `json:"nonce"`
+	Storage map[string]string `json:"storage"`
+}
+
+type record struct {
+	BlockID         int    `json:"BlockID"`
+	TransactionHash string `json:"TransactionHash"`
+	TokenAddress    string `json:"TokenAddress"`
+	Sender          string `json:"Sender"`
+	Recipient       string `json:"Recipient"`
+	Value           string `json:"Value"`
+	Transaction     []byte `json:"Transaction"`
+}
+
+func must(err error) {
+	if err != nil {
+		panic(err)
+	}
+}
+
+func main() {
+	if len(os.Args) < 9 {
+		fmt.Fprintln(os.Stderr, "usage: d16smallbank <smallbank.json> <chainsrc.json.gz> <genesis.json> <dataset.json.gz> <accounts> <txs> <theta> <users> [seed]")
+		os.Exit(2)
+	}
+	nAcc, _ := strconv.Atoi(os.Args[5])
+	nTx, _ := strconv.Atoi(os.Args[6])
+	theta, _ := strconv.ParseFloat(os.Args[7], 64)
+	nUsers, _ := strconv.Atoi(os.Args[8])
+	seed := int64(16)
+	if len(os.Args) > 9 {
+		seed, _ = strconv.ParseInt(os.Args[9], 10, 64)
+	}
+	rng := rand.New(rand.NewSource(seed))
+
+	var art struct {
+		ABI json.RawMessage `json:"abi"`
+		Bin string          `json:"bin"`
+	}
+	raw, err := os.ReadFile(os.Args[1])
+	must(err)
+	must(json.Unmarshal(raw, &art))
+	sbABI, err := abi.JSON(strings.NewReader(string(art.ABI)))
+	must(err)
+	f, err := os.Open(os.Args[2])
+	must(err)
+	zr, err := gzip.NewReader(f)
+	must(err)
+	var src []record
+	must(json.NewDecoder(zr).Decode(&src))
+	first := new(types.Transaction)
+	must(first.UnmarshalBinary(src[0].Transaction))
+	chainID := first.ChainId()
+	signer := types.LatestSignerForChainID(chainID)
+
+	// in-memory deployment; every SSTORE is recorded so the genesis can carry the resulting storage
+	sdb, err := state.New(common.Hash{}, state.NewDatabaseForTesting())
+	must(err)
+	touched := map[common.Hash]bool{}
+	hooks := &tracing.Hooks{OnOpcode: func(pc uint64, op byte, gas, cost uint64, scope tracing.OpContext, rData []byte, depth int, err error) {
+		if op == 0x55 {
+			st := scope.StackData()
+			touched[common.Hash(st[len(st)-1].Bytes32())] = true
+		}
+	}}
+	ctx := vm.BlockContext{CanTransfer: core.CanTransfer, Transfer: core.Transfer, BlockNumber: big.NewInt(30_000_000),
+		Time: 1_800_000_000, GasLimit: 1 << 40, Difficulty: big.NewInt(0), BaseFee: big.NewInt(0), Random: &common.Hash{}}
+	evmFor := func(from common.Address) *vm.EVM {
+		e := vm.NewEVM(ctx, sdb, params.MainnetChainConfig, vm.Config{Tracer: hooks})
+		e.SetTxContext(vm.TxContext{Origin: from, GasPrice: new(uint256.Int)})
+		return e
+	}
+	owner := common.HexToAddress("0x00000000000000000000000000000000000d16d0")
+	_, bank, _, err := evmFor(owner).Create(owner, common.FromHex(art.Bin), vm.NewGasBudget(30_000_000), new(uint256.Int))
+	must(err)
+	initBal := new(big.Int).Exp(big.NewInt(10), big.NewInt(12), nil)
+	for from := 0; from < nAcc; from += 500 {
+		n := 500
+		if from+n > nAcc {
+			n = nAcc - from
+		}
+		in, err := sbABI.Pack("init", big.NewInt(int64(from)), big.NewInt(int64(n)), initBal, initBal)
+		must(err)
+		_, _, err = evmFor(owner).Call(owner, bank, in, vm.NewGasBudget(1<<34), new(uint256.Int))
+		must(err)
+	}
+
+	// Zipf account popularity (rank = account id)
+	cdf := make([]float64, nAcc)
+	acc := 0.0
+	for i := range cdf {
+		acc += 1 / math.Pow(float64(i+1), theta)
+		cdf[i] = acc
+	}
+	pick := func() int64 { return int64(sort.SearchFloat64s(cdf, rng.Float64()*acc)) }
+	pick2 := func() (int64, int64) {
+		a := pick()
+		for {
+			if b := pick(); b != a {
+				return a, b
+			}
+		}
+	}
+
+	keys := make([]*ecdsaKey, nUsers)
+	for i := range keys {
+		k, err := crypto.ToECDSA(crypto.Keccak256([]byte(fmt.Sprintf("d16smallbank-user-%d", i))))
+		must(err)
+		keys[i] = &ecdsaKey{k: k, addr: crypto.PubkeyToAddress(k.PublicKey)}
+	}
+	nonces := map[int]uint64{}
+	recs := make([]record, 0, nTx)
+	mix := map[string]int{}
+	for i := 0; i < nTx; i++ {
+		amt := big.NewInt(1 + rng.Int63n(1000))
+		var data []byte
+		var op string
+		switch r := rng.Intn(100); {
+		case r < 15:
+			// Amalgamate empties its source account. A Zipf-drawn source would drain the hot accounts, after
+			// which every debit on them fails in any serial order; the source is therefore uniform and the
+			// destination Zipf, which keeps the contention on the hot accounts.
+			a, b := int64(rng.Intn(nAcc)), pick()
+			for a == b {
+				a = int64(rng.Intn(nAcc))
+			}
+			op, data = "amalgamate", pack(sbABI, "amalgamate", big.NewInt(a), big.NewInt(b))
+		case r < 30:
+			op, data = "balance", pack(sbABI, "balance", big.NewInt(pick()))
+		case r < 45:
+			op, data = "depositChecking", pack(sbABI, "depositChecking", big.NewInt(pick()), amt)
+		case r < 70:
+			a, b := pick2()
+			op, data = "sendPayment", pack(sbABI, "sendPayment", big.NewInt(a), big.NewInt(b), amt)
+		case r < 85:
+			v := new(big.Int).Set(amt)
+			if rng.Intn(2) == 0 {
+				v.Neg(v)
+			}
+			op, data = "transactSavings", pack(sbABI, "transactSavings", big.NewInt(pick()), v)
+		default:
+			op, data = "writeCheck", pack(sbABI, "writeCheck", big.NewInt(pick()), amt)
+		}
+		mix[op]++
+		u := rng.Intn(nUsers)
+		tx := types.NewTx(&types.LegacyTx{Nonce: nonces[u], GasPrice: big.NewInt(0), Gas: 300_000, To: &bank, Data: data})
+		nonces[u]++
+		stx, err := types.SignTx(tx, signer, keys[u].k)
+		must(err)
+		b, err := stx.MarshalBinary()
+		must(err)
+		recs = append(recs, record{BlockID: 20_000_000 + i/100, TransactionHash: stx.Hash().Hex(),
+			TokenAddress: bank.Hex(), Sender: keys[u].addr.Hex(), Recipient: bank.Hex(), Value: "0", Transaction: b})
+	}
+
+	e := allocEntry{Code: "0x" + common.Bytes2Hex(sdb.GetCode(bank)), Storage: map[string]string{}}
+	for s := range touched {
+		if v := sdb.GetState(bank, s); v != (common.Hash{}) {
+			e.Storage[s.Hex()] = v.Hex()
+		}
+	}
+	g, err := json.Marshal(map[string]allocEntry{bank.Hex(): e})
+	must(err)
+	must(os.WriteFile(os.Args[3], g, 0o644))
+	out, err := os.Create(os.Args[4])
+	must(err)
+	zw := gzip.NewWriter(out)
+	must(json.NewEncoder(zw).Encode(recs))
+	must(zw.Close())
+	must(out.Close())
+	fmt.Printf("chain=%s bank=%s accounts=%d txs=%d theta=%.2f users=%d storage=%d mix=%v\n",
+		chainID, bank.Hex(), nAcc, nTx, theta, nUsers, len(e.Storage), mix)
+}
+
+func pack(a abi.ABI, m string, args ...interface{}) []byte {
+	in, err := a.Pack(m, args...)
+	must(err)
+	return in
+}
+
+type ecdsaKey struct {
+	k    *ecdsa.PrivateKey
+	addr common.Address
+}
diff --git a/endorser/execution/epr_bench_test.go b/endorser/execution/epr_bench_test.go
new file mode 100644
index 0000000..689749a
--- /dev/null
+++ b/endorser/execution/epr_bench_test.go
@@ -0,0 +1,114 @@
+package execution
+
+// Endorsement-side overhead of the EPR tracer on real USDC (FiatTokenV2_2 behind its proxy)
+// transfers, measured on go-ethereum's in-memory state (no Fabric-X, no I/O): EVM execution alone vs EVM
+// execution with the taint tracer attached.
+//
+// go test ./endorser/execution -run XXX -bench BenchmarkEPRTracer -benchtime 20000x
+
+import (
+	"encoding/json"
+	"math/big"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/rawdb"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+)
+
+func eprBenchState(b *testing.B, n int) (*state.StateDB, common.Address, []common.Address) {
+	raw, err := os.ReadFile("../../integration/perf/testdata/USDC_contract.json")
+	if err != nil {
+		b.Fatal(err)
+	}
+	var accts map[string]struct {
+		Code    string            `json:"code"`
+		Storage map[string]string `json:"storage"`
+	}
+	if err := json.Unmarshal(raw, &accts); err != nil {
+		b.Fatal(err)
+	}
+	sdb, err := state.New(common.Hash{}, state.NewDatabaseForTesting())
+	if err != nil {
+		b.Fatal(err)
+	}
+	_ = rawdb.NewMemoryDatabase
+	var proxy common.Address
+	for a, acc := range accts {
+		addr := common.HexToAddress(a)
+		sdb.SetCode(addr, common.FromHex(acc.Code), tracing.CodeChangeUnspecified)
+		for k, v := range acc.Storage {
+			sdb.SetState(addr, common.HexToHash(k), common.HexToHash(v))
+		}
+		if strings.EqualFold(a, "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48") {
+			proxy = addr
+		}
+	}
+	users := make([]common.Address, n)
+	slot := common.BigToHash(big.NewInt(9))
+	for i := range users {
+		users[i] = common.BigToAddress(big.NewInt(int64(0x100000 + i)))
+		k := crypto.Keccak256Hash(common.LeftPadBytes(users[i].Bytes(), 32), slot.Bytes())
+		sdb.SetState(proxy, k, common.BigToHash(big.NewInt(1e18)))
+	}
+	return sdb, proxy, users
+}
+
+func eprBenchRun(b *testing.B, withTracer bool) {
+	const nUsers = 1000
+	sdb, proxy, users := eprBenchState(b, nUsers)
+	selector := crypto.Keccak256([]byte("transfer(address,uint256)"))[:4]
+	cfg := params.MainnetChainConfig
+	blockCtx := vm.BlockContext{
+		CanTransfer: core.CanTransfer,
+		Transfer:    core.Transfer,
+		BlockNumber: big.NewInt(30_000_000), Time: 1_800_000_000, GasLimit: 30_000_000,
+		Difficulty: big.NewInt(0), BaseFee: big.NewInt(0), Random: &common.Hash{},
+	}
+	var deltas, total int
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		from, to := users[i%nUsers], users[(i*7+1)%nUsers]
+		input := append(append(append([]byte{}, selector...), common.LeftPadBytes(to.Bytes(), 32)...),
+			common.LeftPadBytes(big.NewInt(int64(1+i%1000)).Bytes(), 32)...)
+		vmCfg := vm.Config{}
+		var tr *EPRTracer
+		if withTracer {
+			tr = NewEPRTracer()
+			vmCfg.Tracer = tr.Hooks()
+		}
+		evm := vm.NewEVM(blockCtx, sdb, cfg, vmCfg)
+		evm.SetTxContext(vm.TxContext{Origin: from, GasPrice: new(uint256.Int)})
+		snap := sdb.Snapshot()
+		ret, _, err := evm.Call(from, proxy, input, vm.NewGasBudget(200_000), new(uint256.Int))
+		if err != nil {
+			b.Fatalf("transfer %d: %v (%x)", i, err, ret)
+		}
+		if tr != nil {
+			for _, st := range tr.slots {
+				if st.written {
+					total++
+					if _, _, _, why := st.extract(map[string]bool{}, true); why == "" {
+						deltas++
+					}
+				}
+			}
+		}
+		sdb.RevertToSnapshot(snap)
+	}
+	b.StopTimer()
+	if withTracer && total > 0 {
+		b.ReportMetric(float64(deltas)/float64(total), "extractable")
+	}
+}
+
+func BenchmarkEPRTracerOff(b *testing.B) { eprBenchRun(b, false) }
+func BenchmarkEPRTracerOn(b *testing.B)  { eprBenchRun(b, true) }
diff --git a/endorser/execution/epr_callinput_test.go b/endorser/execution/epr_callinput_test.go
new file mode 100644
index 0000000..8c0c843
--- /dev/null
+++ b/endorser/execution/epr_callinput_test.go
@@ -0,0 +1,102 @@
+package execution
+
+// A call input that ends inside a tainted word. The caller stores x = SLOAD(0) at memory 0x40 and calls a callee
+// with the input [0x20, 0x50), which holds only the 16 leading bytes of x; the callee stores CALLDATALOAD(0x20),
+// that is, those bytes followed by the zeros the EVM pads call data with. The program tracer must extract a
+// program whose outputs equal the EVM's on other bases. Control: an input [0x50, 0x80), which starts inside the
+// tainted word, still ends extraction (site 15).
+
+import (
+	"math/big"
+	"strings"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/holiman/uint256"
+)
+
+func TestEPRCallInputStraddle(t *testing.T) {
+	e := eprGasEnv(t)
+	owner, user := common.BigToAddress(big.NewInt(0x0E0E)), common.BigToAddress(big.NewInt(0xA11CE))
+	callee := eprGasDeploy(t, e, owner, []byte{0x60, 0x20, 0x35, 0x60, 0x01, 0x55, 0x00}) // SSTORE(1, CALLDATALOAD(0x20))
+	caller := func(argsOff byte) common.Address {
+		code := []byte{0x60, 0x00, 0x54, 0x60, 0x40, 0x52, // MSTORE(0x40, SLOAD(0))
+			0x60, 0x00, 0x60, 0x00, 0x60, 0x30, 0x60, argsOff, 0x60, 0x00, 0x73} // retLen, retOff, argsLen, argsOff, value
+		code = append(code, callee.Bytes()...)
+		code = append(code, 0x62, 0x03, 0x0d, 0x40, 0xf1, 0x50, // CALL(200000, callee, ...); POP
+			0x60, 0x00, 0x54, 0x60, 0x01, 0x01, 0x60, 0x00, 0x55, 0x00) // SSTORE(0, SLOAD(0) + 1)
+		return eprGasDeploy(t, e, owner, code)
+	}
+	calleeSlot1 := storeKey(callee, common.BigToHash(big.NewInt(1)))
+	run := func(c common.Address, x *big.Int, tr *EPRProgTracer) (*big.Int, *big.Int) {
+		snap := e.sdb.Snapshot()
+		defer e.sdb.RevertToSnapshot(snap)
+		e.setKey(storeKey(c, common.Hash{}), x)
+		evm := e.evm(user, nil)
+		if tr != nil {
+			evm = e.evm(user, tr.Hooks())
+		}
+		if _, _, err := evm.Call(user, c, nil, vm.NewGasBudget(1_000_000), new(uint256.Int)); err != nil {
+			t.Fatalf("x = %v: %v", x, err)
+		}
+		return e.getKey(storeKey(c, common.Hash{})), e.getKey(calleeSlot1)
+	}
+	pow := func(n uint) *big.Int { return new(big.Int).Lsh(big.NewInt(1), n) }
+	endorsed := new(big.Int).Add(pow(200), new(big.Int).Add(new(big.Int).Mul(big.NewInt(5), pow(130)), big.NewInt(77)))
+
+	t.Run("ends-inside-word", func(t *testing.T) {
+		c := caller(0x20)
+		slot0 := storeKey(c, common.Hash{})
+		tr := NewEPRProgTracer()
+		run(c, endorsed, tr)
+		writes := map[string]bool{}
+		for s, w := range tr.written {
+			if w {
+				writes[s] = true
+			}
+		}
+		p := tr.Program(writes)
+		if p == nil {
+			t.Fatalf("no program (lostAt=%q)", tr.lostAt)
+		}
+		q, ok := DecodeEPRProgram(p.Encode())
+		if !ok {
+			t.Fatal("program does not round-trip")
+		}
+		bases := []*big.Int{endorsed, new(big.Int).Add(pow(220), big.NewInt(1)), big.NewInt(1), pow(129), big.NewInt(0),
+			new(big.Int).Add(new(big.Int).Mul(big.NewInt(3), pow(150)), new(big.Int).Add(pow(127), big.NewInt(9)))}
+		for _, x := range bases {
+			want0, want1 := run(c, x, nil)
+			out, ok := q.Eval(func(k string) []byte {
+				if k == slot0 {
+					return x.Bytes()
+				}
+				return nil
+			})
+			if !ok {
+				t.Fatalf("x = %v: guards fail", x)
+			}
+			got0, got1 := new(big.Int).SetBytes(out[slot0]), new(big.Int).SetBytes(out[calleeSlot1])
+			if got0.Cmp(want0) != 0 || got1.Cmp(want1) != 0 {
+				t.Fatalf("x = %v: program writes %v, %v; the EVM writes %v, %v", x, got0, got1, want0, want1)
+			}
+		}
+		t.Logf("program: nodes=%d guards=%d, outputs equal the EVM's on %d bases", len(p.Nodes), len(p.Guards), len(bases))
+	})
+
+	t.Run("starts-inside-word", func(t *testing.T) {
+		c := caller(0x50)
+		tr := NewEPRProgTracer()
+		run(c, endorsed, tr)
+		writes := map[string]bool{}
+		for s, w := range tr.written {
+			if w {
+				writes[s] = true
+			}
+		}
+		if p := tr.Program(writes); p != nil || !strings.Contains(tr.lostAt, "site=15") {
+			t.Fatalf("an input starting inside a tainted word was accepted (program %v, lostAt=%q)", p != nil, tr.lostAt)
+		}
+	})
+}
diff --git a/endorser/execution/epr_createpoison_test.go b/endorser/execution/epr_createpoison_test.go
new file mode 100644
index 0000000..a15e439
--- /dev/null
+++ b/endorser/execution/epr_createpoison_test.go
@@ -0,0 +1,67 @@
+package execution
+
+// Init code taken from poisoned memory bytes. A word that depends on a storage read is stored at offset 0 and
+// then half overwritten, so its other 16 bytes are poisoned: they still depend on the read but are no longer
+// shadowed. CREATE2 uses them as init code, so the new contract's address depends on the value read, and the
+// transaction stores that address. A program would replay the endorsed address on every base, so the tracer
+// must give up (site 95), as MLOAD does on poisoned bytes. Control: the same transaction with the whole word as
+// init code yields a program whose equality guard on the word pins the address.
+
+import (
+	"math/big"
+	"strings"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/holiman/uint256"
+)
+
+func TestEPRCreatePoison(t *testing.T) {
+	e := eprGasEnv(t)
+	owner, user := common.BigToAddress(big.NewInt(0x0E0E)), common.BigToAddress(big.NewInt(0xA11CE))
+	code := func(poison bool) []byte {
+		c := []byte{0x60, 0x00, 0x54, 0x60, 0x00, 0x52} // x = SLOAD(0); MSTORE(0, x)
+		size := byte(0x20)
+		if poison {
+			c = append(c, 0x60, 0x00, 0x60, 0x10, 0x52) // MSTORE(16, 0): bytes 0-15 of x are poisoned
+			size = 0x10
+		}
+		c = append(c, 0x60, 0x00, 0x60, size, 0x60, 0x00, 0x60, 0x00, 0xf5) // CREATE2(0, 0, size, salt 0)
+		c = append(c, 0x60, 0x01, 0x55)                                     // SSTORE(1, address)
+		c = append(c, 0x60, 0x00, 0x54, 0x60, 0x01, 0x01, 0x60, 0x00, 0x55) // SSTORE(0, SLOAD(0) + 1)
+		return append(c, 0x00)
+	}
+	for _, tc := range []struct {
+		name   string
+		poison bool
+	}{{"poisoned-init-code", true}, {"whole-word-init-code", false}} {
+		t.Run(tc.name, func(t *testing.T) {
+			c := eprGasDeploy(t, e, owner, code(tc.poison))
+			snap := e.sdb.Snapshot()
+			defer e.sdb.RevertToSnapshot(snap)
+			e.setKey(storeKey(c, common.Hash{}), new(big.Int).Lsh(big.NewInt(1), 200)) // nonzero high bytes
+			tr := NewEPRProgTracer()
+			if _, _, err := e.evm(user, tr.Hooks()).Call(user, c, nil, vm.NewGasBudget(2_000_000), new(uint256.Int)); err != nil {
+				t.Fatalf("endorsed run: %v", err)
+			}
+			writes := map[string]bool{}
+			for s, w := range tr.written {
+				if w {
+					writes[s] = true
+				}
+			}
+			p := tr.Program(writes)
+			if tc.poison {
+				if p != nil || !strings.Contains(tr.lostAt, "site=95") {
+					t.Fatalf("init code from poisoned bytes accepted (program %v, lostAt=%q)", p != nil, tr.lostAt)
+				}
+				t.Logf("lost: %s", tr.lostAt)
+				return
+			}
+			if p == nil {
+				t.Fatalf("control: no program (lostAt=%q)", tr.lostAt)
+			}
+		})
+	}
+}
diff --git a/endorser/execution/epr_diag.go b/endorser/execution/epr_diag.go
