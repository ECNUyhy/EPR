+
+// eprStorageKey reports whether a namespaced key ("<ns>:<key>") is a contract storage key ("str:..."). Signed
+// content (guarded deltas and programs) is recognized on storage keys only, as by the committer: the value of
+// any other key (e.g. contract code) is applied as written, whatever its bytes.
+func eprStorageKey(nsKey string) bool {
+	i := strings.IndexByte(nsKey, ':')
+	return i >= 0 && strings.HasPrefix(nsKey[i+1:], "str:")
+}
+
+// eprIsDelta reports whether a write carries an EPRD2 guarded delta.
+func eprIsDelta(nsKey string, v []byte) bool {
+	return len(v) == 30 && string(v[:5]) == "EPRD2" && eprStorageKey(nsKey)
+}
+
+// eprIsProgram reports whether a write carries an EPRP1 guarded program (longer than a 32-byte storage word).
+func eprIsProgram(nsKey string, v []byte) bool {
+	return len(v) >= execution.EPRProgMinLen && string(v[:5]) == "EPRP1" && eprStorageKey(nsKey)
+}
+
+// eprProgValue returns the value a guarded program writes to update.Key. The program is evaluated once per
+// transaction, on the replica state before the transaction's own writes (all of them are program outputs);
+// the committer only validates the transaction if the program's guards held on the same state.
+func eprProgValue(data map[string]*ValueVersion, update KeyValueVersion, progOut map[string]map[string][]byte) []byte {
+	i := strings.IndexByte(update.Key, ':')
+	ns, raw := update.Key[:i+1], update.Key[i+1:]
+	outs, ok := progOut[update.TxID]
+	if !ok {
+		p, okp := execution.DecodeEPRProgram(update.Value)
+		if okp {
+			outs, okp = p.Eval(func(k string) []byte {
+				if cur, ok := data[ns+k]; ok && !cur.IsDelete {
+					return cur.Value
+				}
+				return nil
+			})
+		}
+		if !okp {
+			lkvLogger.Errorf("EPR program of tx %s does not evaluate on the replica state", update.TxID)
+			outs = map[string][]byte{}
+		}
+		progOut[update.TxID] = outs
+	}
+	if v, ok := outs[raw]; ok {
+		return v
+	}
+	if cur, ok := data[update.Key]; ok {
+		return cur.Value
+	}
+	return nil
+}
+
+// eprApplyDelta applies an EPRD2 guarded delta ("EPRD2" | delta | lower | upper | width) to the previous
+// value (empty, 8-byte int64 BE or 32-byte EVM word), producing a value of the encoded width.
+func eprApplyDelta(prev, v []byte) []byte {
+	delta := int64(binary.BigEndian.Uint64(v[5:13])) //nolint:gosec
+	width := int(v[29])
+	var base int64
+	switch len(prev) {
+	case 8:
+		base = int64(binary.BigEndian.Uint64(prev)) //nolint:gosec
+	case 32:
+		base = int64(binary.BigEndian.Uint64(prev[24:])) //nolint:gosec
+	}
+	out := make([]byte, width)
+	binary.BigEndian.PutUint64(out[width-8:], uint64(base+delta)) //nolint:gosec
+	return out
+}
