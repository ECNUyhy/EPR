@@ -0,0 +1,7 @@
+package execution
+
+// Diagnostics for offline coverage measurement (d16coverage): read-only access to why program
+// extraction gave up. Not used on the endorsement path.
+
+// LostAt reports where the program tracer lost track ("" if it did not).
+func (t *EPRProgTracer) LostAt() string { return t.lostAt }
diff --git a/endorser/execution/epr_diff_test.go b/endorser/execution/epr_diff_test.go
new file mode 100644
index 0000000..c5d399d
--- /dev/null
+++ b/endorser/execution/epr_diff_test.go
@@ -0,0 +1,249 @@
+package execution
+
+// Differential test of guarded-delta extraction on real USDC bytecode (Lemma 1 of the paper).
+//
+// For a transfer endorsed on base balances (x_from, x_to), the tracer extracts for each balance slot s a
+// guarded delta (delta_s, lower_s, upper_s). The test then re-executes the same call on many other bases:
+//   - every base satisfying all guards must succeed and write exactly base + delta_s to every slot s;
+//   - bases just outside a guard bound must NOT reproduce the endorsed outcome (the EVM reverts or writes
+//     something else), showing that the guard is tight rather than merely conservative.
+
+import (
+	"math/big"
+	"math/rand"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+)
+
+type eprDiffEnv struct {
+	sdb   *state.StateDB
+	proxy common.Address
+	ctx   vm.BlockContext
+}
+
+func (e *eprDiffEnv) slotOf(a common.Address) common.Hash {
+	return crypto.Keccak256Hash(common.LeftPadBytes(a.Bytes(), 32), common.BigToHash(big.NewInt(9)).Bytes())
+}
+
+// run executes transfer(to, value) from `from` on the given balances; it returns success and the
+// resulting balances. The state is restored afterwards.
+func (e *eprDiffEnv) run(from, to common.Address, value, bFrom, bTo int64, tr *EPRTracer) (bool, int64, int64) {
+	snap := e.sdb.Snapshot()
+	defer e.sdb.RevertToSnapshot(snap)
+	e.sdb.SetState(e.proxy, e.slotOf(from), common.BigToHash(big.NewInt(bFrom)))
+	e.sdb.SetState(e.proxy, e.slotOf(to), common.BigToHash(big.NewInt(bTo)))
+	selector := crypto.Keccak256([]byte("transfer(address,uint256)"))[:4]
+	input := append(append(append([]byte{}, selector...), common.LeftPadBytes(to.Bytes(), 32)...),
+		common.LeftPadBytes(big.NewInt(value).Bytes(), 32)...)
+	cfg := vm.Config{}
+	if tr != nil {
+		cfg.Tracer = tr.Hooks()
+	}
+	evm := vm.NewEVM(e.ctx, e.sdb, params.MainnetChainConfig, cfg)
+	evm.SetTxContext(vm.TxContext{Origin: from, GasPrice: new(uint256.Int)})
+	_, _, err := evm.Call(from, e.proxy, input, vm.NewGasBudget(300_000), new(uint256.Int))
+	if err != nil {
+		return false, 0, 0
+	}
+	f := new(big.Int).SetBytes(e.sdb.GetState(e.proxy, e.slotOf(from)).Bytes())
+	t := new(big.Int).SetBytes(e.sdb.GetState(e.proxy, e.slotOf(to)).Bytes())
+	return true, f.Int64(), t.Int64()
+}
+
+func TestEPRDifferentialUSDC(t *testing.T) {
+	b := &testing.B{}
+	sdb, proxy, _ := eprBenchState(b, 0)
+	env := &eprDiffEnv{sdb: sdb, proxy: proxy, ctx: vm.BlockContext{
+		CanTransfer: core.CanTransfer, Transfer: core.Transfer,
+		BlockNumber: big.NewInt(30_000_000), Time: 1_800_000_000, GasLimit: 30_000_000,
+		Difficulty: big.NewInt(0), BaseFee: big.NewInt(0), Random: &common.Hash{},
+	}}
+	rng := rand.New(rand.NewSource(16))
+	from := common.BigToAddress(big.NewInt(0xA11CE))
+	to := common.BigToAddress(big.NewInt(0xB0B))
+	keyFrom := storeKey(proxy, env.slotOf(from))
+	keyTo := storeKey(proxy, env.slotOf(to))
+	const cases, rebases = 300, 40
+	var checkedIn, checkedOut, tightLower int
+	for c := 0; c < cases; c++ {
+		value := 1 + rng.Int63n(1_000_000_000)
+		bFrom := value + rng.Int63n(1_000_000_000_000)
+		bTo := rng.Int63n(1_000_000_000_000)
+		tr := NewEPRTracer()
+		ok, _, _ := env.run(from, to, value, bFrom, bTo, tr)
+		if !ok {
+			t.Fatalf("case %d: endorsed transfer failed", c)
+		}
+		tr.GasLeft = 1 << 40
+		written := map[string]bool{keyFrom: true, keyTo: true}
+		dF, lF, uF, whyF := tr.slots[keyFrom].extract(written, true)
+		dT, lT, uT, whyT := tr.slots[keyTo].extract(written, true)
+		if whyF != "" || whyT != "" {
+			t.Fatalf("case %d: not extracted: from=%q to=%q", c, whyF, whyT)
+		}
+		if dF != -value || dT != value {
+			t.Fatalf("case %d: deltas %d/%d, want %d/%d", c, dF, dT, -value, value)
+		}
+		// Bases satisfying both guards: the EVM must succeed and write base + delta.
+		for r := 0; r < rebases; r++ {
+			xF := lF - dF + rng.Int63n(1_000_000_000_000)
+			xT := lT - dT + rng.Int63n(1_000_000_000_000)
+			if xF < 0 {
+				xF = 0
+			}
+			if xT < 0 {
+				xT = 0
+			}
+			if xF+dF < lF || xF+dF > uF || xT+dT < lT || xT+dT > uT {
+				continue
+			}
+			ok, nf, nt := env.run(from, to, value, xF, xT, nil)
+			if !ok || nf != xF+dF || nt != xT+dT {
+				t.Fatalf("case %d rebase (%d,%d): ok=%v got (%d,%d) want (%d,%d)", c, xF, xT, ok, nf, nt, xF+dF, xT+dT)
+			}
+			checkedIn++
+		}
+		// Just below the sender's lower guard bound the endorsed outcome must not be reproduced.
+		if xF := lF - dF - 1; xF >= 0 {
+			ok, nf, nt := env.run(from, to, value, xF, bTo, nil)
+			if ok && nf == xF+dF && nt == bTo+dT {
+				t.Fatalf("case %d: base %d below the guard still reproduces the endorsed outcome", c, xF)
+			}
+			if !ok {
+				tightLower++
+			}
+			checkedOut++
+		}
+	}
+	t.Logf("EPR DIFFERENTIAL cases=%d in_guard_reexecutions=%d out_of_guard_checks=%d tight_lower_bound=%d",
+		cases, checkedIn, checkedOut, tightLower)
+}
+
+// ---- transferFrom: three coupled slots (allowance, sender balance, recipient balance), two guards ----
+
+func (e *eprDiffEnv) call(from common.Address, input []byte, tr *EPRTracer) bool {
+	cfg := vm.Config{}
+	if tr != nil {
+		cfg.Tracer = tr.Hooks()
+	}
+	evm := vm.NewEVM(e.ctx, e.sdb, params.MainnetChainConfig, cfg)
+	evm.SetTxContext(vm.TxContext{Origin: from, GasPrice: new(uint256.Int)})
+	_, _, err := evm.Call(from, e.proxy, input, vm.NewGasBudget(300_000), new(uint256.Int))
+	return err == nil
+}
+
+func eprABI(sig string, args ...[]byte) []byte {
+	in := append([]byte{}, crypto.Keccak256([]byte(sig))[:4]...)
+	for _, a := range args {
+		in = append(in, common.LeftPadBytes(a, 32)...)
+	}
+	return in
+}
+
+// slotHashOf recovers the storage slot hash from a StateDB key "str:<addr>:<slot>".
+func slotHashOf(key string) common.Hash {
+	i := len(key) - 66
+	return common.HexToHash(key[i:])
+}
+
+func TestEPRDifferentialTransferFrom(t *testing.T) {
+	b := &testing.B{}
+	sdb, proxy, _ := eprBenchState(b, 0)
+	env := &eprDiffEnv{sdb: sdb, proxy: proxy, ctx: vm.BlockContext{
+		CanTransfer: core.CanTransfer, Transfer: core.Transfer,
+		BlockNumber: big.NewInt(30_000_000), Time: 1_800_000_000, GasLimit: 30_000_000,
+		Difficulty: big.NewInt(0), BaseFee: big.NewInt(0), Random: &common.Hash{},
+	}}
+	rng := rand.New(rand.NewSource(37))
+	owner := common.BigToAddress(big.NewInt(0x0A11))
+	spender := common.BigToAddress(big.NewInt(0x5EED))
+	to := common.BigToAddress(big.NewInt(0xB0B))
+	keyOwner, keyTo := storeKey(proxy, env.slotOf(owner)), storeKey(proxy, env.slotOf(to))
+	var in, outAllow, outBal int
+	for c := 0; c < 200; c++ {
+		value := 1 + rng.Int63n(1_000_000)
+		bOwner := value + rng.Int63n(1_000_000_000)
+		bTo := rng.Int63n(1_000_000_000)
+		allow := value + rng.Int63n(1_000_000_000)
+		snap := sdb.Snapshot()
+		sdb.SetState(proxy, env.slotOf(owner), common.BigToHash(big.NewInt(bOwner)))
+		sdb.SetState(proxy, env.slotOf(to), common.BigToHash(big.NewInt(bTo)))
+		if !env.call(owner, eprABI("approve(address,uint256)", spender.Bytes(), big.NewInt(allow).Bytes()), nil) {
+			t.Fatal("approve failed")
+		}
+		input := eprABI("transferFrom(address,address,uint256)", owner.Bytes(), to.Bytes(), big.NewInt(value).Bytes())
+		tr := NewEPRTracer()
+		if !env.call(spender, input, tr) {
+			t.Fatalf("case %d: endorsed transferFrom failed", c)
+		}
+		var keyAllow string
+		written := map[string]bool{}
+		for k, st := range tr.slots {
+			if st.written {
+				written[k] = true
+				if k != keyOwner && k != keyTo {
+					keyAllow = k
+				}
+			}
+		}
+		if len(written) != 3 || keyAllow == "" {
+			t.Fatalf("case %d: expected 3 written slots, got %d", c, len(written))
+		}
+		type ext struct{ d, l, u int64 }
+		ex := map[string]ext{}
+		for _, k := range []string{keyOwner, keyTo, keyAllow} {
+			d, l, u, why := tr.slots[k].extract(written, true)
+			if why != "" {
+				t.Fatalf("case %d: slot not extracted: %q", c, why)
+			}
+			ex[k] = ext{d, l, u}
+		}
+		if ex[keyOwner].d != -value || ex[keyTo].d != value || ex[keyAllow].d != -value {
+			t.Fatalf("case %d: deltas %+v", c, ex)
+		}
+		allowSlot := slotHashOf(keyAllow)
+		set := func(xO, xT, xA int64) {
+			sdb.SetState(proxy, env.slotOf(owner), common.BigToHash(big.NewInt(xO)))
+			sdb.SetState(proxy, env.slotOf(to), common.BigToHash(big.NewInt(xT)))
+			sdb.SetState(proxy, allowSlot, common.BigToHash(big.NewInt(xA)))
+		}
+		get := func(slot common.Hash) int64 { return new(big.Int).SetBytes(sdb.GetState(proxy, slot).Bytes()).Int64() }
+		for r := 0; r < 30; r++ {
+			xO := ex[keyOwner].l - ex[keyOwner].d + rng.Int63n(1_000_000_000)
+			xT := rng.Int63n(1_000_000_000)
+			xA := ex[keyAllow].l - ex[keyAllow].d + rng.Int63n(1_000_000_000)
+			s2 := sdb.Snapshot()
+			set(xO, xT, xA)
+			ok := env.call(spender, input, nil)
+			if !ok || get(env.slotOf(owner)) != xO-value || get(env.slotOf(to)) != xT+value || get(allowSlot) != xA-value {
+				t.Fatalf("case %d rebase: ok=%v", c, ok)
+			}
+			sdb.RevertToSnapshot(s2)
+			in++
+		}
+		// just below the allowance guard, then just below the balance guard: both must revert
+		s2 := sdb.Snapshot()
+		set(bOwner, bTo, ex[keyAllow].l-ex[keyAllow].d-1)
+		if env.call(spender, input, nil) {
+			t.Fatalf("case %d: allowance below guard still succeeds", c)
+		}
+		sdb.RevertToSnapshot(s2)
+		outAllow++
+		s2 = sdb.Snapshot()
+		set(ex[keyOwner].l-ex[keyOwner].d-1, bTo, allow)
+		if env.call(spender, input, nil) {
+			t.Fatalf("case %d: balance below guard still succeeds", c)
+		}
+		sdb.RevertToSnapshot(s2)
+		outBal++
+		sdb.RevertToSnapshot(snap)
+	}
+	t.Logf("EPR DIFFERENTIAL transferFrom cases=200 in_guard_reexecutions=%d allowance_guard_tight=%d balance_guard_tight=%d", in, outAllow, outBal)
+}
diff --git a/endorser/execution/epr_diff_usdt_test.go b/endorser/execution/epr_diff_usdt_test.go
new file mode 100644
index 0000000..e151cab
--- /dev/null
+++ b/endorser/execution/epr_diff_usdt_test.go
@@ -0,0 +1,162 @@
+package execution
+
+// Differential test of guarded-delta extraction on TetherToken (USDT, solc 0.8 port shipped
+// with fabric-x-evm). Unlike USDC, a transfer charges a fee computed from storage (basisPointsRate,
+// maximumFee) and credits it to the owner: three balance slots are written and the owner's delta depends
+// on other (stable, MVCC-checked) storage slots. Checked arithmetic (solc 0.8) provides the guards.
+
+import (
+	"math/big"
+	"math/rand"
+	"strings"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/accounts/abi"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+
+	"github.com/hyperledger/fabric-x-evm/integration/contracts"
+)
+
+func TestEPRDifferentialUSDTFee(t *testing.T) {
+	parsed, err := abi.JSON(strings.NewReader(contracts.TetherTokenMetaData.ABI))
+	if err != nil {
+		t.Fatal(err)
+	}
+	sdb, err := state.New(common.Hash{}, state.NewDatabaseForTesting())
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := vm.BlockContext{
+		CanTransfer: core.CanTransfer, Transfer: core.Transfer,
+		BlockNumber: big.NewInt(30_000_000), Time: 1_800_000_000, GasLimit: 30_000_000,
+		Difficulty: big.NewInt(0), BaseFee: big.NewInt(0), Random: &common.Hash{},
+	}
+	owner := common.BigToAddress(big.NewInt(0x0E0E))
+	newEVM := func(from common.Address, tr *EPRTracer) *vm.EVM {
+		cfg := vm.Config{}
+		if tr != nil {
+			cfg.Tracer = tr.Hooks()
+		}
+		evm := vm.NewEVM(ctx, sdb, params.MainnetChainConfig, cfg)
+		evm.SetTxContext(vm.TxContext{Origin: from, GasPrice: new(uint256.Int)})
+		return evm
+	}
+	ctorArgs, err := parsed.Pack("", big.NewInt(1_000_000_000_000_000), "Tether USD", "USDT", big.NewInt(6))
+	if err != nil {
+		t.Fatal(err)
+	}
+	code := append(common.FromHex(contracts.TetherTokenMetaData.Bin), ctorArgs...)
+	_, token, _, err := newEVM(owner, nil).Create(owner, code, vm.NewGasBudget(10_000_000), new(uint256.Int))
+	if err != nil {
+		t.Fatalf("deploy: %v", err)
+	}
+	call := func(from common.Address, tr *EPRTracer, method string, args ...interface{}) bool {
+		in, err := parsed.Pack(method, args...)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, _, err = newEVM(from, tr).Call(from, token, in, vm.NewGasBudget(500_000), new(uint256.Int))
+		return err == nil
+	}
+	// 0.19% fee capped at 20 USDT (the contract requires < 20 basis points)
+	if !call(owner, nil, "setParams", big.NewInt(19), big.NewInt(20)) {
+		t.Fatal("setParams failed")
+	}
+	alice := common.BigToAddress(big.NewInt(0xA11CE))
+	bob := common.BigToAddress(big.NewInt(0xB0B))
+	if !call(owner, nil, "transfer", alice, big.NewInt(1_000_000_000_000)) {
+		t.Fatal("funding transfer failed")
+	}
+	rng := rand.New(rand.NewSource(7))
+	var in, tight, cases int
+	for c := 0; c < 200; c++ {
+		value := 1_000_000 + rng.Int63n(100_000_000_000) // 1 .. 100k USDT, fee sometimes capped
+		snap := sdb.Snapshot()
+		tr := NewEPRTracer()
+		if !call(alice, tr, "transfer", bob, big.NewInt(value)) {
+			t.Fatalf("case %d: endorsed transfer failed", c)
+		}
+		tr.GasLeft = 1 << 40
+		written := map[string]bool{}
+		for k, st := range tr.slots {
+			if st.written {
+				written[k] = true
+			}
+		}
+		if len(written) != 3 {
+			t.Fatalf("case %d: expected 3 written balance slots (sender, recipient, owner), got %d", c, len(written))
+		}
+		type ext struct {
+			slot     common.Hash
+			d, l, u  int64
+			endorsed int64
+		}
+		var exts []ext
+		for k := range written {
+			d, l, u, why := tr.slots[k].extract(written, true)
+			if why != "" {
+				t.Fatalf("case %d: slot not extracted: %q", c, why)
+			}
+			exts = append(exts, ext{slot: slotHashOf(k), d: d, l: l, u: u, endorsed: tr.slots[k].orig.ToBig().Int64()})
+		}
+		sdb.RevertToSnapshot(snap)
+		input, _ := parsed.Pack("transfer", bob, big.NewInt(value))
+		run := func(bases []int64) (bool, []int64) {
+			s2 := sdb.Snapshot()
+			defer sdb.RevertToSnapshot(s2)
+			for i, e := range exts {
+				sdb.SetState(token, e.slot, common.BigToHash(big.NewInt(bases[i])))
+			}
+			_, _, err := newEVM(alice, nil).Call(alice, token, input, vm.NewGasBudget(500_000), new(uint256.Int))
+			if err != nil {
+				return false, nil
+			}
+			out := make([]int64, len(exts))
+			for i, e := range exts {
+				out[i] = new(big.Int).SetBytes(sdb.GetState(token, e.slot).Bytes()).Int64()
+			}
+			return true, out
+		}
+		for r := 0; r < 30; r++ {
+			bases := make([]int64, len(exts))
+			for i, e := range exts {
+				bases[i] = e.l - e.d + rng.Int63n(1_000_000_000_000)
+				if bases[i] < 0 {
+					bases[i] = 0
+				}
+			}
+			ok, out := run(bases)
+			if !ok {
+				t.Fatalf("case %d: rebase within guards reverted", c)
+			}
+			for i, e := range exts {
+				if out[i] != bases[i]+e.d {
+					t.Fatalf("case %d: slot %d wrote %d, want %d", c, i, out[i], bases[i]+e.d)
+				}
+			}
+			in++
+		}
+		// the debited slot (negative delta) just below its guard must revert
+		for i, e := range exts {
+			if e.d >= 0 {
+				continue
+			}
+			bases := make([]int64, len(exts))
+			for j, f := range exts {
+				bases[j] = f.endorsed
+			}
+			bases[i] = e.l - e.d - 1
+			if ok, _ := run(bases); ok {
+				t.Fatalf("case %d: base below the debit guard still succeeds", c)
+			}
+			tight++
+		}
+		cases++
+	}
+	t.Logf("EPR DIFFERENTIAL usdt-fee cases=%d in_guard_reexecutions=%d debit_guard_tight=%d", cases, in, tight)
+}
diff --git a/endorser/execution/epr_gas.go b/endorser/execution/epr_gas.go
new file mode 100644
index 0000000..1cbb241
--- /dev/null
+++ b/endorser/execution/epr_gas.go
@@ -0,0 +1,96 @@
+package execution
+
+// Gas headroom as a checked rule (assumption A7 of the extended version made a condition the
+// tracers verify). On another base on which the guards hold, only two dynamic costs can differ from the
+// endorsed run: SSTORE, whose price depends on the slot's original, current and new values (EIP-2200 with
+// EIP-2929: at most 20,000 versus at least 100, so at most 19,900 more), and EXP, whose price grows by 50 gas
+// per exponent byte (at most 1,600 more). Offsets, sizes, call targets, call values and account fields are
+// guarded or version-checked, so every other cost is equal.
+//
+// Rule: at every opcode other than a call or create, the gas left after the opcode must be at least the
+// extra cost the opcodes executed so far may incur, counted as 20,000 gas per SSTORE and 1,600 gas per EXP
+// (programs only; a delta's labels never reach an exponent).
+//
+// Why it suffices: let E_k be that bound at opcode k. By induction, on any such base the gas available before
+// opcode k is at least the endorsed one minus E_{k-1}. Within a frame this follows from the extra costs paid so
+// far. A callee's allowance is min(gas operand, all but one 64th of the caller's gas): the operand is a
+// constant, the GAS marker, or guarded (program tracer), and neither min nor the 63/64 rule enlarges a
+// difference, so the allowance shrinks by at most the extra cost paid before the call (the program
+// tracer's GAS marker is the remaining gas plus a fixed offset, see epr_prog_tracer.go; if it wraps around on
+// another base it exceeds every allowance, which the 63/64 rule then caps). The rule makes the
+// endorsed gas before opcode k exceed its endorsed cost plus E_k, hence its cost plus its own extra on the
+// other base, so no frame runs out of gas, in particular no callee with a fixed allowance. The base cost of a
+// call is covered by the check at the caller's next opcode, whose gas never exceeds the gas left after the
+// call's base cost. The SSTORE stipend check (gas left above 2,300) holds since E_k >= 20,000.
+//
+// A call or create that fails before its callee starts (its base cost above the gas left, reported
+// with an error or with a cost above the gas) could start on a base with more gas, so it also breaks the
+// rule. Before the first SSTORE or EXP the gas is the same on every base, and afterwards the gas left is at
+// least 20,000, more than any cold-access surcharge, so such a failure always shows up here.
+//
+// The rule replaces the earlier check of the gas left at the end of the transaction per distinct written key,
+// which missed repeated writes to one slot (each write back to the original value makes the next one clean
+// again) and callees with a fixed allowance.
+
+import (
+	"errors"
+
+	"github.com/ethereum/go-ethereum/core/vm"
+)
+
+const (
+	eprGasPerStore = 20_000
+	eprGasPerExp   = 1_600
+)
+
+// eprGasRule accumulates the bound and records whether some opcode left less gas than the rule requires.
+type eprGasRule struct {
+	need      uint64
+	short     bool
+	at        uint64 // pc of the first opcode that broke the rule (diagnostics)
+	depth     int
+	minMargin int64 // smallest gas left after an opcode minus the bound (diagnostics)
+	seen      bool
+}
+
+// step is called from a tracer's OnOpcode with the gas before the opcode and its cost (static plus dynamic,
+// for calls and creates including the callee's allowance); failed reports the opcode's error.
+func (g *eprGasRule) step(pc uint64, op byte, gas, cost uint64, depth int, countExp, failed bool) {
+	switch op {
+	case 0x55: // SSTORE
+		g.need += eprGasPerStore
+	case 0x0a: // EXP
+		if countExp {
+			g.need += eprGasPerExp
+		}
+	case 0xf0, 0xf1, 0xf2, 0xf4, 0xf5, 0xfa: // CREATE, CALL, CALLCODE, DELEGATECALL, CREATE2, STATICCALL
+		// the cost includes the callee's allowance, so the caller's next opcode checks the bound; a call
+		// that fails before its callee starts breaks the rule
+		if !g.short && (failed || cost > gas) {
+			g.short, g.at, g.depth = true, pc, depth
+		}
+		return
+	}
+	if m := int64(gas) - int64(cost) - int64(g.need); !g.seen || m < g.minMargin {
+		g.minMargin, g.seen = m, true
+	}
+	if !g.short && (cost > gas || gas-cost < g.need) {
+		g.short, g.at, g.depth = true, pc, depth
+	}
+}
+
+// exit is called from a tracer's OnExit with the frame's error: a frame that halts for lack of gas after a
+// value-dependent cost may run to completion on a base with more gas, so it breaks the rule. This also
+// covers a call or create that fails before its callee starts, whatever the opcode hook reports for it.
+func (g *eprGasRule) exit(depth int, err error) {
+	if !g.short && g.need > 0 && err != nil && (errors.Is(err, vm.ErrOutOfGas) ||
+		errors.Is(err, vm.ErrGasUintOverflow) || errors.Is(err, vm.ErrCodeStoreOutOfGas)) {
+		g.short, g.depth = true, depth
+	}
+}
+
+// GasShort reports whether the endorsed run broke the gas rule (extraction must then keep plain writes).
+func (t *EPRTracer) GasShort() bool { return t.gas.short }
+
+// GasShort reports whether the endorsed run broke the gas rule (extraction must then keep plain writes).
+func (t *EPRProgTracer) GasShort() bool { return t.gasRule.short }
diff --git a/endorser/execution/epr_gasmarker_test.go b/endorser/execution/epr_gasmarker_test.go
new file mode 100644
index 0000000..eb9a0af
--- /dev/null
+++ b/endorser/execution/epr_gasmarker_test.go
@@ -0,0 +1,242 @@
+package execution
+
+// The GAS marker of the program tracer. After an SSTORE the
+// remaining gas may differ on another base, so GAS yields a marker that may only set a call's gas. The
+// AND example passes the marker through AND 65536: the SSTORE of slot 0 costs 2,900 on the endorsed
+// base (x = 1) and 20,000 on base 0, so the remaining gas drops from about 70,000 to about 52,900, bit 16
+// clears, and the callee gets no gas at all; the caller reverts, while a program would still write x + 1.
+// The tracer must now lose every marker expression other than the remaining gas plus or minus a constant
+// (site 93). Controls: raw GAS, GAS - 5000 and GAS + 5000 yield programs whose outputs equal the EVM's on
+// every base on which their guards hold. Two more tests cover a frame that runs out of gas after an SSTORE:
+// end to end (a callee's CREATE) and at the rule itself (a call that fails before its callee starts).
+
+import (
+	"math/big"
+	"strings"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/holiman/uint256"
+)
+
+func TestEPRGasMarker(t *testing.T) {
+	e := eprGasEnv(t)
+	owner, user := common.BigToAddress(big.NewInt(0x0E0E)), common.BigToAddress(big.NewInt(0xA11CE))
+	// callee: a loop of 1,200 iterations (about 31,200 gas) without state access
+	child := eprGasDeploy(t, e, owner, []byte{
+		0x61, 0x04, 0xb0, // PUSH2 1200
+		0x5b, 0x60, 0x01, 0x90, 0x03, // loop (0x03): JUMPDEST; counter - 1
+		0x80, 0x60, 0x03, 0x57, // DUP1; PUSH1 loop; JUMPI
+		0x00,
+	})
+	// caller: SSTORE(0, SLOAD(0) + 1); ok = CALL(gasExpr, child, 0, no input, no output); if !ok REVERT
+	parent := func(gasExpr []byte) []byte {
+		code := []byte{0x60, 0x00, 0x54, 0x60, 0x01, 0x01, 0x60, 0x00, 0x55,
+			0x60, 0x00, 0x60, 0x00, 0x60, 0x00, 0x60, 0x00, 0x60, 0x00, 0x73}
+		code = append(code, child.Bytes()...)
+		code = append(code, gasExpr...)
+		code = append(code, 0xf1, 0x15, 0x60, 0x00, 0x57, 0x00) // CALL; ISZERO; PUSH1 rev; JUMPI; STOP
+		code[len(code)-3] = byte(len(code))
+		return append(code, 0x5b, 0x60, 0x00, 0x80, 0xfd) // rev: JUMPDEST; REVERT(0, 0)
+	}
+	negAdd := func(k uint64) []byte { // PUSH32 2^256 - k; GAS; ADD: a subtraction as compilers encode it
+		v := new(uint256.Int).Neg(uint256.NewInt(k)).Bytes32()
+		return append(append([]byte{0x7f}, v[:]...), 0x5a, 0x01)
+	}
+	cases := []struct {
+		name    string
+		gasExpr []byte
+		program bool // false: extraction must give up at site 93
+	}{
+		{"raw", []byte{0x5a}, true},
+		{"minus-as-add", negAdd(5000), true},          // GAS + (2^256 - 5000)
+		{"minus-as-add-wraps", negAdd(100000), false}, // GAS + (2^256 - 100000), GAS < 100000 when endorsed
+		{"minus-const", []byte{0x61, 0x13, 0x88, 0x5a, 0x03}, true},          // GAS - 5000
+		{"plus-const", []byte{0x61, 0x13, 0x88, 0x5a, 0x01}, true},           // GAS + 5000
+		{"and-mask", []byte{0x62, 0x01, 0x00, 0x00, 0x5a, 0x16}, false},      // GAS & 65536 (the AND example)
+		{"minus-wraps", []byte{0x62, 0x01, 0x86, 0xa0, 0x5a, 0x03}, false},   // GAS - 100000 < 0 when endorsed
+		{"const-minus-gas", []byte{0x5a, 0x62, 0x01, 0xfb, 0xd0, 0x03}, false}, // 130000 - GAS
+		{"times-two", []byte{0x60, 0x02, 0x5a, 0x02}, false},                 // GAS * 2
+		{"two-readings", []byte{0x5a, 0x5a, 0x01}, false},                    // GAS + GAS
+		{"plus-huge", []byte{0x68, 0x01, 0, 0, 0, 0, 0, 0, 0, 0, 0x5a, 0x01}, false}, // GAS + 2^64
+	}
+	contracts := map[string]common.Address{}
+	for _, tc := range cases {
+		code := parent(tc.gasExpr)
+		if code[code[len(code)-8]] != 0x5b {
+			t.Fatalf("%s: bad revert target", tc.name)
+		}
+		contracts[tc.name] = eprGasDeploy(t, e, owner, code)
+	}
+	run := func(c common.Address, x int64, budget uint64, tr *EPRProgTracer) (*big.Int, error) {
+		snap := e.sdb.Snapshot()
+		defer e.sdb.RevertToSnapshot(snap)
+		slot0 := storeKey(c, common.Hash{})
+		e.setKey(slot0, big.NewInt(x))
+		evm := e.evm(user, nil)
+		if tr != nil {
+			evm = e.evm(user, tr.Hooks())
+		}
+		_, _, err := evm.Call(user, c, nil, vm.NewGasBudget(budget), new(uint256.Int))
+		return e.getKey(slot0), err
+	}
+
+	// a gas limit at which the AND example succeeds on the endorsed base (x = 1) and reverts on base 0
+	and := contracts["and-mask"]
+	budget := uint64(0)
+	for b := uint64(70_000); b <= 100_000; b += 250 {
+		_, err1 := run(and, 1, b, nil)
+		v0, err0 := run(and, 0, b, nil)
+		if err1 == nil && err0 != nil && v0.Int64() == 0 {
+			budget = b
+			break
+		}
+	}
+	if budget == 0 {
+		t.Fatal("no gas limit separates the two bases: the example does not reproduce")
+	}
+	t.Logf("gas limit %d: AND 65536 succeeds on x = 1 and reverts on x = 0 (the write of x + 1 is lost)", budget)
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			c := contracts[tc.name]
+			slot0 := storeKey(c, common.Hash{})
+			tr := NewEPRProgTracer()
+			if v, err := run(c, 1, budget, tr); err != nil || v.Int64() != 2 {
+				t.Fatalf("endorsed run: %v %v", v, err)
+			}
+			if (tc.program || tc.name == "and-mask") && tr.GasShort() { // the example must pass the per-opcode rule
+				t.Fatalf("the per-opcode rule rejects the endorsed run (pc %d, need %d): the case tests nothing",
+					tr.gasRule.at, tr.gasRule.need)
+			}
+			writes := map[string]bool{}
+			for s, w := range tr.written {
+				if w {
+					writes[s] = true
+				}
+			}
+			p := tr.Program(writes)
+			if !tc.program {
+				if p != nil || !strings.Contains(tr.lostAt, "site=93") {
+					t.Fatalf("marker expression accepted (program %v, lostAt=%q)", p != nil, tr.lostAt)
+				}
+				t.Logf("lost: %s", tr.lostAt)
+				return
+			}
+			if p == nil {
+				t.Fatalf("no program (lostAt=%q)", tr.lostAt)
+			}
+			q, ok := DecodeEPRProgram(p.Encode())
+			if !ok {
+				t.Fatal("program does not round-trip")
+			}
+			held := 0
+			for _, x := range []int64{1, 0, 2, 7, 1 << 40} {
+				want, err := run(c, x, budget, nil)
+				if err != nil {
+					t.Fatalf("x = %d: the EVM fails (%v) although the rule accepted the endorsed run", x, err)
+				}
+				out, ok := q.Eval(func(k string) []byte {
+					if k == slot0 {
+						return big.NewInt(x).Bytes()
+					}
+					return nil
+				})
+				if !ok {
+					continue
+				}
+				held++
+				if got := new(big.Int).SetBytes(out[slot0]); got.Cmp(want) != 0 {
+					t.Fatalf("x = %d: program writes %v, the EVM writes %v", x, got, want)
+				}
+			}
+			if held == 0 {
+				t.Fatal("guards fail on every base")
+			}
+			t.Logf("program: nodes=%d guards=%d, outputs equal the EVM's on %d bases", len(p.Nodes), len(p.Guards), held)
+		})
+	}
+}
+
+// End to end: a caller gives a callee a fixed 50,000 gas; the callee writes SLOAD(0)+1 and then runs CREATE
+// (32,000 gas). On the endorsed base (slot 0 = 0) the SSTORE costs 20,000, the callee has about 27,900 gas
+// left (above the 20,000 the rule asks), and CREATE runs out of gas: the callee halts and its write is undone.
+// On base 1 the SSTORE costs 2,900, CREATE succeeds and the write stays. Both tracers must reject the endorsed
+// run; with 80,000 gas the CREATE succeeds on both bases and the run is accepted.
+func TestEPRGasRuleFailedCreateInCallee(t *testing.T) {
+	e := eprGasEnv(t)
+	owner, user := common.BigToAddress(big.NewInt(0x0E0E)), common.BigToAddress(big.NewInt(0xA11CE))
+	callee := eprGasDeploy(t, e, owner, []byte{
+		0x60, 0x00, 0x54, 0x60, 0x01, 0x01, 0x60, 0x00, 0x55, // SSTORE(0, SLOAD(0) + 1)
+		0x60, 0x00, 0x60, 0x00, 0x60, 0x00, 0xf0, 0x50, 0x00, // CREATE(0, 0, 0); POP; STOP
+	})
+	caller := func(gas uint32) common.Address {
+		code := []byte{0x60, 0x00, 0x60, 0x00, 0x60, 0x00, 0x60, 0x00, 0x60, 0x00, 0x73}
+		code = append(code, callee.Bytes()...)
+		code = append(code, 0x62, byte(gas>>16), byte(gas>>8), byte(gas), 0xf1, 0x50, 0x00) // PUSH3 gas; CALL; POP; STOP
+		return eprGasDeploy(t, e, owner, code)
+	}
+	tight, roomy := caller(50_000), caller(80_000)
+	slot0 := storeKey(callee, common.Hash{})
+	run := func(to common.Address, x int64, d *EPRTracer, p *EPRProgTracer) *big.Int {
+		snap := e.sdb.Snapshot()
+		defer e.sdb.RevertToSnapshot(snap)
+		e.setKey(slot0, big.NewInt(x))
+		evm := e.evm(user, nil)
+		if d != nil {
+			evm = e.evm(user, EPRCombineHooks(d, p))
+		}
+		if _, _, err := evm.Call(user, to, nil, vm.NewGasBudget(1_000_000), new(uint256.Int)); err != nil {
+			t.Fatalf("caller fails: %v", err)
+		}
+		return e.getKey(slot0)
+	}
+	if v0, v1 := run(tight, 0, nil, nil), run(tight, 1, nil, nil); v0.Int64() != 0 || v1.Int64() != 2 {
+		t.Fatalf("the callee's fate should depend on the base: slot after base 0 = %v, after base 1 = %v", v0, v1)
+	}
+	d, p := NewEPRTracer(), NewEPRProgTracer()
+	run(tight, 0, d, p)
+	if !d.GasShort() || !p.GasShort() {
+		t.Fatalf("a callee that runs out of gas after an SSTORE is accepted (delta %v, program %v)", d.GasShort(), p.GasShort())
+	}
+	d, p = NewEPRTracer(), NewEPRProgTracer()
+	if v := run(roomy, 0, d, p); v.Int64() != 1 {
+		t.Fatalf("control: slot %v", v)
+	}
+	if d.GasShort() || p.GasShort() {
+		t.Fatalf("control rejected (delta at pc %d, program at pc %d)", d.gas.at, p.gasRule.at)
+	}
+	if v := run(roomy, 1, nil, nil); v.Int64() != 2 {
+		t.Fatalf("control on base 1: slot %v", v)
+	}
+}
+
+// A call whose base cost exceeds the gas left fails before its callee starts; on a base where an earlier
+// SSTORE is cheaper it could start, so the rule must reject the endorsed run.
+func TestEPRGasRuleFailedCall(t *testing.T) {
+	var g eprGasRule
+	g.step(0, 0x55, 50_000, 2_900, 0, true, false) // SSTORE: 47,100 left, need 20,000
+	g.step(1, 0xf1, 30_000, 36_600, 0, true, true) // CALL with value to a new account: out of gas
+	if !g.short {
+		t.Fatal("a call that fails before its callee starts is accepted")
+	}
+	var h eprGasRule
+	h.step(0, 0x55, 50_000, 2_900, 0, true, false)
+	h.step(1, 0xf1, 30_000, 30_000, 0, true, false) // a call that starts with all the gas it may take
+	h.step(2, 0x50, 25_000, 2, 0, true, false)
+	if h.short {
+		t.Fatal("cost within the gas left and no error: must be accepted")
+	}
+	h.step(3, 0xfa, 25_000, 2_600, 0, true, true) // STATICCALL whose failure shows only as an error
+	if !h.short {
+		t.Fatal("a failed call reported with an error only is accepted")
+	}
+	var k eprGasRule // a call that starts: its cost includes the allowance and stays within the gas
+	k.step(0, 0x55, 50_000, 2_900, 0, true, false)
+	k.step(1, 0xf1, 47_000, 46_300, 0, true, false)
+	k.step(2, 0x50, 25_000, 2, 0, true, false)
+	if k.short {
+		t.Fatalf("a call that starts is rejected (pc %d)", k.at)
+	}
+}
diff --git a/endorser/execution/epr_gasrule_test.go b/endorser/execution/epr_gasrule_test.go
new file mode 100644
index 0000000..17b0387
--- /dev/null
+++ b/endorser/execution/epr_gasrule_test.go
@@ -0,0 +1,178 @@
+package execution
+
+// Two gas counterexamples, checked against the
+// per-opcode gas rule of epr_gas.go.
+//   repeated-writes: a program writes one slot five times, twice back to its original value, so every
+//     write is priced as a clean write again; on a zero base the three clean writes cost 3 x 17,100 more.
+//     The old check (20k left at the end per written key) accepts the endorsed run; on the other base the
+//     same gas limit runs out. The rule must reject it.
+//   fixed-allowance callee: a caller calls a child with a fixed 10,000 gas; the child writes SLOAD(0)+1, a
+//     delta. On a zero base the SSTORE costs 20,000 and the child runs out of gas, so the write is lost
+//     although the caller ends with plenty of gas. The rule must reject it.
+// Controls: the same transactions with enough headroom in every frame are accepted.
+
+import (
+	"math/big"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/holiman/uint256"
+)
+
+func eprGasEnv(t *testing.T) *eprUniEnv {
+	sdb, err := state.New(common.Hash{}, state.NewDatabaseForTesting())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &eprUniEnv{t: t, sdb: sdb, ctx: vm.BlockContext{
+		CanTransfer: core.CanTransfer, Transfer: core.Transfer,
+		BlockNumber: big.NewInt(30_000_000), Time: 1_800_000_000, GasLimit: 30_000_000,
+		Difficulty: big.NewInt(0), BaseFee: big.NewInt(0), Random: &common.Hash{},
+	}}
+}
+
+func eprGasDeploy(t *testing.T, e *eprUniEnv, owner common.Address, runtime []byte) common.Address {
+	if len(runtime) > 255 {
+		t.Fatal("runtime too long for the one-byte init code")
+	}
+	initCode := append([]byte{0x60, byte(len(runtime)), 0x80, 0x60, 0x0b, 0x60, 0x00, 0x39, 0x60, 0x00, 0xf3}, runtime...)
+	_, c, _, err := e.evm(owner, nil).Create(owner, initCode, vm.NewGasBudget(1_000_000), new(uint256.Int))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return c
+}
+
+func TestEPRGasRuleRepeatedWrites(t *testing.T) {
+	e := eprGasEnv(t)
+	owner, user := common.BigToAddress(big.NewInt(0x0E0E)), common.BigToAddress(big.NewInt(0xA11CE))
+	runtime := []byte{
+		0x60, 0x00, 0x54, // x = SLOAD(0)
+		0x60, 0x02, 0x60, 0x00, 0x55, // SSTORE(0, 2)
+		0x80, 0x60, 0x00, 0x55, // SSTORE(0, x)
+		0x60, 0x02, 0x60, 0x00, 0x55, // SSTORE(0, 2)
+		0x80, 0x60, 0x00, 0x55, // SSTORE(0, x)
+		0x60, 0x01, 0x01, 0x60, 0x00, 0x55, // SSTORE(0, x + 1)
+		0x00,
+	}
+	c := eprGasDeploy(t, e, owner, runtime)
+	slot0 := storeKey(c, common.Hash{})
+	run := func(x int64, budget uint64, tr *EPRProgTracer) (uint64, *big.Int, error) {
+		snap := e.sdb.Snapshot()
+		defer e.sdb.RevertToSnapshot(snap)
+		e.setKey(slot0, big.NewInt(x))
+		evm := e.evm(user, nil)
+		if tr != nil {
+			evm = e.evm(user, tr.Hooks())
+		}
+		b := vm.NewGasBudget(budget)
+		_, left, err := evm.Call(user, c, nil, b, new(uint256.Int))
+		return left.Used(b), e.getKey(slot0), err
+	}
+	used1, _, err := run(1, 1_000_000, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	used0, _, err := run(0, 1_000_000, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("gas used: base 1 %d, base 0 %d (difference %d)", used1, used0, used0-used1)
+	budget := used1 + 25_000 // the old check needs 20,000 per written key: one key
+
+	tr := NewEPRProgTracer()
+	if _, v, err := run(1, budget, tr); err != nil || v.Int64() != 2 {
+		t.Fatalf("endorsed run: %v %v", v, err)
+	}
+	writes := map[string]bool{}
+	for s, w := range tr.written {
+		if w {
+			writes[s] = true
+		}
+	}
+	if p := tr.Program(writes); p == nil {
+		t.Fatalf("no program (lostAt=%q): the counterexample needs one", tr.lostAt)
+	}
+	if left := budget - used1; left < eprGasPerSlot*uint64(len(writes)) {
+		t.Fatalf("the old check would reject it already (left %d)", left)
+	}
+	if _, _, err := run(0, budget, nil); err == nil {
+		t.Fatal("base 0 does not run out of gas with the endorsed gas limit")
+	}
+	if !tr.GasShort() {
+		t.Fatal("gas rule accepts a program whose re-execution runs out of gas on base 0")
+	}
+	t.Logf("rejected: rule broken at pc %d (depth %d), need %d", tr.gasRule.at, tr.gasRule.depth, tr.gasRule.need)
+
+	ok := NewEPRProgTracer() // control: 100k of headroom covers five SSTOREs
+	if _, _, err := run(1, used1+110_000, ok); err != nil {
+		t.Fatal(err)
+	}
+	if ok.GasShort() {
+		t.Fatalf("control rejected: pc %d need %d", ok.gasRule.at, ok.gasRule.need)
+	}
+	if _, v, err := run(0, used1+110_000, nil); err != nil || v.Int64() != 1 {
+		t.Fatalf("control on base 0: %v %v", v, err)
+	}
+}
+
+func TestEPRGasRuleFixedAllowanceCallee(t *testing.T) {
+	e := eprGasEnv(t)
+	owner, user := common.BigToAddress(big.NewInt(0x0E0E)), common.BigToAddress(big.NewInt(0xA11CE))
+	child := eprGasDeploy(t, e, owner, []byte{
+		0x60, 0x01, 0x60, 0x00, 0x54, 0x01, 0x60, 0x00, 0x55, 0x00, // SSTORE(0, SLOAD(0) + 1); STOP
+	})
+	callWith := func(gas uint16) []byte {
+		code := []byte{0x60, 0x00, 0x60, 0x00, 0x60, 0x00, 0x60, 0x00, 0x60, 0x00, 0x73} // ret, args, value 0
+		code = append(code, child.Bytes()...)
+		code = append(code, 0x61, byte(gas>>8), byte(gas), 0xf1, 0x50, 0x00) // PUSH2 gas; CALL; POP; STOP
+		return code
+	}
+	parent := eprGasDeploy(t, e, owner, callWith(10_000))
+	roomy := eprGasDeploy(t, e, owner, callWith(60_000))
+	slot0 := storeKey(child, common.Hash{})
+	run := func(to common.Address, x int64, tr *EPRTracer) (*big.Int, error) {
+		snap := e.sdb.Snapshot()
+		defer e.sdb.RevertToSnapshot(snap)
+		e.setKey(slot0, big.NewInt(x))
+		evm := e.evm(user, nil)
+		if tr != nil {
+			evm = e.evm(user, tr.Hooks())
+		}
+		_, _, err := evm.Call(user, to, nil, vm.NewGasBudget(300_000), new(uint256.Int))
+		return e.getKey(slot0), err
+	}
+	tr := NewEPRTracer()
+	if v, err := run(parent, 1, tr); err != nil || v.Int64() != 2 {
+		t.Fatalf("endorsed run: %v %v", v, err)
+	}
+	written := map[string]bool{slot0: true}
+	st := tr.slots[slot0]
+	if st == nil {
+		t.Fatal("child slot not traced")
+	}
+	if d, _, _, why := st.extract(written, true); why != "" || d != 1 {
+		t.Fatalf("the counterexample needs a delta +1: d=%d why=%q", d, why)
+	}
+	if v, err := run(parent, 0, nil); err != nil || v.Int64() != 0 {
+		t.Fatalf("base 0 should lose the child's write (child out of gas): %v %v", v, err)
+	}
+	if !tr.GasShort() {
+		t.Fatal("gas rule accepts a delta whose callee runs out of gas on base 0")
+	}
+	t.Logf("rejected: rule broken at pc %d (depth %d), need %d", tr.gas.at, tr.gas.depth, tr.gas.need)
+
+	ok := NewEPRTracer() // control: a 60,000 allowance covers the child's one SSTORE
+	if _, err := run(roomy, 1, ok); err != nil {
+		t.Fatal(err)
+	}
+	if ok.GasShort() {
+		t.Fatalf("control rejected: pc %d need %d", ok.gas.at, ok.gas.need)
+	}
+	if v, err := run(roomy, 0, nil); err != nil || v.Int64() != 1 {
+		t.Fatalf("control on base 0: %v %v", v, err)
+	}
+}
diff --git a/endorser/execution/epr_gasrule_workload_test.go b/endorser/execution/epr_gasrule_workload_test.go
new file mode 100644
index 0000000..c9d3603
--- /dev/null
+++ b/endorser/execution/epr_gasrule_workload_test.go
@@ -0,0 +1,200 @@
+package execution
+
+// The per-opcode gas rule must accept every transaction of the evaluated
+// workloads at the gas limits the experiments use, so that the accepted set, and hence every throughput
+// result, is unchanged. Transfers (USDC, USDT and Zipf all run on the USDC contract) are checked at a 300k
+// limit, stricter than the datasets' 5M; SmallBank at its 300k; DEX router swaps at their 800k. Each line
+// GASRULE ... is parsed by the server queue.
+
+import (
+	"encoding/json"
+	"math/big"
+	"math/rand"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/accounts/abi"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/holiman/uint256"
+)
+
+// Also counts programs lost to the GAS marker rule (sites 93, 94 of epr_prog_tracer.go); the
+// workloads' extraction, and hence every throughput result, must not change.
+type eprGasTally struct {
+	name             string
+	n, short, failed int
+	marker           int
+	min              int64
+	seen             bool
+}
+
+func (g *eprGasTally) prog(p *EPRProgTracer) {
+	if strings.Contains(p.lostAt, "site=93") || strings.Contains(p.lostAt, "site=94") {
+		g.marker++
+	}
+}
+
+func (g *eprGasTally) add(rules ...*eprGasRule) {
+	g.n++
+	for _, r := range rules {
+		if r.short {
+			g.short++
+			break
+		}
+	}
+	for _, r := range rules {
+		if r.seen && (!g.seen || r.minMargin < g.min) {
+			g.min, g.seen = r.minMargin, true
+		}
+	}
+}
+
+func (g *eprGasTally) report(t *testing.T) {
+	t.Logf("GASRULE workload=%s txs=%d rejected=%d reverted=%d min_margin=%d marker_lost=%d", g.name, g.n, g.short,
+		g.failed, g.min, g.marker)
+	if g.short > 0 {
+		t.Errorf("%s: the gas rule rejects %d of %d transactions", g.name, g.short, g.n)
+	}
+	if g.marker > 0 {
+		t.Errorf("%s: the GAS marker rule drops the program of %d of %d transactions", g.name, g.marker, g.n)
+	}
+}
+
+func TestEPRGasRuleWorkloads(t *testing.T) {
+	// transfers on the USDC contract
+	b := &testing.B{}
+	sdb, proxy, _ := eprBenchState(b, 0)
+	env := &eprDiffEnv{sdb: sdb, proxy: proxy, ctx: vm.BlockContext{
+		CanTransfer: core.CanTransfer, Transfer: core.Transfer,
+		BlockNumber: big.NewInt(30_000_000), Time: 1_800_000_000, GasLimit: 30_000_000,
+		Difficulty: big.NewInt(0), BaseFee: big.NewInt(0), Random: &common.Hash{},
+	}}
+	rng := rand.New(rand.NewSource(1107))
+	tr := &eprGasTally{name: "transfer"}
+	for c := 0; c < 300; c++ {
+		from := common.BigToAddress(big.NewInt(0x10000 + rng.Int63n(1000)))
+		to := common.BigToAddress(big.NewInt(0x20000 + rng.Int63n(1000)))
+		value := 1 + rng.Int63n(1_000_000_000)
+		bTo := rng.Int63n(1_000_000_000_000)
+		if c%3 == 0 {
+			bTo = 0 // a fresh recipient: zero-to-nonzero write
+		}
+		d := NewEPRTracer()
+		if ok, _, _ := env.run(from, to, value, value+rng.Int63n(1_000_000_000_000), bTo, d); !ok {
+			tr.failed++
+			continue
+		}
+		tr.add(&d.gas)
+	}
+	tr.report(t)
+
+	// SmallBank at its dataset gas limit
+	if path := os.Getenv("D16_SMALLBANK_JSON"); path == "" {
+		t.Log("D16_SMALLBANK_JSON not set: SmallBank skipped")
+	} else {
+		raw, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var art struct {
+			ABI json.RawMessage `json:"abi"`
+			Bin string          `json:"bin"`
+		}
+		if err := json.Unmarshal(raw, &art); err != nil {
+			t.Fatal(err)
+		}
+		sb, _ := abi.JSON(strings.NewReader(string(art.ABI)))
+		e := newEPRUniEnv(t)
+		_, bank, _, err := e.evm(e.owner, nil).Create(e.owner, common.FromHex(art.Bin), vm.NewGasBudget(10_000_000), new(uint256.Int))
+		if err != nil {
+			t.Fatal(err)
+		}
+		initBal := new(big.Int).Exp(big.NewInt(10), big.NewInt(12), nil)
+		if err := e.call(e.owner, bank, nil, sb, "init", big.NewInt(0), big.NewInt(16), initBal, initBal); err != nil {
+			t.Fatal(err)
+		}
+		acct := func() *big.Int { return big.NewInt(rng.Int63n(16)) }
+		amt := func() *big.Int { return big.NewInt(1 + rng.Int63n(1000)) }
+		ops := map[string]func() []interface{}{
+			"depositChecking": func() []interface{} { return []interface{}{acct(), amt()} },
+			"transactSavings": func() []interface{} { return []interface{}{acct(), amt()} },
+			"sendPayment":     func() []interface{} { a := rng.Int63n(15); return []interface{}{big.NewInt(a), big.NewInt(a + 1), amt()} },
+			"writeCheck":      func() []interface{} { return []interface{}{acct(), amt()} },
+			"amalgamate":      func() []interface{} { a := rng.Int63n(15); return []interface{}{big.NewInt(a), big.NewInt(a + 1)} },
+			"balance":         func() []interface{} { return []interface{}{acct()} },
+		}
+		g := &eprGasTally{name: "smallbank"}
+		for name, args := range ops {
+			for c := 0; c < 50; c++ {
+				in, err := sb.Pack(name, args()...)
+				if err != nil {
+					t.Fatal(err)
+				}
+				snap := e.sdb.Snapshot()
+				d, p := NewEPRTracer(), NewEPRProgTracer()
+				_, _, err = e.evm(e.user, EPRCombineHooks(d, p)).Call(e.user, bank, in, vm.NewGasBudget(300_000), new(uint256.Int))
+				e.sdb.RevertToSnapshot(snap)
+				if err != nil {
+					g.failed++
+					continue
+				}
+				g.add(&d.gas, &p.gasRule)
+				g.prog(p)
+			}
+		}
+		g.report(t)
+	}
+
+	// DEX router swaps at their dataset gas limit
+	if path := os.Getenv("D16_ROUTER_JSON"); path == "" {
+		t.Log("D16_ROUTER_JSON not set: DEX skipped")
+	} else {
+		raw, _ := os.ReadFile(path)
+		var art struct {
+			ABI json.RawMessage `json:"abi"`
+			Bin string          `json:"bin"`
+		}
+		if err := json.Unmarshal(raw, &art); err != nil {
+			t.Fatal(err)
+		}
+		rABI, _ := abi.JSON(strings.NewReader(string(art.ABI)))
+		e := newEPRUniEnv(t)
+		_, router, _, err := e.evm(e.owner, nil).Create(e.owner, common.FromHex(art.Bin), vm.NewGasBudget(10_000_000), new(uint256.Int))
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, tok := range []common.Address{e.t0, e.t1} {
+			if err := e.call(e.owner, tok, nil, e.erc, "transfer", e.user, big.NewInt(1_000_000_000_000)); err != nil {
+				t.Fatal(err)
+			}
+			if err := e.call(e.user, tok, nil, e.erc, "approve", router, new(big.Int).Lsh(big.NewInt(1), 200)); err != nil {
+				t.Fatal(err)
+			}
+		}
+		g := &eprGasTally{name: "dex"}
+		for c := 0; c < 200; c++ {
+			tokenIn := e.t0
+			if c%2 == 1 {
+				tokenIn = e.t1
+			}
+			in, err := rABI.Pack("swapExactIn", e.pair, tokenIn, big.NewInt(1_000_000+rng.Int63n(1_000_000_000)), big.NewInt(1))
+			if err != nil {
+				t.Fatal(err)
+			}
+			snap := e.sdb.Snapshot()
+			d, p := NewEPRTracer(), NewEPRProgTracer()
+			_, _, err = e.evm(e.user, EPRCombineHooks(d, p)).Call(e.user, router, in, vm.NewGasBudget(800_000), new(uint256.Int))
+			e.sdb.RevertToSnapshot(snap)
+			if err != nil {
+				g.failed++
+				continue
+			}
+			g.add(&d.gas, &p.gasRule)
+			g.prog(p)
+		}
+		g.report(t)
+	}
+}
diff --git a/endorser/execution/epr_lazy.go b/endorser/execution/epr_lazy.go
new file mode 100644
index 0000000..e743caa
--- /dev/null
+++ b/endorser/execution/epr_lazy.go
@@ -0,0 +1,64 @@
+package execution
+
+// Lazy program tracing. The program tracer costs more than the delta tracer, and most transactions of
+// a delta-friendly contract never need a program. The endorser first executes with the delta tracer
+// only; if some storage write is not expressible as a guarded delta, it reverts to the snapshot and
+// re-executes with both tracers, and remembers the (contract, selector) so that later calls attach the
+// program tracer directly. The chosen encoding (deltas if every write is one, else a program) is the
+// same either way, so endorsers of different organizations still sign identical bytes.
+
+import (
+	"sync"
+
+	"github.com/ethereum/go-ethereum/core"
+)
+
+var eprProgFns sync.Map // [24]byte (to address | selector) -> struct{}
+
+func eprFnKey(msg *core.Message) ([24]byte, bool) {
+	var k [24]byte
+	if msg.To == nil || len(msg.Data) < 4 {
+		return k, false
+	}
+	copy(k[:20], msg.To[:])
+	copy(k[20:], msg.Data[:4])
+	return k, true
+}
+
+// eprNeedsProg reports whether calls to this contract function have needed a program before.
+func eprNeedsProg(msg *core.Message) bool {
+	k, ok := eprFnKey(msg)
+	if !ok {
+		return true
+	}
+	_, hit := eprProgFns.Load(k)
+	return hit
+}
+
+func eprNoteProg(msg *core.Message) {
+	if k, ok := eprFnKey(msg); ok {
+		eprProgFns.Store(k, struct{}{})
+	}
+}
+
+// AllDeltas reports whether every storage write of the traced execution extracts as a guarded delta.
+func (t *EPRTracer) AllDeltas() bool {
+	if t.lost {
+		return false
+	}
+	written := map[string]bool{}
+	for s, st := range t.slots {
+		if st.written {
+			written[s] = true
+		}
+	}
+	if t.gas.short {
+		return false
+	}
+	for s := range written {
+		if _, _, _, why := t.slots[s].extract(written, true); why != "" {
+			return false
+		}
+	}
+	return true
+}
diff --git a/endorser/execution/epr_prog_bench_test.go b/endorser/execution/epr_prog_bench_test.go
new file mode 100644
index 0000000..cf833c9
--- /dev/null
+++ b/endorser/execution/epr_prog_bench_test.go
@@ -0,0 +1,92 @@
+package execution
+
+// Committer-side cost of a guarded program: decoding the signed program of a swap through the DEX router
+// (contracts/D16Router.sol) on a Uniswap-V2-style pair and evaluating it on the latest values, measured in
+// memory (no Fabric-X, no I/O). The program is extracted once, before the timed loop; the benchmark also
+// reports the number of nodes and the encoded size of the program.
+//
+// D16_ROUTER_JSON=/path/to/contracts/D16Router.json \
+//   go test ./endorser/execution -run '^$' -bench BenchmarkEPRProgEval -benchtime 3000x
+
+import (
+	"encoding/json"
+	"math/big"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/accounts/abi"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/holiman/uint256"
+)
+
+// eprRouterBenchEnv deploys the router next to the pair of newEPRUniEnv, funds the user and returns the
+// calldata of one swap.
+func eprRouterBenchEnv(b *testing.B) (*eprUniEnv, common.Address, []byte) {
+	path := os.Getenv("D16_ROUTER_JSON")
+	if path == "" {
+		b.Skip("D16_ROUTER_JSON not set")
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		b.Fatal(err)
+	}
+	var art struct {
+		ABI json.RawMessage `json:"abi"`
+		Bin string          `json:"bin"`
+	}
+	if err := json.Unmarshal(raw, &art); err != nil {
+		b.Fatal(err)
+	}
+	rABI, _ := abi.JSON(strings.NewReader(string(art.ABI)))
+	e := newEPRUniEnv(&testing.T{})
+	_, router, _, err := e.evm(e.owner, nil).Create(e.owner, common.FromHex(art.Bin), vm.NewGasBudget(10_000_000), new(uint256.Int))
+	if err != nil {
+		b.Fatal(err)
+	}
+	if err := e.call(e.owner, e.t0, nil, e.erc, "transfer", e.user, big.NewInt(1_000_000_000_000)); err != nil {
+		b.Fatal(err)
+	}
+	if err := e.call(e.user, e.t0, nil, e.erc, "approve", router, new(big.Int).Lsh(big.NewInt(1), 200)); err != nil {
+		b.Fatal(err)
+	}
+	in, _ := rABI.Pack("swapExactIn", e.pair, e.t0, big.NewInt(1_000_000), big.NewInt(1))
+	return e, router, in
+}
+
+// BenchmarkEPRProgEval decodes and evaluates the signed program of a router swap on the latest values.
+func BenchmarkEPRProgEval(b *testing.B) {
+	e, r, in := eprRouterBenchEnv(b)
+	snap := e.sdb.Snapshot()
+	p := NewEPRProgTracer()
+	if _, _, err := e.evm(e.user, p.Hooks()).Call(e.user, r, in, vm.NewGasBudget(2_000_000), new(uint256.Int)); err != nil {
+		b.Fatal(err)
+	}
+	writes := map[string]bool{}
+	for s, w := range p.written {
+		if w {
+			writes[s] = true
+		}
+	}
+	enc := p.Program(writes).Encode()
+	e.sdb.RevertToSnapshot(snap)
+	q, _ := DecodeEPRProgram(enc)
+	vals := map[string][]byte{}
+	for _, k := range q.Keys {
+		vals[k] = e.getKey(k).Bytes()
+	}
+	b.ReportAllocs()
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		pp, ok := DecodeEPRProgram(enc)
+		if !ok {
+			b.Fatal("decode")
+		}
+		if _, ok := pp.Eval(func(k string) []byte { return vals[k] }); !ok {
+			b.Fatal("guards")
+		}
+	}
+	b.ReportMetric(float64(len(q.Nodes)), "nodes")
+	b.ReportMetric(float64(len(enc)), "prog_bytes")
+}
diff --git a/endorser/execution/epr_prog_callgas_test.go b/endorser/execution/epr_prog_callgas_test.go
new file mode 100644
index 0000000..4040df3
--- /dev/null
+++ b/endorser/execution/epr_prog_callgas_test.go
@@ -0,0 +1,130 @@
+package execution
+
+// A call whose gas operand is computed from a storage read gives the callee a different gas
+// allowance on another base, so the callee's GAS output may differ even though no SSTORE or EXP preceded it.
+// The program tracer must then treat GAS as a marker (gasDep), as it does after an SSTORE. The contract below
+// calls itself with gas = SLOAD(0); the callee either branches on GAS > 50000 (case "gasleft-branch") or
+// writes SLOAD(0)+1 without observing gas (case "no-gas-use"), and writes storage slot 1. Before the fix the
+// tracer saw an untainted GAS in the callee, so the branch carried no guard and the program wrote the
+// endorsed branch's constant on every base (wrong when slot 0 is small enough to flip the branch).
+// Extraction must either fall back (no program) or yield a program that matches the EVM on every perturbed
+// base on which its guards hold. The perturbed bases leave the callee enough gas, as A7 requires.
+
+import (
+	"math/big"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/holiman/uint256"
+)
+
+func TestEPRProgramCallGasFromStorage(t *testing.T) {
+	head := []byte{
+		0x36, 0x60, 0x15, 0x57, // CALLDATASIZE; PUSH1 sub; JUMPI
+		0x60, 0x00, 0x60, 0x00, 0x60, 0x01, 0x60, 0x00, 0x60, 0x00, 0x30, // retLen, retOff, argsLen=1, argsOff, value, self
+		0x60, 0x00, 0x54, 0xf1, // CALL(gas = SLOAD(0), ...)
+		0x50, 0x00, // POP; STOP
+		0x5b, // sub: JUMPDEST (0x15)
+	}
+	cases := []struct {
+		name        string
+		sub         []byte
+		needProgram bool
+	}{
+		{"gasleft-branch", []byte{
+			0x62, 0x00, 0xc3, 0x50, 0x5a, 0x11, 0x60, 0x25, 0x57, // PUSH3 50000; GAS; GT; PUSH1 hi; JUMPI
+			0x60, 0x02, 0x60, 0x01, 0x55, 0x00, // SSTORE(1, 2); STOP
+			0x5b, 0x60, 0x01, 0x60, 0x01, 0x55, 0x00, // hi (0x25): JUMPDEST; SSTORE(1, 1); STOP
+		}, false},
+		{"no-gas-use", []byte{
+			0x60, 0x01, 0x60, 0x00, 0x54, 0x01, 0x60, 0x01, 0x55, 0x00, // SSTORE(1, SLOAD(0) + 1); STOP
+		}, true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			runtime := append(append([]byte{}, head...), tc.sub...)
+			if runtime[0x15] != 0x5b || (tc.name == "gasleft-branch" && runtime[0x25] != 0x5b) {
+				t.Fatal("bad jump target")
+			}
+			initCode := append([]byte{0x60, byte(len(runtime)), 0x80, 0x60, 0x0b, 0x60, 0x00, 0x39, 0x60, 0x00, 0xf3}, runtime...)
+			sdb, err := state.New(common.Hash{}, state.NewDatabaseForTesting())
+			if err != nil {
+				t.Fatal(err)
+			}
+			e := &eprUniEnv{t: t, sdb: sdb, ctx: vm.BlockContext{
+				CanTransfer: core.CanTransfer, Transfer: core.Transfer,
+				BlockNumber: big.NewInt(30_000_000), Time: 1_800_000_000, GasLimit: 30_000_000,
+				Difficulty: big.NewInt(0), BaseFee: big.NewInt(0), Random: &common.Hash{},
+			}}
+			owner, user := common.BigToAddress(big.NewInt(0x0E0E)), common.BigToAddress(big.NewInt(0xA11CE))
+			_, c, _, err := e.evm(owner, nil).Create(owner, initCode, vm.NewGasBudget(1_000_000), new(uint256.Int))
+			if err != nil {
+				t.Fatal(err)
+			}
+			slot0, slot1 := storeKey(c, common.Hash{}), storeKey(c, common.BigToHash(big.NewInt(1)))
+			run := func(x int64, tr *EPRProgTracer) *big.Int {
+				snap := e.sdb.Snapshot()
+				defer e.sdb.RevertToSnapshot(snap)
+				e.setKey(slot0, big.NewInt(x))
+				evm := e.evm(user, nil)
+				if tr != nil {
+					evm = e.evm(user, tr.Hooks())
+				}
+				if _, _, err := evm.Call(user, c, nil, vm.NewGasBudget(2_000_000), new(uint256.Int)); err != nil {
+					t.Fatalf("call: %v", err)
+				}
+				return e.getKey(slot1)
+			}
+			if tc.name == "gasleft-branch" { // the EVM's write depends on the callee's gas
+				if a, b := run(100_000, nil), run(30_000, nil); a.Int64() != 1 || b.Int64() != 2 {
+					t.Fatalf("contract does not branch on gas: %v %v", a, b)
+				}
+			}
+
+			tr := NewEPRProgTracer()
+			run(100_000, tr) // endorsed base: slot 0 = 100000
+			writes := map[string]bool{}
+			for s, w := range tr.written {
+				if w {
+					writes[s] = true
+				}
+			}
+			p := tr.Program(writes)
+			if p == nil {
+				if tc.needProgram {
+					t.Fatalf("no program although the callee does not observe gas (lostAt=%q)", tr.lostAt)
+				}
+				t.Logf("no program: falls back to plain writes (lostAt=%q)", tr.lostAt)
+				return
+			}
+			q, ok := DecodeEPRProgram(p.Encode())
+			if !ok {
+				t.Fatal("program does not round-trip")
+			}
+			held := 0
+			for _, x := range []int64{100_000, 1_000_000, 60_000, 50_100, 49_000, 30_000, 25_000} {
+				want := run(x, nil)
+				out, ok := q.Eval(func(k string) []byte {
+					if k == slot0 {
+						return big.NewInt(x).Bytes()
+					}
+					return nil
+				})
+				if !ok {
+					continue // guards fail: the committer keeps the plain path
+				}
+				held++
+				if got := new(big.Int).SetBytes(out[slot1]); got.Cmp(want) != 0 {
+					t.Fatalf("slot0=%d: program writes %v to slot 1, the EVM writes %v", x, got, want)
+				}
+			}
+			if tc.needProgram && held == 0 {
+				t.Fatal("guards fail on every base")
+			}
+			t.Logf("program: nodes=%d guards=%d, guards hold and outputs equal on %d bases", len(p.Nodes), len(p.Guards), held)
+		})
+	}
+}
diff --git a/endorser/execution/epr_prog_det_test.go b/endorser/execution/epr_prog_det_test.go
new file mode 100644
index 0000000..236caca
--- /dev/null
+++ b/endorser/execution/epr_prog_det_test.go
@@ -0,0 +1,78 @@
+package execution
+
+import (
+	"bytes"
+	"encoding/json"
+	"math/big"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/accounts/abi"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/holiman/uint256"
+)
+
+// TestEPRProgramDeterministicEncoding: endorsers of different organizations must sign identical bytes.
+// Trace the same router swap from the same state many times (Go randomizes map iteration on every
+// range) and require byte-identical encodings.
+func TestEPRProgramDeterministicEncoding(t *testing.T) {
+	path := os.Getenv("D16_ROUTER_JSON")
+	if path == "" {
+		t.Skip("D16_ROUTER_JSON not set")
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var art struct {
+		ABI json.RawMessage `json:"abi"`
+		Bin string          `json:"bin"`
+	}
+	if err := json.Unmarshal(raw, &art); err != nil {
+		t.Fatal(err)
+	}
+	rABI, _ := abi.JSON(strings.NewReader(string(art.ABI)))
+	e := newEPRUniEnv(t)
+	_, router, _, err := e.evm(e.owner, nil).Create(e.owner, common.FromHex(art.Bin), vm.NewGasBudget(10_000_000), new(uint256.Int))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tok := range []common.Address{e.t0, e.t1} {
+		if err := e.call(e.owner, tok, nil, e.erc, "transfer", e.user, big.NewInt(1_000_000_000)); err != nil {
+			t.Fatal(err)
+		}
+		if err := e.call(e.user, tok, nil, e.erc, "approve", router, new(big.Int).Lsh(big.NewInt(1), 200)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, tokenIn := range []common.Address{e.t0, e.t1} {
+		var first []byte
+		for i := 0; i < 50; i++ {
+			snap := e.sdb.Snapshot()
+			tr := NewEPRProgTracer()
+			if err := e.call(e.user, router, tr.Hooks(), rABI, "swapExactIn", e.pair, tokenIn, big.NewInt(1_000_000), big.NewInt(1)); err != nil {
+				t.Fatalf("router swap: %v", err)
+			}
+			writes := map[string]bool{}
+			for s, w := range tr.written {
+				if w {
+					writes[s] = true
+				}
+			}
+			p := tr.Program(writes)
+			e.sdb.RevertToSnapshot(snap)
+			if p == nil {
+				t.Fatalf("no program (lostAt=%q)", tr.lostAt)
+			}
+			enc := p.Encode()
+			if i == 0 {
+				first = enc
+			} else if !bytes.Equal(first, enc) {
+				t.Fatalf("tokenIn=%s run %d: encoding differs (%d vs %d bytes)", tokenIn.Hex(), i, len(first), len(enc))
+			}
+		}
+		t.Logf("tokenIn=%s: 50 traces, identical %d-byte encodings", tokenIn.Hex(), len(first))
+	}
+}
diff --git a/endorser/execution/epr_prog_tracer.go b/endorser/execution/epr_prog_tracer.go
new file mode 100644
index 0000000..b83dd2b
--- /dev/null
+++ b/endorser/execution/epr_prog_tracer.go
@@ -0,0 +1,1050 @@
+package execution
+
+// Program tracer for generalised endorsement-preserving repair (see eprprog_core.go).
+//
+// The tracer shadows every EVM stack word, memory word (32-byte, by exact offset), call-data word and
+// return-data word with an expression node when the value depends on a storage read of this transaction,
+// across call frames. It records a guard whenever such a value influences execution:
+//   - JUMPI condition (truthiness) and JUMP target (equality);
+//   - storage keys, memory offsets/sizes, call targets/values, BALANCE/EXTCODE* addresses (equality);
+//   - KECCAK256 and precompile inputs (equality of the input words, so the output is unchanged).
+// Under all guards the opcode sequence, every address and every untainted value are those of the endorsed
+// run, and every tainted value is the node's evaluation (EVM semantics replayed exactly), so the storage
+// writes are the program outputs. Gas: remaining gas may differ on a different base (SSTORE pricing, EXP
+// with a tainted exponent, or a call whose gas operand is tainted, which changes the callee's gas); from the
+// first such opcode on, GAS yields a marker that may only feed call gas limits, unchanged or plus or minus
+// a constant; extraction requires headroom (the per-opcode gas rule of epr_gas.go).
+// Log data derived from repaired values is not recomputed; the committed state does not depend on it.
+// Anything outside the supported fragment (partially overlapping tainted memory, unknown opcodes, shadow
+// stack mismatch) marks the run lost: the transaction keeps its plain writes and ordinary MVCC.
+//
+// Enabled with FX_EPR_PROG=1 in the endorser (together with FX_EPR_EVM=1).
+
+import (
+	"fmt"
+	"math/big"
+	"os"
+	"sort"
+	"sync/atomic"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/holiman/uint256"
+	"github.com/hyperledger/fabric-x-sdk/blocks"
+)
+
+// EPRProgEnabled turns on program extraction for transactions that guarded deltas cannot express.
+var EPRProgEnabled = os.Getenv("FX_EPR_PROG") == "1"
+
+var eprProgTxs, eprProgLost, eprProgUsed atomic.Int64
+
+// EPRProgStats reports program-traced transactions, those where tracking was lost, and programs emitted.
+func EPRProgStats() (txs, lost, used int64) {
+	return eprProgTxs.Load(), eprProgLost.Load(), eprProgUsed.Load()
+}
+
+type eprPNode struct {
+	op      byte
+	a, b, c *eprPNode
+	key     string
+	val     *big.Int // concrete endorsement-time value
+	idx     int32
+	gas     bool // remaining gas, plus or minus constants: it may only set a call's gas
+}
+
+type eprPGuard struct {
+	n    *eprPNode
+	kind byte
+	want *big.Int
+}
+
+type eprPMem map[uint64]*eprPNode // tainted 32-byte words by exact offset
+
+type eprPFrame struct {
+	stack    []*eprPNode
+	mem      eprPMem
+	poison   map[uint64]bool // bytes of partially overwritten tainted words (reading them is lost)
+	calldata eprPMem
+	retdata  eprPMem // return data of the last completed sub-call
+	pend     struct {
+		active bool
+		base   int
+		out    *eprPNode
+		sload  string
+	}
+	// sub-call bookkeeping
+	callRetOff, callRetLen uint64
+	applyRet               bool
+	retLabels              eprPMem // labels of this frame's RETURN/REVERT region
+	journalMark            int
+	tjournalMark           int
+}
+
+type eprPJournal struct {
+	slot     string
+	prev     *eprPNode
+	prevVal  *big.Int
+	prevWrit bool
+}
+
+// eprPTJournal is a transient-storage write, undone like a storage write when its frame reverts.
+type eprPTJournal struct {
+	key  string
+	prev *eprPNode
+	had  bool
+}
+
+// EPRProgTracer builds a guarded straight-line program for one transaction. Not safe for concurrent use.
+type EPRProgTracer struct {
+	frames    []*eprPFrame // by OnOpcode depth (1 = top level)
+	last      int
+	vars      map[string]*eprPNode
+	cur       map[string]*eprPNode // expression of the current value of written slots (nil: constant)
+	curVal    map[string]*big.Int  // concrete current value of written slots
+	written   map[string]bool
+	journal   []eprPJournal
+	transient map[string]*eprPNode
+	tjournal  []eprPTJournal
+	guards    []eprPGuard
+	nextCall  eprPMem // calldata labels for the frame about to be entered
+	keys      map[[52]byte]string
+	lost      bool
+	lostAt    string // diagnostics: opcode and reason where tracking was lost
+	gasDep    bool   // remaining gas may differ on another base (SSTORE, EXP with a tainted exponent, tainted call gas)
+	GasLeft   uint64 // kept for callers; the headroom decision is gasRule (epr_gas.go)
+	gasRule   eprGasRule
+}
+
+// NewEPRProgTracer returns a fresh program tracer for one transaction.
+func NewEPRProgTracer() *EPRProgTracer {
+	return &EPRProgTracer{vars: map[string]*eprPNode{}, cur: map[string]*eprPNode{}, curVal: map[string]*big.Int{},
+		written: map[string]bool{}, transient: map[string]*eprPNode{}}
+}
+
+func (t *EPRProgTracer) frame(d int) *eprPFrame {
+	for len(t.frames) <= d {
+		t.frames = append(t.frames, nil)
+	}
+	if t.frames[d] == nil {
+		t.frames[d] = &eprPFrame{mem: eprPMem{}, calldata: eprPMem{}, retdata: eprPMem{}}
+	}
+	return t.frames[d]
+}
+
+// OnEnter: a new frame at OnOpcode depth d+1 starts with the call-data labels prepared by the caller.
+func (t *EPRProgTracer) onEnter(depth int, typ byte, from, to common.Address, input []byte, gas uint64, value *big.Int) {
+	if t.lost {
+		return
+	}
+	f := &eprPFrame{mem: eprPMem{}, calldata: t.nextCall, retdata: eprPMem{}, journalMark: len(t.journal),
+		tjournalMark: len(t.tjournal)}
+	if f.calldata == nil {
+		f.calldata = eprPMem{}
+	}
+	t.nextCall = nil
+	for len(t.frames) <= depth+1 {
+		t.frames = append(t.frames, nil)
+	}
+	t.frames[depth+1] = f
+}
+
+// OnExit: the frame at OnOpcode depth d+1 ends; a reverted frame's storage and transient-storage writes are
+// rolled back and its RETURN/REVERT labels become the caller's return data (applied at the caller's next
+// opcode).
+func (t *EPRProgTracer) onExit(depth int, output []byte, gasUsed uint64, err error, reverted bool) {
+	t.gasRule.exit(depth, err) // A frame that halts for lack of gas breaks the gas rule
+	if t.lost || depth+1 >= len(t.frames) || t.frames[depth+1] == nil {
+		return
+	}
+	f := t.frames[depth+1]
+	if reverted {
+		for i := len(t.journal) - 1; i >= f.journalMark; i-- {
+			j := t.journal[i]
+			if j.prevWrit {
+				t.cur[j.slot], t.curVal[j.slot] = j.prev, j.prevVal
+			} else {
+				delete(t.cur, j.slot)
+				delete(t.curVal, j.slot)
+			}
+			t.written[j.slot] = j.prevWrit
+		}
+		t.journal = t.journal[:f.journalMark]
+		for i := len(t.tjournal) - 1; i >= f.tjournalMark; i-- {
+			j := t.tjournal[i]
+			if j.had {
+				t.transient[j.key] = j.prev
+			} else {
+				delete(t.transient, j.key)
+			}
+		}
+		t.tjournal = t.tjournal[:f.tjournalMark]
+	}
+	ret := f.retLabels
+	if ret == nil {
+		ret = eprPMem{}
+	}
+	t.frames[depth+1] = nil
+	if depth >= 1 && depth < len(t.frames) && t.frames[depth] != nil {
+		p := t.frames[depth]
+		p.retdata = ret
+		p.applyRet = true
+	}
+}
+
+// Hooks returns the tracing hooks of the program tracer.
+func (t *EPRProgTracer) Hooks() *tracing.Hooks {
+	return &tracing.Hooks{OnOpcode: t.onOpcode, OnEnter: t.onEnter, OnExit: t.onExit}
+}
+
+func (t *EPRProgTracer) node(op byte, a, b, c *eprPNode, val *big.Int) *eprPNode {
+	for _, x := range []*eprPNode{a, b, c} {
+		if x != nil && x.gas { // never reached (markers cannot enter memory or operator nodes); kept as a check
+			t.lose(op, 0, 0, 94)
+		}
+	}
+	return &eprPNode{op: op, a: a, b: b, c: c, val: val, idx: -1}
+}
+
+func (t *EPRProgTracer) constNode(v *big.Int) *eprPNode {
+	return &eprPNode{op: EPROpConst, val: new(big.Int).Set(v), idx: -1}
+}
+
+// guardEq records that a tainted value must equal its endorsed value.
+func (t *EPRProgTracer) guardEq(n *eprPNode) {
+	if n != nil && n.gas {
+		t.lose(0x5a, 0, 0, 91) // remaining gas may differ on another base: it may not steer execution
+		return
+	}
+	if n != nil {
+		t.guards = append(t.guards, eprPGuard{n: n, kind: 0, want: n.val})
+	}
+}
+
+func (t *EPRProgTracer) slotKey(addr common.Address, slot *uint256.Int) string {
+	var k [52]byte
+	copy(k[:20], addr[:])
+	h := slot.Bytes32()
+	copy(k[20:], h[:])
+	if s, ok := t.keys[k]; ok {
+		return s
+	}
+	s := storeKey(addr, common.Hash(h))
+	if t.keys == nil {
+		t.keys = map[[52]byte]string{}
+	}
+	t.keys[k] = s
+	return s
+}
+
+// region helpers: tainted words fully inside [off, off+n); partial overlap with a tainted word is lost.
+func (t *EPRProgTracer) regionWords(m eprPMem, off, n uint64) (map[uint64]*eprPNode, bool) {
+	if len(m) == 0 || n == 0 {
+		return nil, true
+	}
+	out := map[uint64]*eprPNode{}
+	for k, v := range m {
+		if k+32 <= off || k >= off+n {
+			continue
+		}
+		if k < off || k+32 > off+n {
+			return nil, false
+		}
+		out[k-off] = v
+	}
+	return out, true
+}
+
+// clearRegion removes tainted words inside [off, off+n); a partial overlap is lost.
+func (t *EPRProgTracer) clearRegion(m eprPMem, off, n uint64) bool {
+	if len(m) == 0 || n == 0 {
+		return true
+	}
+	for k := range m {
+		if k+32 <= off || k >= off+n {
+			continue
+		}
+		if k < off || k+32 > off+n {
+			return false
+		}
+		delete(m, k)
+	}
+	return true
+}
+
+// clearMem prepares [off, off+n) of a frame's memory for a write: tainted words inside are dropped; a
+// tainted word only partially overwritten is dropped and its remaining bytes are poisoned (Solidity reuses
+// memory with shifted ABI layouts; the old bytes are normally never read again). Poison inside the written
+// range is cleared.
+func (t *EPRProgTracer) clearMem(f *eprPFrame, off, n uint64) {
+	if n == 0 {
+		return
+	}
+	for k := range f.mem {
+		if k+32 <= off || k >= off+n {
+			continue
+		}
+		if k < off || k+32 > off+n {
+			if f.poison == nil {
+				f.poison = map[uint64]bool{}
+			}
+			for b := k; b < k+32; b++ {
+				if b < off || b >= off+n {
+					f.poison[b] = true
+				}
+			}
+		}
+		delete(f.mem, k)
+	}
+	for b := range f.poison {
+		if b >= off && b < off+n {
+			delete(f.poison, b)
+		}
+	}
+}
+
+// readMem returns the tainted words fully inside [off, off+n); a partial tainted word or a poisoned byte
+// in the range cannot be represented (lost).
+func (t *EPRProgTracer) readMem(f *eprPFrame, off, n uint64) (map[uint64]*eprPNode, bool) {
+	if t.poisoned(f, off, n) {
+		return nil, false
+	}
+	return t.regionWords(f.mem, off, n)
+}
+
+// callInput returns the tainted words of a call input [off, off+n) relative to off, when the only obstacle to
+// readMem is a tainted word that straddles the end of the input: the callee's call data then holds the word's
+// leading bytes inside the input followed by zeros (the EVM pads call data), which is the word AND a constant
+// mask keeping those bytes. A word straddling the start of the input, or poisoned bytes, still cannot be
+// represented (false).
+func (t *EPRProgTracer) callInput(f *eprPFrame, off, n uint64) (map[uint64]*eprPNode, bool) {
+	if t.poisoned(f, off, n) {
+		return nil, false
+	}
+	out := map[uint64]*eprPNode{}
+	for _, k := range memKeys(f.mem) {
+		v := f.mem[k]
+		if k+32 <= off || k >= off+n {
+			continue
+		}
+		if k < off {
+			return nil, false
+		}
+		if k+32 <= off+n {
+			out[k-off] = v
+			continue
+		}
+		keep := off + n - k // bytes of the word inside the input, 1..31
+		low := new(big.Int).Sub(new(big.Int).Lsh(big.NewInt(1), uint(8*(32-keep))), big.NewInt(1))
+		mask := new(big.Int).Sub(new(big.Int).Lsh(big.NewInt(1), 256), big.NewInt(1))
+		mask.Xor(mask, low)
+		mv, _ := EPREvalOp(0x16, v.val, mask, nil)
+		out[k-off] = t.node(0x16, v, t.constNode(mask), nil, mv)
+	}
+	return out, true
+}
+
+func (t *EPRProgTracer) poisoned(f *eprPFrame, off, n uint64) bool {
+	for b := range f.poison {
+		if b >= off && b < off+n {
+			return true
+		}
+	}
+	return false
+}
+
+// composeWord returns the expression of the 32-byte word loaded at off from a shadowed byte area (memory
+// or call data) whose tainted words only partially overlap the window (nil if none overlaps): the
+// untainted bytes are a constant taken from the concrete area, each overlapping tainted word contributes
+// its bytes shifted into place, and the parts are OR-ed. The concrete-value check at the next opcode
+// cross-checks the composition against the EVM.
+func (t *EPRProgTracer) composeWord(m eprPMem, off uint64, area []byte) *eprPNode {
+	var window [32]byte
+	for i := uint64(0); i < 32; i++ {
+		if off+i < uint64(len(area)) {
+			window[i] = area[off+i]
+		}
+	}
+	var acc *eprPNode
+	constPart := new(big.Int)
+	for _, k := range memKeys(m) {
+		v := m[k]
+		if k+32 <= off || k >= off+32 {
+			continue
+		}
+		var part *eprPNode
+		if k >= off { // tainted word starts inside the window: its top bytes fill [k-off, 32)
+			d := k - off
+			for i := d; i < 32; i++ {
+				window[i] = 0
+			}
+			sh := big.NewInt(int64(8 * d))
+			pv, _ := EPREvalOp(0x1c, sh, v.val, nil)
+			part = t.node(0x1c, t.constNode(sh), v, nil, pv)
+		} else { // tainted word starts before the window: its low bytes fill [0, 32-(off-k))
+			d := off - k
+			for i := uint64(0); i < 32-d; i++ {
+				window[i] = 0
+			}
+			sh := big.NewInt(int64(8 * d))
+			pv, _ := EPREvalOp(0x1b, sh, v.val, nil)
+			part = t.node(0x1b, t.constNode(sh), v, nil, pv)
+		}
+		if acc == nil {
+			acc = part
+		} else {
+			av, _ := EPREvalOp(0x17, acc.val, part.val, nil)
+			acc = t.node(0x17, acc, part, nil, av)
+		}
+	}
+	if acc == nil {
+		return nil
+	}
+	constPart.SetBytes(window[:])
+	if constPart.Sign() == 0 {
+		return acc
+	}
+	v, _ := EPREvalOp(0x17, acc.val, constPart, nil)
+	return t.node(0x17, acc, t.constNode(constPart), nil, v)
+}
+
+func (t *EPRProgTracer) copyInto(dst eprPMem, dstOff uint64, words map[uint64]*eprPNode) {
+	for rel, v := range words {
+		dst[dstOff+rel] = v
+	}
+}
+
+// eprIO reused from the delta tracer: [inputs, outputs] per opcode.
+
+func (t *EPRProgTracer) onOpcode(pc uint64, op byte, gas, cost uint64, scope tracing.OpContext, rData []byte, depth int, err error) {
+	t.gasRule.step(pc, op, gas, cost, depth, true, err != nil)
+	if t.lost {
+		return
+	}
+	stack := scope.StackData()
+	n := len(stack)
+	f := t.frame(depth)
+	if depth < t.last {
+		for x := depth + 1; x <= t.last && x < len(t.frames); x++ {
+			t.frames[x] = nil
+		}
+	}
+	t.last = depth
+	S := f.stack
+	if p := &f.pend; p.active {
+		pushes := n - p.base
+		if pushes < 0 {
+			t.lose(op, pc, depth, 1)
+			return
+		}
+		for i := 0; i < pushes; i++ {
+			var l *eprPNode
+			if i == 0 {
+				l = p.out
+			}
+			S = append(S, l)
+		}
+		if p.sload != "" && n > 0 {
+			v := stack[n-1].ToBig()
+			if vn := t.vars[p.sload]; vn != nil && vn.val == nil {
+				vn.val = v
+			}
+		}
+		if p.out != nil && p.out.gas && p.out.val == nil && n > 0 { // GAS: its value is the pushed word
+			p.out.val = stack[n-1].ToBig()
+		}
+		if p.out != nil && p.out.op != EPROpVar && n > 0 && p.out.val.Cmp(stack[n-1].ToBig()) != 0 {
+			t.lose(op, pc, depth, 2) // evaluator disagrees with the EVM: never emit a program from this run
+			return
+		}
+		p.active, p.out, p.sload = false, nil, ""
+	}
+	if len(S) != n {
+		t.lose(op, pc, depth, 3)
+		return
+	}
+	if f.applyRet { // a sub-call just returned: its return-data labels land in [retOff, retOff+retLen)
+		f.applyRet = false
+		t.clearMem(f, f.callRetOff, f.callRetLen)
+		words, ok := t.regionWords(f.retdata, 0, f.callRetLen)
+		if !ok {
+			t.lose(op, pc, depth, 5)
+			return
+		}
+		t.copyInto(f.mem, f.callRetOff, words)
+	}
+	f.stack = S
+	top := func(i int) *uint256.Int { return &stack[n-1-i] }
+	u64 := func(i int) uint64 {
+		v := top(i)
+		if !v.IsUint64() {
+			return 1 << 62
+		}
+		return v.Uint64()
+	}
+	setPend := func(out *eprPNode, sload string) {
+		f.pend.active, f.pend.base, f.pend.out, f.pend.sload = true, len(f.stack), out, sload
+	}
+	gasOut := func(l *eprPNode) bool { // a gas-derived value stored or branched on: never emit a program
+		if l != nil && l.gas {
+			t.lose(op, pc, depth, 91)
+			return true
+		}
+		return false
+	}
+
+	switch {
+	case op >= 0x80 && op <= 0x8f:
+		k := int(op-0x80) + 1
+		f.pend.active, f.pend.base, f.pend.out = true, n, S[n-k]
+		return
+	case op >= 0x90 && op <= 0x9f:
+		k := int(op-0x90) + 1
+		S[n-1], S[n-1-k] = S[n-1-k], S[n-1]
+		f.pend.active, f.pend.base, f.pend.out = true, n, nil
+		return
+	case op >= 0x60 && op <= 0x7f:
+		f.pend.active, f.pend.base, f.pend.out = true, n, nil
+		return
+	}
+	if !eprIOKnown[op] || eprIOArr[op][0] > n {
+		t.lose(op, pc, depth, 6)
+		return
+	}
+	io := eprIOArr[op]
+	var insBuf [7]*eprPNode
+	ins := insBuf[:io[0]]
+	tainted := false
+	for j := 0; j < io[0]; j++ {
+		ins[j] = S[n-1-j]
+		tainted = tainted || ins[j] != nil
+	}
+	f.stack = S[:n-io[0]]
+	addr := scope.Address()
+
+	switch op {
+	case 0x54: // SLOAD
+		t.guardEq(ins[0])
+		s := t.slotKey(addr, top(0))
+		if t.written[s] {
+			out := t.cur[s]
+			if out == nil {
+				out = nil // constant current value: untainted
+			}
+			setPend(out, "")
+			return
+		}
+		v := t.vars[s]
+		if v == nil {
+			v = &eprPNode{op: EPROpVar, key: s, idx: -1}
+			t.vars[s] = v
+			setPend(v, s)
+			return
+		}
+		setPend(v, "")
+		return
+	case 0x55: // SSTORE
+		t.guardEq(ins[0])
+		if gasOut(ins[1]) {
+			return
+		}
+		t.gasDep = true // the cost depends on the slot's original and current values
+		s := t.slotKey(addr, top(0))
+		t.journal = append(t.journal, eprPJournal{slot: s, prev: t.cur[s], prevVal: t.curVal[s], prevWrit: t.written[s]})
+		t.cur[s] = ins[1]
+		t.curVal[s] = top(1).ToBig()
+		t.written[s] = true
+		setPend(nil, "")
+		return
+	case 0x5c: // TLOAD
+		t.guardEq(ins[0])
+		setPend(t.transient[addr.Hex()+top(0).Hex()], "")
+		return
+	case 0x5d: // TSTORE
+		t.guardEq(ins[0])
+		if gasOut(ins[1]) {
+			return
+		}
+		k := addr.Hex() + top(0).Hex()
+		prev, had := t.transient[k]
+		t.tjournal = append(t.tjournal, eprPTJournal{key: k, prev: prev, had: had})
+		t.transient[k] = ins[1]
+		setPend(nil, "")
+		return
+	case 0x56: // JUMP
+		t.guardEq(ins[0])
+		setPend(nil, "")
+		return
+	case 0x57: // JUMPI
+		t.guardEq(ins[0])
+		if gasOut(ins[1]) {
+			return
+		}
+		if ins[1] != nil {
+			t.guards = append(t.guards, eprPGuard{n: ins[1], kind: 1, want: ins[1].val})
+		}
+		setPend(nil, "")
+		return
+	case 0x51: // MLOAD
+		t.guardEq(ins[0])
+		off := u64(0)
+		if v, ok := f.mem[off]; ok {
+			setPend(v, "")
+			return
+		}
+		if t.poisoned(f, off, 32) {
+			t.lose(op, pc, depth, 7)
+			return
+		}
+		setPend(t.composeWord(f.mem, off, scope.MemoryData()), "")
+		return
+	case 0x52: // MSTORE
+		t.guardEq(ins[0])
+		if gasOut(ins[1]) {
+			return
+		}
+		off := u64(0)
+		t.clearMem(f, off, 32)
+		if ins[1] != nil {
+			f.mem[off] = ins[1]
+		} else {
+			delete(f.mem, off)
+		}
+		setPend(nil, "")
+		return
+	case 0x53: // MSTORE8
+		t.guardEq(ins[0])
+		if ins[1] != nil {
+			t.lose(op, pc, depth, 9)
+			return
+		}
+		t.clearMem(f, u64(0), 1)
+		setPend(nil, "")
+		return
+	case 0x35: // CALLDATALOAD
+		t.guardEq(ins[0])
+		off := u64(0)
+		if v, ok := f.calldata[off]; ok {
+			setPend(v, "")
+			return
+		}
+		setPend(t.composeWord(f.calldata, off, scope.CallInput()), "")
+		return
+	case 0x37, 0x3e, 0x39, 0x5e: // CALLDATACOPY, RETURNDATACOPY, CODECOPY, MCOPY (dst, src, len)
+		for _, l := range ins {
+			t.guardEq(l)
+		}
+		dst, src, ln := u64(0), u64(1), u64(2)
+		var srcMem eprPMem
+		switch op {
+		case 0x37:
+			srcMem = f.calldata
+		case 0x3e:
+			srcMem = f.retdata
+		case 0x5e:
+			srcMem = f.mem
+		}
+		var words map[uint64]*eprPNode
+		ok := true
+		if op == 0x5e {
+			words, ok = t.readMem(f, src, ln)
+		} else if srcMem != nil {
+			words, ok = t.regionWords(srcMem, src, ln)
+		}
+		if ok {
+			t.clearMem(f, dst, ln)
+		}
+		if !ok {
+			t.lose(op, pc, depth, 12)
+			return
+		}
+		t.copyInto(f.mem, dst, words)
+		setPend(nil, "")
+		return
+	case 0x3c: // EXTCODECOPY(addr, dst, src, len)
+		for _, l := range ins {
+			t.guardEq(l)
+		}
+		t.clearMem(f, u64(1), u64(3))
+		setPend(nil, "")
+		return
+	case 0x20: // KECCAK256(off, len): the hash is unchanged if its tainted input words are
+		t.guardEq(ins[0])
+		t.guardEq(ins[1])
+		off, ln := u64(0), u64(1)
+		if t.poisoned(f, off, ln) {
+			t.lose(op, pc, depth, 90)
+			return
+		}
+		for _, k := range memKeys(f.mem) { // sorted: every endorser appends the guards in the same order
+			if k+32 > off && k < off+ln {
+				t.guardEq(f.mem[k])
+			}
+		}
+		setPend(nil, "")
+		return
+	case 0xa0, 0xa1, 0xa2, 0xa3, 0xa4: // LOG: offsets guarded; data/topics may stay tainted (see header)
+		t.guardEq(ins[0])
+		t.guardEq(ins[1])
+		setPend(nil, "")
+		return
+	case 0xf3, 0xfd: // RETURN, REVERT
+		t.guardEq(ins[0])
+		t.guardEq(ins[1])
+		words, ok := t.readMem(f, u64(0), u64(1))
+		if !ok {
+			t.lose(op, pc, depth, 14)
+			return
+		}
+		f.retLabels = eprPMem(words)
+		setPend(nil, "")
+		return
+	case 0xf1, 0xf2, 0xf4, 0xfa: // CALL, CALLCODE, DELEGATECALL, STATICCALL
+		// operands: gas, addr, [value], argsOff, argsLen, retOff, retLen. A gas operand computed from storage
+		// reads is guarded: the gas rule of epr_gas.go bounds how much a callee's allowance can shrink
+		// only if the operand is a constant, the GAS marker or fixed. From here on GAS is a marker, as after an
+		// SSTORE (a marker operand implies gasDep already).
+		if ins[0] != nil {
+			if !ins[0].gas {
+				t.guardEq(ins[0])
+			}
+			t.gasDep = true
+		}
+		t.guardEq(ins[1])
+		i := 2
+		if op == 0xf1 || op == 0xf2 {
+			t.guardEq(ins[2])
+			i = 3
+		}
+		for _, l := range ins[i:] {
+			t.guardEq(l)
+		}
+		argsOff, argsLen, retOff, retLen := u64(i), u64(i+1), u64(i+2), u64(i+3)
+		words, ok := t.readMem(f, argsOff, argsLen)
+		if !ok { // a tainted word may straddle the end of the input (ABI encodings ending inside a word)
+			words, ok = t.callInput(f, argsOff, argsLen)
+		}
+		if !ok {
+			t.lose(op, pc, depth, 15)
+			return
+		}
+		to := common.Address(top(1).Bytes20())
+		if eprIsPrecompile(to) {
+			for _, k := range memKeys(words) {
+				t.guardEq(words[k]) // the precompile output is unchanged if its tainted inputs are
+			}
+			t.nextCall = eprPMem{}
+		} else {
+			t.nextCall = eprPMem(words)
+		}
+		f.callRetOff, f.callRetLen = retOff, retLen
+		setPend(nil, "")
+		return
+	case 0xf0, 0xf5: // CREATE, CREATE2: guard everything feeding the init code
+		for _, l := range ins {
+			t.guardEq(l)
+		}
+		off, ln := u64(1), u64(2)
+		if t.poisoned(f, off, ln) { // init code bytes left over from a partially overwritten word (as MLOAD)
+			t.lose(op, pc, depth, 95)
+			return
+		}
+		for _, k := range memKeys(f.mem) { // sorted: every endorser appends the guards in the same order
+			if k+32 > off && k < off+ln {
+				t.guardEq(f.mem[k])
+			}
+		}
+		t.nextCall = eprPMem{}
+		f.callRetOff, f.callRetLen = 0, 0
+		setPend(nil, "")
+		return
+	case 0x31, 0x3b, 0x3f, 0x40, 0xff: // BALANCE, EXTCODESIZE, EXTCODEHASH, BLOCKHASH, SELFDESTRUCT
+		for _, l := range ins {
+			t.guardEq(l)
+		}
+		setPend(nil, "")
+		return
+	case 0x50: // POP
+		setPend(nil, "")
+		return
+	case 0x5a: // GAS: after a value-dependent cost the remaining gas is a marker, allowed only as call gas
+		if t.gasDep {
+			setPend(&eprPNode{op: EPROpConst, idx: -1, gas: true}, "")
+			return
+		}
+		setPend(nil, "")
+		return
+	}
+	if !tainted || io[1] == 0 {
+		for _, l := range ins { // e.g. tainted input of an opcode without outputs: keep it observable
+			t.guardEq(l)
+		}
+		setPend(nil, "")
+		return
+	}
+	if !EPRPureOp(op) {
+		for _, l := range ins {
+			t.guardEq(l)
+		}
+		setPend(nil, "")
+		return
+	}
+	if op == 0x0a && ins[1] != nil { // EXP: the cost depends on the exponent's byte length
+		t.gasDep = true
+	}
+	gasIn, otherIn := false, false
+	for _, l := range ins {
+		gasIn = gasIn || (l != nil && l.gas)
+		otherIn = otherIn || (l != nil && !l.gas)
+	}
+	if gasIn { // a marker combined with storage values is lost
+		if otherIn {
+			t.lose(op, pc, depth, 92)
+			return
+		}
+		// a marker stays a marker only as the remaining gas plus or
+		// minus a constant, without wrapping around on the endorsed run. On another base such a call gas
+		// operand is lower by at most the extra cost paid so far, or it wraps around to more than any
+		// allowance; either way the callee's allowance shrinks by at most that extra cost (epr_gas.go). Any
+		// other operator (AND, MUL, DIV, a second marker, a constant minus the marker, ...) can turn a small
+		// difference into a large one, so the program is lost.
+		ok := false
+		switch op {
+		case 0x01: // ADD: the marker plus a constant below 2^64 (the sum never wraps around), or minus one, as
+			// compilers encode a subtraction (adding 2^256 - k), with k not above the marker
+			if (ins[0] == nil) != (ins[1] == nil) {
+				m, c := top(0), top(1)
+				if ins[0] == nil {
+					m, c = top(1), top(0)
+				}
+				k := new(uint256.Int).Neg(c)
+				ok = c.BitLen() <= 64 || (k.BitLen() <= 64 && !m.Lt(k))
+			}
+		case 0x03: // SUB: the marker minus a constant that does not exceed it
+			ok = ins[0] != nil && ins[1] == nil && !top(0).Lt(top(1))
+		}
+		if !ok {
+			t.lose(op, pc, depth, 93)
+			return
+		}
+		v, _ := EPREvalOp(op, top(0).ToBig(), top(1).ToBig(), new(big.Int))
+		setPend(&eprPNode{op: EPROpConst, val: v, idx: -1, gas: true}, "")
+		return
+	}
+	// pure operator with a tainted operand: build a node, its concrete value replays the EVM
+	var args [3]*eprPNode
+	var vals [3]*big.Int
+	for j := 0; j < 3; j++ {
+		vals[j] = new(big.Int)
+		if j < len(ins) {
+			vals[j] = top(j).ToBig()
+			if ins[j] != nil {
+				args[j] = ins[j]
+			} else {
+				args[j] = t.constNode(vals[j])
+			}
+		}
+	}
+	v, _ := EPREvalOp(op, vals[0], vals[1], vals[2])
+	setPend(t.node(op, args[0], args[1], args[2], v), "")
+}
+
+// lose marks the run lost and records where (diagnostics).
+func (t *EPRProgTracer) lose(op byte, pc uint64, depth, site int) {
+	if !t.lost {
+		t.lost = true
+		t.lostAt = fmt.Sprintf("op=%#x pc=%d depth=%d site=%d", op, pc, depth, site)
+	}
+}
+
+func eprIsPrecompile(a common.Address) bool {
+	for _, b := range a[:19] {
+		if b != 0 {
+			return false
+		}
+	}
+	return a[19] >= 1 && a[19] <= 0x11
+}
+
+// Program builds the guarded program whose outputs are the transaction's storage writes, or nil if the
+// run was lost or a write cannot be attributed.
+func (t *EPRProgTracer) Program(writes map[string]bool) *EPRProgram {
+	if t.lost {
+		return nil
+	}
+	for s := range writes {
+		if !t.written[s] {
+			return nil
+		}
+	}
+	p := &EPRProgram{}
+	keyIdx := map[string]int{}
+	key := func(s string) int32 {
+		if i, ok := keyIdx[s]; ok {
+			return int32(i) //nolint:gosec
+		}
+		keyIdx[s] = len(p.Keys)
+		p.Keys = append(p.Keys, s)
+		return int32(len(p.Keys) - 1) //nolint:gosec
+	}
+	var emit func(n *eprPNode) int32
+	emit = func(n *eprPNode) int32 {
+		if n == nil {
+			return -1
+		}
+		if n.idx >= 0 {
+			return n.idx
+		}
+		var pn EPRProgNode
+		switch n.op {
+		case EPROpVar:
+			pn = EPRProgNode{Op: EPROpVar, A: key(n.key), B: -1, C: -1}
+		case EPROpConst:
+			pn = EPRProgNode{Op: EPROpConst, A: -1, B: -1, C: -1, Const: n.val.Bytes()}
+		default:
+			pn = EPRProgNode{Op: n.op, A: emit(n.a), B: emit(n.b), C: emit(n.c)}
+		}
+		n.idx = int32(len(p.Nodes)) //nolint:gosec
+		p.Nodes = append(p.Nodes, pn)
+		return n.idx
+	}
+	for _, g := range t.guards {
+		w := g.want.Bytes()
+		if g.kind == 1 {
+			w = []byte{0}
+			if g.want.Sign() != 0 {
+				w = []byte{1}
+			}
+		}
+		p.Guards = append(p.Guards, EPRProgGuard{Node: emit(g.n), Kind: g.kind, Value: w})
+	}
+	outs := make([]string, 0, len(writes))
+	for s := range writes {
+		outs = append(outs, s)
+	}
+	sort.Strings(outs)
+	for _, s := range outs {
+		n := t.cur[s]
+		if n == nil {
+			n = t.constNode(t.curVal[s])
+		}
+		p.Outputs = append(p.Outputs, EPRProgOut{Key: uint16(key(s)), Node: emit(n)}) //nolint:gosec
+	}
+	// every storage read is a program input; sorted so that all endorsers sign identical bytes
+	rest := make([]string, 0, len(t.vars))
+	for _, v := range t.vars {
+		if v.val != nil {
+			rest = append(rest, v.key)
+		}
+	}
+	sort.Strings(rest)
+	for _, k := range rest {
+		key(k)
+	}
+	return p
+}
+
+// RewriteProgram replaces every storage write of rws with the encoded program (the committer and the
+// replicas evaluate it once per transaction). Storage keys are "str:..."; other keys are left as they are.
+func (t *EPRProgTracer) RewriteProgram(rws blocks.ReadWriteSet) (blocks.ReadWriteSet, bool) {
+	eprProgTxs.Add(1)
+	if t.lost {
+		eprProgLost.Add(1)
+		return rws, false
+	}
+	writes := map[string]bool{}
+	for _, w := range rws.Writes {
+		if len(w.Key) > 4 && w.Key[:4] == "str:" {
+			writes[w.Key] = true
+		}
+	}
+	if len(writes) == 0 || t.gasRule.short {
+		return rws, false
+	}
+	p := t.Program(writes)
+	if p == nil || len(p.Nodes) > EPRProgMaxNodes {
+		eprProgLost.Add(1)
+		return rws, false
+	}
+	// endorsed output values (the plain write set): a committer may write them directly when none of
+	// the program's keys changed since endorsement (uncontended fast path)
+	orig := make(map[string][]byte, len(rws.Writes))
+	for _, w := range rws.Writes {
+		orig[w.Key] = w.Value
+	}
+	for _, o := range p.Outputs {
+		p.Endorsed = append(p.Endorsed, orig[p.Keys[o.Key]])
+	}
+	enc := p.Encode()
+	for i, w := range rws.Writes {
+		if writes[w.Key] {
+			rws.Writes[i] = blocks.KVWrite{Key: w.Key, Value: enc}
+		}
+	}
+	eprProgUsed.Add(1)
+	return rws, true
+}
+
+var _ = vm.NewGasBudget // keep the vm import for callers in this package
+
+// EPRCombineHooks runs the delta tracer and the program tracer on the same execution.
+func EPRCombineHooks(d *EPRTracer, p *EPRProgTracer) *tracing.Hooks {
+	ph := p.Hooks()
+	return &tracing.Hooks{
+		OnOpcode: func(pc uint64, op byte, gas, cost uint64, scope tracing.OpContext, rData []byte, depth int, err error) {
+			d.onOpcode(pc, op, gas, cost, scope, rData, depth, err)
+			ph.OnOpcode(pc, op, gas, cost, scope, rData, depth, err)
+		},
+		OnEnter: ph.OnEnter,
+		OnExit: func(depth int, output []byte, gasUsed uint64, err error, reverted bool) {
+			d.onExitGas(depth, output, gasUsed, err, reverted)
+			ph.OnExit(depth, output, gasUsed, err, reverted)
+		},
+	}
+}
+
+// EPRRewriteTx chooses the encoding of a transaction's storage writes: guarded deltas when every storage
+// write is one (they commute and admit escrow), otherwise, if program extraction succeeded, one guarded
+// program for the whole transaction; else writes that are guarded deltas keep that form and the others stay
+// plain (ordinary MVCC).
+func EPRRewriteTx(r blocks.ReadWriteSet, d *EPRTracer, p *EPRProgTracer) blocks.ReadWriteSet {
+	if d == nil {
+		return r
+	}
+	orig := append([]blocks.KVWrite(nil), r.Writes...)
+	r = d.Rewrite(r)
+	if p == nil || !EPRProgEnabled {
+		return r
+	}
+	plain := false
+	for _, w := range r.Writes {
+		if len(w.Key) > 4 && w.Key[:4] == "str:" && !(len(w.Value) == 30 && string(w.Value[:5]) == string(EPRMagic2)) {
+			plain = true
+			break
+		}
+	}
+	if !plain {
+		return r
+	}
+	p.GasLeft = d.GasLeft
+	r2 := r
+	r2.Writes = orig
+	if r3, ok := p.RewriteProgram(r2); ok {
+		return r3
+	}
+	// no program: writes that are guarded deltas keep that form, the others stay plain (their reads and
+	// every dependency of a delta are version-checked)
+	r.Writes = orig
+	return d.Rewrite(r)
+}
+
+// memKeys returns the offsets of a shadowed byte area in increasing order. Loops that create nodes or guards
+// iterate in this order, so that every endorser derives the same program bytes (Go randomizes map order).
+func memKeys(m eprPMem) []uint64 {
+	ks := make([]uint64, 0, len(m))
+	for k := range m {
+		ks = append(ks, k)
+	}
+	sort.Slice(ks, func(i, j int) bool { return ks[i] < ks[j] })
+	return ks
+}
diff --git a/endorser/execution/epr_prog_tstore_test.go b/endorser/execution/epr_prog_tstore_test.go
new file mode 100644
index 0000000..b365a8a
--- /dev/null
+++ b/endorser/execution/epr_prog_tstore_test.go
@@ -0,0 +1,100 @@
+package execution
+
+// Transient storage written by a reverted frame is rolled back in the program tracer, as storage
+// is. The contract below stores 7 in transient slot 0, calls itself, and the sub-call stores the storage slot
+// 0 (a program input) in transient slot 0 and reverts; the caller then copies transient slot 0 to storage
+// slot 1. The EVM writes 7 whatever slot 0 holds, so the program's output for slot 1 must be the constant 7.
+// Before the fix the tracer kept the reverted frame's write, and the program output slot 0 instead (wrong
+// on any other state; at endorsement slot 0 is also 7, so the endorsed run alone does not reveal it).
+
+import (
+	"math/big"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/holiman/uint256"
+)
+
+func TestEPRProgramTransientRevert(t *testing.T) {
+	runtime := []byte{
+		0x36, 0x60, 0x21, 0x57, // CALLDATASIZE; PUSH1 sub; JUMPI
+		0x60, 0x07, 0x60, 0x00, 0x5d, // TSTORE(0, 7)
+		0x60, 0x00, 0x60, 0x00, 0x60, 0x01, 0x60, 0x00, 0x60, 0x00, 0x30, 0x62, 0x0f, 0x42, 0x40, 0xf1, // CALL(1e6, self, 0, 0, 1, 0, 0)
+		0x50,                               // POP
+		0x60, 0x00, 0x5c, 0x60, 0x01, 0x55, // SSTORE(1, TLOAD(0))
+		0x00,                               // STOP
+		0x5b,                               // sub: JUMPDEST
+		0x60, 0x00, 0x54, 0x60, 0x00, 0x5d, // TSTORE(0, SLOAD(0))
+		0x60, 0x00, 0x60, 0x00, 0xfd, // REVERT(0, 0)
+	}
+	if runtime[0x21] != 0x5b {
+		t.Fatal("bad jump target")
+	}
+	initCode := append([]byte{0x60, byte(len(runtime)), 0x80, 0x60, 0x0b, 0x60, 0x00, 0x39, 0x60, 0x00, 0xf3}, runtime...)
+
+	sdb, err := state.New(common.Hash{}, state.NewDatabaseForTesting())
+	if err != nil {
+		t.Fatal(err)
+	}
+	e := &eprUniEnv{t: t, sdb: sdb, ctx: vm.BlockContext{
+		CanTransfer: core.CanTransfer, Transfer: core.Transfer,
+		BlockNumber: big.NewInt(30_000_000), Time: 1_800_000_000, GasLimit: 30_000_000,
+		Difficulty: big.NewInt(0), BaseFee: big.NewInt(0), Random: &common.Hash{},
+	}}
+	owner, user := common.BigToAddress(big.NewInt(0x0E0E)), common.BigToAddress(big.NewInt(0xA11CE))
+	_, c, _, err := e.evm(owner, nil).Create(owner, initCode, vm.NewGasBudget(1_000_000), new(uint256.Int))
+	if err != nil {
+		t.Fatal(err)
+	}
+	slot0, slot1 := storeKey(c, common.Hash{}), storeKey(c, common.BigToHash(big.NewInt(1)))
+	run := func(x int64, tr *EPRProgTracer) *big.Int {
+		snap := e.sdb.Snapshot()
+		defer e.sdb.RevertToSnapshot(snap)
+		e.setKey(slot0, big.NewInt(x))
+		evm := e.evm(user, nil)
+		if tr != nil {
+			evm = e.evm(user, tr.Hooks())
+		}
+		if _, _, err := evm.Call(user, c, nil, vm.NewGasBudget(2_000_000), new(uint256.Int)); err != nil {
+			t.Fatalf("call: %v", err)
+		}
+		return e.getKey(slot1)
+	}
+
+	tr := NewEPRProgTracer()
+	if got := run(7, tr); got.Int64() != 7 {
+		t.Fatalf("endorsed run wrote %v", got)
+	}
+	writes := map[string]bool{}
+	for s, w := range tr.written {
+		if w {
+			writes[s] = true
+		}
+	}
+	p := tr.Program(writes)
+	if p == nil {
+		t.Fatalf("no program (lostAt=%q)", tr.lostAt)
+	}
+	q, ok := DecodeEPRProgram(p.Encode())
+	if !ok {
+		t.Fatal("program does not round-trip")
+	}
+	for _, x := range []int64{7, 9, 0, 1_000_000} {
+		want := run(x, nil)
+		out, ok := q.Eval(func(k string) []byte {
+			if k == slot0 {
+				return big.NewInt(x).Bytes()
+			}
+			return nil
+		})
+		if !ok {
+			t.Fatalf("slot0=%d: guards fail although the EVM follows the endorsed path", x)
+		}
+		if got := new(big.Int).SetBytes(out[slot1]); got.Cmp(want) != 0 {
+			t.Fatalf("slot0=%d: program writes %v to slot 1, the EVM writes %v", x, got, want)
+		}
+	}
+}
diff --git a/endorser/execution/epr_prog_uniswap_test.go b/endorser/execution/epr_prog_uniswap_test.go
new file mode 100644
index 0000000..2214483
--- /dev/null
+++ b/endorser/execution/epr_prog_uniswap_test.go
@@ -0,0 +1,374 @@
+package execution
+
+// Differential test of program extraction on a Uniswap-V2-style swap (cross-contract calls,
+// packed reserve slot, constant-product guard). For a swap endorsed on one state, the program is evaluated
+// on many other states (other reserves and balances) and compared with a real EVM re-execution:
+//   - whenever the EVM re-execution follows the same path, the program's guards hold and its outputs
+//     equal the EVM's writes;
+//   - whenever the program's guards hold, the EVM succeeds with exactly those writes;
+//   - whenever the EVM reverts (e.g. the K check fails), the program's guards fail.
+
+import (
+	"encoding/json"
+	"math/big"
+	"os"
+	"math/rand"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/accounts/abi"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+
+	"github.com/hyperledger/fabric-x-evm/integration/contracts"
+)
+
+type eprUniEnv struct {
+	t                  *testing.T
+	sdb                *state.StateDB
+	ctx                vm.BlockContext
+	erc, pairABI       abi.ABI
+	owner, user        common.Address
+	t0, t1, pair       common.Address
+}
+
+func (e *eprUniEnv) evm(from common.Address, hooks *tracing.Hooks) *vm.EVM {
+	cfg := vm.Config{Tracer: hooks}
+	evm := vm.NewEVM(e.ctx, e.sdb, params.MainnetChainConfig, cfg)
+	evm.SetTxContext(vm.TxContext{Origin: from, GasPrice: new(uint256.Int)})
+	return evm
+}
+
+func (e *eprUniEnv) call(from, to common.Address, hooks *tracing.Hooks, a abi.ABI, method string, args ...interface{}) error {
+	in, err := a.Pack(method, args...)
+	if err != nil {
+		e.t.Fatal(err)
+	}
+	_, _, err = e.evm(from, hooks).Call(from, to, in, vm.NewGasBudget(2_000_000), new(uint256.Int))
+	return err
+}
+
+func newEPRUniEnv(t *testing.T) *eprUniEnv {
+	sdb, err := state.New(common.Hash{}, state.NewDatabaseForTesting())
+	if err != nil {
+		t.Fatal(err)
+	}
+	e := &eprUniEnv{t: t, sdb: sdb, ctx: vm.BlockContext{
+		CanTransfer: core.CanTransfer, Transfer: core.Transfer,
+		BlockNumber: big.NewInt(30_000_000), Time: 1_800_000_000, GasLimit: 30_000_000,
+		Difficulty: big.NewInt(0), BaseFee: big.NewInt(0), Random: &common.Hash{},
+	}}
+	e.erc, _ = abi.JSON(strings.NewReader(contracts.GenericERC20MetaData.ABI))
+	e.pairABI, _ = abi.JSON(strings.NewReader(contracts.UniswapV2PairMetaData.ABI))
+	e.owner = common.BigToAddress(big.NewInt(0x0E0E))
+	e.user = common.BigToAddress(big.NewInt(0xA11CE))
+	deploy := func(bin string, a abi.ABI, args ...interface{}) common.Address {
+		in, _ := a.Pack("", args...)
+		_, addr, _, err := e.evm(e.owner, nil).Create(e.owner, append(common.FromHex(bin), in...), vm.NewGasBudget(10_000_000), new(uint256.Int))
+		if err != nil {
+			t.Fatalf("deploy: %v", err)
+		}
+		return addr
+	}
+	supply := new(big.Int).Mul(big.NewInt(1_000_000_000), big.NewInt(1_000_000_000))
+	a := deploy(contracts.GenericERC20MetaData.Bin, e.erc, "TokenA", "TKA", supply, uint8(6))
+	b := deploy(contracts.GenericERC20MetaData.Bin, e.erc, "TokenB", "TKB", supply, uint8(6))
+	e.t0, e.t1 = a, b
+	if strings.ToLower(b.Hex()) < strings.ToLower(a.Hex()) {
+		e.t0, e.t1 = b, a
+	}
+	e.pair = deploy(contracts.UniswapV2PairMetaData.Bin, e.pairABI)
+	must := func(err error) {
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	must(e.call(e.owner, e.pair, nil, e.pairABI, "initialize", e.t0, e.t1))
+	liq := big.NewInt(1_000_000_000_000)
+	must(e.call(e.owner, e.t0, nil, e.erc, "transfer", e.pair, liq))
+	must(e.call(e.owner, e.t1, nil, e.erc, "transfer", e.pair, liq))
+	must(e.call(e.owner, e.pair, nil, e.pairABI, "mint", e.owner))
+	return e
+}
+
+// slotsOf lists the storage keys (StateDB format) and slot hashes of the program's keys per contract.
+func (e *eprUniEnv) setKey(key string, v *big.Int) {
+	addr := common.HexToAddress(key[4:46])
+	e.sdb.SetState(addr, slotHashOf(key), common.BigToHash(v))
+}
+
+func (e *eprUniEnv) getKey(key string) *big.Int {
+	addr := common.HexToAddress(key[4:46])
+	return new(big.Int).SetBytes(e.sdb.GetState(addr, slotHashOf(key)).Bytes())
+}
