+// eprPrimeJSON returns the state-priming file (FX_PRIME_JSON overrides the default).
+func eprPrimeJSON() string {
+	if p := os.Getenv("FX_PRIME_JSON"); p != "" {
+		return p
+	}
+	return "testdata/USDC_contract.json"
+}
+
+// eprMerge forwards in until stall is closed (drain watchdog).
+func eprMerge[T any](in <-chan T, stall <-chan struct{}) <-chan T {
+	out := make(chan T)
+	go func() {
+		defer close(out)
+		for {
+			select {
+			case v, ok := <-in:
+				if !ok {
+					return
+				}
+				select {
+				case out <- v:
+				case <-stall:
+					return
+				}
+			case <-stall:
+				return
+			}
+		}
+	}()
+	return out
+}
+
+// ---- measurement ----
+var (
+	eprStatMu sync.Mutex
+	eprSuccAt []time.Time
+	eprLat    []time.Duration
+)
+
+func eprRecordSuccess(t4, t1 time.Time, haveT1 bool) {
+	eprStatMu.Lock()
+	eprSuccAt = append(eprSuccAt, t4)
+	if haveT1 {
+		eprLat = append(eprLat, t4.Sub(t1))
+	}
+	eprStatMu.Unlock()
+}
+
+// eprRetries counts client resubmissions (FX_RETRY).
+var eprRetries atomic.Int64
+
+func eprReport(t *testing.T) {
+	if r := eprRetries.Load(); r > 0 {
+		t.Logf("EPR RETRY resubmissions=%d", r)
+	}
+	eprStatMu.Lock()
+	defer eprStatMu.Unlock()
+	n := len(eprSuccAt)
+	if n < 20 || len(eprLat) == 0 {
+		return
+	}
+	ts := append([]time.Time(nil), eprSuccAt...)
+	sort.Slice(ts, func(i, j int) bool { return ts[i].Before(ts[j]) })
+	a, b := n/10, n*9/10
+	steady := float64(b-a) / ts[b].Sub(ts[a]).Seconds()
+	whole := float64(n) / ts[n-1].Sub(ts[0]).Seconds()
+	lat := append([]time.Duration(nil), eprLat...)
+	sort.Slice(lat, func(i, j int) bool { return lat[i] < lat[j] })
+	pct := func(p float64) float64 { return float64(lat[int(p*float64(len(lat)-1))]) / 1e6 }
+	var sum float64
+	for _, d := range lat {
+		sum += float64(d) / 1e6
+	}
+	t.Logf("EPR STATS successes=%d steady_goodput=%.1f whole_goodput=%.1f lat_ms_p50=%.1f lat_ms_p90=%.1f lat_ms_p99=%.1f lat_ms_mean=%.1f",
+		n, steady, whole, pct(0.5), pct(0.9), pct(0.99), sum/float64(len(lat)))
+}
