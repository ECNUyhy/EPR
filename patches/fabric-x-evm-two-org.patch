+
+// eprMismatchRetries counts the endorsement disagreements resubmitted (-retry-mismatch).
+var eprMismatchRetries atomic.Int64
+
+// hasSub reports whether s contains sub.
+func hasSub(s, sub string) bool {
+	for i := 0; i+len(sub) <= len(s); i++ {
+		if s[i:i+len(sub)] == sub {
+			return true
+		}
+	}
+	return false
+}
+
+var extraEndorsers = flag.String("extra-endorsers", "", "comma-separated endorser config files of further organizations, relative to integration/ (D16 two-organization runs), e.g. fabx-2of2-org2.yaml")
+
+// splitList splits a comma-separated flag value, dropping empty items.
+func splitList(v string) []string {
+	var out []string
+	start := 0
+	for i := 0; i <= len(v); i++ {
+		if i == len(v) || v[i] == ',' {
+			if p := v[start:i]; p != "" {
+				out = append(out, p)
+			}
+			start = i + 1
+		}
+	}
+	return out
+}
 
