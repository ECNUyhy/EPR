+	keyC := "C"
+	keyD := "D"
+	keyE := "E"
+
+	blk := uint64(0)
+	reads := map[string][]string{
+		keyD: []string{"tx0"},
+	}
+	updates := map[string][]string{}
+	assert.NoError(t, store.Commit(blk, updates, reads))
+
+	blk = uint64(1)
+	updates = map[string][]string{
+		keyD: []string{"tx1", "tx2"},
