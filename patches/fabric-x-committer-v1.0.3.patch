diff --git a/service/coordinator/dependencygraph/epr_domain_test.go b/service/coordinator/dependencygraph/epr_domain_test.go
new file mode 100644
index 0000000..a9c6da2
--- /dev/null
+++ b/service/coordinator/dependencygraph/epr_domain_test.go
@@ -0,0 +1,43 @@
+package dependencygraph
+
+// The coordinator recognizes guarded deltas exactly where the VC does: on storage keys ("str:...") only.
+// A non-storage key with such bytes is an ordinary (ordered) read-write.
+
+import (
+	"encoding/binary"
+	"math"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func eprDomainDelta(d, lower int64) []byte {
+	b := append([]byte(nil), "EPRD2"...)
+	b = binary.BigEndian.AppendUint64(b, uint64(d))     //nolint:gosec
+	b = binary.BigEndian.AppendUint64(b, uint64(lower)) //nolint:gosec
+	b = binary.BigEndian.AppendUint64(b, math.MaxInt64)
+	return append(b, 32)
+}
+
+func TestEPRDomainSeparationDepGraph(t *testing.T) { //nolint:paralleltest // toggles package flags
+	oldDG, oldEsc := eprDepGraph, eprEscrowOn
+	eprDepGraph, eprEscrowOn = true, true
+	t.Cleanup(func() { eprDepGraph, eprEscrowOn = oldDG, oldEsc })
+
+	credit, debit := eprDomainDelta(5, 0), eprDomainDelta(-5, 0)
+	storage := []byte("str:0xa:0x1")
+	for _, k := range [][]byte{[]byte("acc:0xa:code"), []byte("acc:0xa:nonce"), []byte("k")} {
+		require.False(t, eprCommutes(k, credit), "%s", k)
+		require.False(t, eprIsEscrowDebit(k, debit), "%s", k)
+	}
+	require.True(t, eprCommutes(storage, credit))
+	require.True(t, eprIsEscrowDebit(storage, debit))
+
+	// a credit-shaped value on a non-storage key keeps an ordinary read-write dependency
+	tx := createTxForTest(t, 0, nsID1ForTest, nil, [][]byte{[]byte("acc:0xa:code"), storage}, nil)
+	tx.Content.Namespaces[0].ReadWrites[0].Value = credit
+	tx.Content.Namespaces[0].ReadWrites[1].Value = credit
+	n := newTransactionNode(tx)
+	require.Equal(t, []string{constructCompositeKey(nsID1ForTest, []byte("acc:0xa:code"))}, n.rwKeys.readsAndWrites)
+	require.Equal(t, []string{constructCompositeKey(nsID1ForTest, storage)}, n.rwKeys.deltas)
+}
diff --git a/service/coordinator/dependencygraph/epr_escrow.go b/service/coordinator/dependencygraph/epr_escrow.go
new file mode 100644
index 0000000..3c1ae61
--- /dev/null
+++ b/service/coordinator/dependencygraph/epr_escrow.go
@@ -0,0 +1,453 @@
+/*
+Extension (not upstream): escrow-style debit commutativity in the dependency graph.
+
+Guarded deltas "key += delta if key + delta >= lower" are classified in ledger order:
+  - credits (lower = MinInt64) never fail and always commute (tracked as deltas);
+  - a debit takes the FAST path (commutes, no dependency edges with other deltas on the key) only if
+    a conservative lower bound of its serial-prefix balance covers it:
+        LB = prefix + sum(finished valid effects after the prefix) + sum(unfinished debits before it)
+    (unfinished credits are ignored). Then the debit succeeds in ledger-order serial execution and in
+    any interleaving of the other admitted deltas, so its outcome is order-independent;
+  - otherwise it takes the SLOW path: an ordinary read-write that waits for every earlier access to
+    the key and is evaluated exactly by the VC.
+Committers of different organizations may choose different paths (timing), but both paths yield the
+serial outcome, so results stay deterministic. `prefix` is the balance after the longest finished
+prefix of accesses to the key (fresh database: starts at 0). Enabled with FX_EPR3=1.
+*/
+
+package dependencygraph
+
+import (
+	"bytes"
+	"encoding/binary"
+	"math"
+	"os"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/hyperledger/fabric-x-common/api/applicationpb"
+)
+
+var (
+	eprEscrowOn = os.Getenv("FX_EPR3") == "1"
+
+	eprEscrowMu    sync.Mutex
+	eprEscrowCond  = sync.NewCond(&eprEscrowMu)
+	eprLastBatchID uint64
+	eprKeys        = map[string]*eprKeyState{}
+	eprFastDebits  atomic.Int64
+	eprSlowDebits  atomic.Int64
+	eprCreditsSeen atomic.Int64
+)
+
+type eprItem struct {
+	delta int64
+	done  bool
+	valid bool
+	node  *TransactionNode
+	// formula writes (linear formulas): the item sets the key to a value the coordinator computes
+	// from the finished prefixes when the (ordered) formula transaction completes.
+	isSet   bool
+	f       *depFormula
+	ns      string
+	setTo   int64
+	unknown bool
+}
+
+type eprKeyState struct {
+	prefix  int64
+	pending []*eprItem
+	// unknown is set once a plain (non-delta) write to the key is classified: its value is no longer
+	// derivable from deltas, so later debits on it always take the slow (exact, ordered) path.
+	unknown bool
+	// maxLower is the strictest lower bound seen among debits on the key; fast admission uses it so that
+	// any interleaving of admitted debits keeps every admitted debit's own guard (Theorem 3, case 2).
+	maxLower int64
+	hasLower bool
+}
+
+type eprAccess struct {
+	ck           string
+	delta, lower int64
+	f            *depFormula
+	ns           string
+}
+
+// eprStorageKey reports whether k is a contract storage key: EVM signed content (EPRD2 deltas, EPRP1
+// programs) is only recognized on such keys, matching the VC; any other key's value is a plain write.
+func eprStorageKey(k []byte) bool { return bytes.HasPrefix(k, []byte("str:")) }
+
+// eprGuardedDelta decodes the guarded-delta encoding of the value v written to key k.
+func eprGuardedDelta(k, v []byte) (delta, lower int64, ok bool) {
+	if len(v) == 30 && bytes.HasPrefix(v, []byte("EPRD2")) {
+		if !eprStorageKey(k) {
+			return 0, 0, false
+		}
+		// EVM interval-guarded delta: only lower-bounded ones are escrow-classified; an EPRD2 credit
+		// (lower <= delta, never failing on a non-negative word) is reported as an unconditional credit,
+		// matching eprCommutes and the VC's eprIsCredit2.
+		d := int64(binary.BigEndian.Uint64(v[5:13]))  //nolint:gosec
+		l := int64(binary.BigEndian.Uint64(v[13:21])) //nolint:gosec
+		u := int64(binary.BigEndian.Uint64(v[21:29])) //nolint:gosec
+		if u != math.MaxInt64 {
+			return 0, 0, false
+		}
+		if d >= 0 && l <= d {
+			return d, math.MinInt64, true
+		}
+		return d, l, true
+	}
+	if len(v) != 21 || !bytes.HasPrefix(v, []byte("EPRD1")) {
+		return 0, 0, false
+	}
+	return int64(binary.BigEndian.Uint64(v[5:13])), int64(binary.BigEndian.Uint64(v[13:])), true //nolint:gosec
+}
+
+// eprIsEscrowDebit reports whether a read-write of key k with value v is a guarded debit handled by the
+// escrow classifier.
+func eprIsEscrowDebit(k, v []byte) bool {
+	if !eprEscrowOn {
+		return false
+	}
+	_, l, ok := eprGuardedDelta(k, v)
+	return ok && l != math.MinInt64
+}
+
+func eprParse(nss []*applicationpb.TxNamespace) []eprAccess {
+	var out []eprAccess
+	for _, ns := range nss {
+		for _, rw := range ns.ReadWrites {
+			if d, l, ok := eprGuardedDelta(rw.Key, rw.Value); ok {
+				out = append(out, eprAccess{ck: constructCompositeKey(ns.NsId, rw.Key), delta: d, lower: l})
+			} else if f, okf := depDecodeFormula(rw.Value); okf && eprEscrowOn {
+				out = append(out, eprAccess{ck: constructCompositeKey(ns.NsId, rw.Key), f: f, ns: ns.NsId})
+			}
+		}
+	}
+	return out
+}
+
+// eprClassifyBatch classifies the guarded deltas of one batch in ledger order (batch IDs are
+// consecutive starting at 1) and completes the nodes' key sets accordingly.
+func eprClassifyBatch(id uint64, nodes TxNodeBatch, aborted func() bool) {
+	if !eprEscrowOn {
+		return
+	}
+	eprEscrowMu.Lock()
+	defer eprEscrowMu.Unlock()
+	for eprLastBatchID != id-1 && !aborted() {
+		eprEscrowCond.Wait()
+	}
+	for _, n := range nodes {
+		accs := eprParse(n.VCTx.Namespaces)
+		formulaKeys := map[string]bool{}
+		for _, a := range accs {
+			if a.f != nil {
+				formulaKeys[a.ck] = true
+			}
+		}
+		// A plain write whose value is an integer (8-byte int64, a 32-byte EVM word that fits int64, or an
+		// empty/deleted value = 0) is a constant formula: an ordered set item that re-establishes exact
+		// knowledge of the key once it finishes valid. Any other plain write poisons the key's escrow
+		// knowledge (safe fallback to the slow path).
+		plainVals := eprPlainWriteValues(n.VCTx.Namespaces)
+		for _, keys := range [][]string{n.rwKeys.readsAndWrites, n.rwKeys.writesOnly} {
+			for _, ck := range keys {
+				if formulaKeys[ck] {
+					continue
+				}
+				st := eprKeys[ck]
+				if st == nil {
+					st = &eprKeyState{}
+					eprKeys[ck] = st
+				}
+				if v, ok := plainVals[ck]; ok {
+					it := &eprItem{isSet: true, f: &depFormula{c: v}, node: n}
+					st.pending = append(st.pending, it)
+					n.eprItems = append(n.eprItems, eprItemRef{ck: ck, item: it})
+					continue
+				}
+				// any other write (a program output or a non-integer value) is an ordered barrier with an
+				// unknown result: an earlier set item finishing cannot re-establish knowledge past it
+				it := &eprItem{isSet: true, unknown: true, node: n}
+				st.pending = append(st.pending, it)
+				n.eprItems = append(n.eprItems, eprItemRef{ck: ck, item: it})
+				st.unknown = true
+			}
+		}
+		for _, a := range accs {
+			st := eprKeys[a.ck]
+			if st == nil {
+				st = &eprKeyState{}
+				eprKeys[a.ck] = st
+			}
+			if a.f != nil { // ordered formula write: a barrier until it finishes
+				it := &eprItem{isSet: true, f: a.f, ns: a.ns, node: n}
+				st.pending = append(st.pending, it)
+				n.eprItems = append(n.eprItems, eprItemRef{ck: a.ck, item: it})
+				continue
+			}
+			it := &eprItem{delta: a.delta, node: n}
+			if a.lower == math.MinInt64 {
+				eprCreditsSeen.Add(1)
+				st.pending = append(st.pending, it)
+				n.eprItems = append(n.eprItems, eprItemRef{ck: a.ck, item: it})
+				continue // credits are placed in rwKeys.deltas by readAndWriteKeys (commutative credits)
+			}
+			lb := st.prefix
+			barrier := false
+			for _, p := range st.pending {
+				if p.isSet { // value unknown until the formula transaction finishes
+					barrier = true
+					break
+				}
+				switch {
+				case p.done && p.valid:
+					lb += p.delta
+				case !p.done && p.delta < 0:
+					lb += p.delta
+				}
+			}
+			st.pending = append(st.pending, it)
+			n.eprItems = append(n.eprItems, eprItemRef{ck: a.ck, item: it})
+			if !st.hasLower || a.lower > st.maxLower {
+				st.maxLower, st.hasLower = a.lower, true
+			}
+			bound := st.maxLower
+			if !barrier && !st.unknown && lb+a.delta >= bound && !eprAddOverflows(lb, a.delta) {
+				eprFastDebits.Add(1)
+				n.rwKeys.deltas = append(n.rwKeys.deltas, a.ck)
+			} else {
+				eprSlowDebits.Add(1)
+				n.rwKeys.readsAndWrites = append(n.rwKeys.readsAndWrites, a.ck)
+			}
+		}
+	}
+	eprLastBatchID = id
+	eprEscrowCond.Broadcast()
+}
+
+// eprFinish records validation outcomes and advances each key's finished prefix.
+func eprFinish(nodes TxNodeBatch) {
+	if !eprEscrowOn {
+		return
+	}
+	eprEscrowMu.Lock()
+	defer eprEscrowMu.Unlock()
+	touched := map[string]bool{}
+	for _, n := range nodes {
+		if n.eprValid.Load() {
+			// all earlier accesses to the formula's keys have finished (ordered), so the prefixes are the
+			// exact pre-transaction values: evaluate every formula of the tx before absorbing any.
+			for _, r := range n.eprItems {
+				if !r.item.isSet || r.item.f == nil { // a barrier keeps its unknown result
+					continue
+				}
+				v, known := r.item.f.evalOn(func(raw string) (int64, bool) {
+					st := eprKeys[constructCompositeKey(r.item.ns, []byte(raw))]
+					if st == nil {
+						return 0, true // never touched in this run: fresh key
+					}
+					return st.prefix, !st.unknown
+				})
+				r.item.setTo, r.item.unknown = v, !known
+			}
+		}
+		for _, r := range n.eprItems {
+			r.item.done = true
+			r.item.valid = n.eprValid.Load()
+			r.item.node = nil
+			touched[r.ck] = true
+		}
+	}
+	for ck := range touched {
+		st := eprKeys[ck]
+		i := 0
+		for ; i < len(st.pending) && st.pending[i].done; i++ {
+			it := st.pending[i]
+			if !it.valid {
+				continue
+			}
+			if it.isSet {
+				st.prefix = it.setTo
+				st.unknown = it.unknown // an exactly computed formula result re-establishes knowledge
+				continue
+			}
+			st.prefix += it.delta
+		}
+		st.pending = st.pending[i:]
+	}
+}
+
+// eprPlainWriteValues returns, per composite key, the integer value of each plain (non-EPR) write of
+// the transaction that can be parsed exactly; keys with other values are absent from the map.
+func eprPlainWriteValues(nss []*applicationpb.TxNamespace) map[string]int64 {
+	out := map[string]int64{}
+	parse := func(v []byte) (int64, bool) {
+		switch len(v) {
+		case 0:
+			return 0, true
+		case 8:
+			if bytes.HasPrefix(v, []byte("EPR")) {
+				return 0, false
+			}
+			return int64(binary.BigEndian.Uint64(v)), true //nolint:gosec
+		case 32:
+			for _, c := range v[:24] {
+				if c != 0 {
+					return 0, false
+				}
+			}
+			if v[24]&0x80 != 0 {
+				return 0, false
+			}
+			return int64(binary.BigEndian.Uint64(v[24:])), true //nolint:gosec
+		}
+		return 0, false
+	}
+	for _, ns := range nss {
+		for _, rw := range ns.ReadWrites {
+			if x, ok := parse(rw.Value); ok {
+				out[constructCompositeKey(ns.NsId, rw.Key)] = x
+			}
+		}
+		for _, bw := range ns.BlindWrites {
+			if x, ok := parse(bw.Value); ok {
+				out[constructCompositeKey(ns.NsId, bw.Key)] = x
+			}
+		}
+	}
+	return out
+}
+
+// EPRSetValid is called by the coordinator when the VC returns the transaction's status.
+func (n *TransactionNode) EPRSetValid(valid bool) { n.eprValid.Store(valid) }
+
+// EPREscrowStats reports fast/slow debit counts and credits seen.
+func EPREscrowStats() (fast, slow, credits int64) {
+	return eprFastDebits.Load(), eprSlowDebits.Load(), eprCreditsSeen.Load()
+}
+
+type eprItemRef struct {
+	ck   string
+	item *eprItem
+}
+
+func init() {
+	if !eprEscrowOn {
+		return
+	}
+	go func() {
+		for range time.Tick(5 * time.Second) {
+			f, s, c := EPREscrowStats()
+			logger.Infof("PILOT_ESCROW fast_debits=%d slow_debits=%d credits=%d", f, s, c)
+		}
+	}()
+}
+
+// ---- formula decoding (same encoding as the VC) ----
+type depTerm struct {
+	key  string
+	coef int64
+}
+
+type depFormula struct {
+	terms  []depTerm
+	c      int64
+	guard  []depTerm
+	gc     int64
+	hasG   bool
+	expect byte
+	pf     int64
+}
+
+func depReadTerms(b []byte) ([]depTerm, []byte, bool) {
+	if len(b) < 1 {
+		return nil, nil, false
+	}
+	n := int(b[0])
+	b = b[1:]
+	ts := make([]depTerm, 0, n)
+	for i := 0; i < n; i++ {
+		if len(b) < 1 {
+			return nil, nil, false
+		}
+		kl := int(b[0])
+		if len(b) < 1+kl+8 {
+			return nil, nil, false
+		}
+		ts = append(ts, depTerm{key: string(b[1 : 1+kl]), coef: int64(binary.BigEndian.Uint64(b[1+kl : 9+kl]))}) //nolint:gosec
+		b = b[9+kl:]
+	}
+	return ts, b, true
+}
+
+func depDecodeFormula(v []byte) (*depFormula, bool) {
+	if !bytes.HasPrefix(v, []byte("EPRF1")) {
+		return nil, false
+	}
+	b := v[5:]
+	f := &depFormula{}
+	var ok bool
+	if f.terms, b, ok = depReadTerms(b); !ok || len(b) < 9 {
+		return nil, false
+	}
+	f.c = int64(binary.BigEndian.Uint64(b[:8])) //nolint:gosec
+	ng := b[8]
+	b = b[9:]
+	if ng == 1 {
+		f.hasG = true
+		if f.guard, b, ok = depReadTerms(b); !ok || len(b) < 9 {
+			return nil, false
+		}
+		f.gc = int64(binary.BigEndian.Uint64(b[:8])) //nolint:gosec
+		f.expect = b[8]
+		b = b[9:]
+	}
+	if len(b) < 8 {
+		return nil, false
+	}
+	f.pf = int64(binary.BigEndian.Uint64(b[:8])) //nolint:gosec
+	return f, true
+}
+
+// evalOn evaluates the formula on prefix values; known=false if any referenced value is unknown.
+func (f *depFormula) evalOn(val func(string) (int64, bool)) (int64, bool) {
+	known := true
+	get := func(k string) int64 {
+		x, ok := val(k)
+		if !ok {
+			known = false
+		}
+		return x
+	}
+	bit := byte(1)
+	if f.hasG {
+		if f.expect != 0xFF {
+			bit = f.expect // valid tx: the committer confirmed the endorsed path
+		} else {
+			g := f.gc
+			for _, t := range f.guard {
+				g += t.coef * get(t.key)
+			}
+			if g < 0 {
+				bit = 0
+			}
+		}
+	}
+	v := f.c
+	for _, t := range f.terms {
+		v += t.coef * get(t.key)
+	}
+	if bit == 0 {
+		v += f.pf
+	}
+	return v, known
+}
+
+// eprAddOverflows reports whether a+b overflows int64.
+func eprAddOverflows(a, b int64) bool {
+	c := a + b
+	return (b > 0 && c < a) || (b < 0 && c > a)
+}
diff --git a/service/coordinator/dependencygraph/epr_escrow_barrier_test.go b/service/coordinator/dependencygraph/epr_escrow_barrier_test.go
new file mode 100644
index 0000000..4bfa05a
--- /dev/null
+++ b/service/coordinator/dependencygraph/epr_escrow_barrier_test.go
@@ -0,0 +1,78 @@
+package dependencygraph
+
+import (
+	"encoding/binary"
+	"math"
+	"testing"
+
+	"github.com/hyperledger/fabric-x-common/api/applicationpb"
+	"github.com/stretchr/testify/require"
+
+	"github.com/hyperledger/fabric-x-committer/api/servicepb"
+)
+
+// eprTestNode builds a coordinator node writing value v to key k of namespace ns; plain writes are
+// read-writes of the key, escrow debits are left to the classifier.
+func eprTestNode(ns, k string, v []byte, plain bool) *TransactionNode {
+	n := &TransactionNode{VCTx: &servicepb.VcTx{Namespaces: []*applicationpb.TxNamespace{{
+		NsId:       ns,
+		ReadWrites: []*applicationpb.ReadWrite{{Key: []byte(k), Value: v}},
+	}}}}
+	if plain {
+		n.rwKeys.readsAndWrites = []string{constructCompositeKey(ns, []byte(k))}
+	}
+	return n
+}
+
+func eprTestDebit(delta, lower int64) []byte {
+	b := append([]byte(nil), "EPRD2"...)
+	b = binary.BigEndian.AppendUint64(b, uint64(delta)) //nolint:gosec
+	b = binary.BigEndian.AppendUint64(b, uint64(lower)) //nolint:gosec
+	b = binary.BigEndian.AppendUint64(b, math.MaxInt64)
+	return append(b, 32)
+}
+
+// TestEPREscrowProgramBarrier: an integer plain write W, then a program output P on the same key; W
+// finishes before P. The key's value is unknown until P finishes, so a debit classified in between must
+// take the slow (ordered) path, and so must one classified after P.
+func TestEPREscrowProgramBarrier(t *testing.T) {
+	old := eprEscrowOn
+	eprEscrowOn = true
+	eprEscrowMu.Lock()
+	eprKeys, eprLastBatchID = map[string]*eprKeyState{}, 0
+	eprEscrowMu.Unlock()
+	t.Cleanup(func() { eprEscrowOn = old })
+
+	const ns, k = "ns1", "str:k" // signed content is recognized on storage keys only
+	ck := constructCompositeKey(ns, []byte(k))
+	never := func() bool { return false }
+
+	w := eprTestNode(ns, k, binary.BigEndian.AppendUint64(nil, 100), true)
+	p := eprTestNode(ns, k, []byte("EPRP-program-encoding-not-an-integer-value"), true)
+	eprClassifyBatch(1, TxNodeBatch{w, p}, never)
+
+	w.eprValid.Store(true)
+	eprFinish(TxNodeBatch{w})
+
+	d1 := eprTestNode(ns, k, eprTestDebit(-50, 50), false)
+	eprClassifyBatch(2, TxNodeBatch{d1}, never)
+	require.Contains(t, d1.rwKeys.readsAndWrites, ck, "debit after a pending program must be ordered")
+	require.NotContains(t, d1.rwKeys.deltas, ck)
+
+	p.eprValid.Store(true)
+	eprFinish(TxNodeBatch{p})
+	d2 := eprTestNode(ns, k, eprTestDebit(-50, 50), false)
+	eprClassifyBatch(3, TxNodeBatch{d2}, never)
+	require.Contains(t, d2.rwKeys.readsAndWrites, ck, "debit after a finished program must be ordered")
+
+	// a later integer write re-establishes knowledge: once it finishes, debits it covers are fast again
+	w2 := eprTestNode(ns, k, binary.BigEndian.AppendUint64(nil, 100), true)
+	eprClassifyBatch(4, TxNodeBatch{w2}, never)
+	d1.eprValid.Store(true)
+	d2.eprValid.Store(true)
+	w2.eprValid.Store(true)
+	eprFinish(TxNodeBatch{d1, d2, w2})
+	d3 := eprTestNode(ns, k, eprTestDebit(-50, 50), false)
+	eprClassifyBatch(5, TxNodeBatch{d3}, never)
+	require.Contains(t, d3.rwKeys.deltas, ck)
+}
diff --git a/service/coordinator/dependencygraph/epr_fabricsharp.go b/service/coordinator/dependencygraph/epr_fabricsharp.go
new file mode 100644
index 0000000..dc469f8
--- /dev/null
+++ b/service/coordinator/dependencygraph/epr_fabricsharp.go
@@ -0,0 +1,410 @@
+/*
+Baseline (not upstream): FabricSharp's fine-grained concurrency control (Ruan et al., "A Transactional
+Perspective on Execute-order-validate Blockchains", SIGMOD'20), in the Fabric-X coordinator. FX_FABRICSHARP=1
+runs the authors' scheduler (epr_fabricsharp_orig.go). FX_FABRICSHARP=exact runs the idealized
+reimplementation below (exact cycle detection, in-memory indices: an upper bound of FabricSharp), where every
+block is processed in block order before dependency construction:
+
+  Algorithm 2 (per transaction, in arrival order). Dependencies on committed and pending transactions are
+  computed as in the paper's Section 4.3: predecessors are the last committed writer of each written key
+  (ww), the writer of each version read (n-wr) and the committed and pending readers of each written key
+  (rw); successors are the committed writers of a read key after the version read and its pending writers
+  (anti-rw). c-ww among pending transactions is ignored. If a successor reaches a predecessor (a cycle),
+  the schedule can never be serialized (Theorem 2) and the transaction is aborted early; otherwise it joins
+  the graph.
+  Algorithm 3 (per block). The accepted transactions are topologically sorted (ties: arrival order), the
+  c-ww edges among them are restored in that order, and they are committed in that order.
+
+As in the paper, committers do not validate read versions of accepted transactions (its Figure 8, "no
+concurrency validation" at peers): an accepted transaction may have read a stale version, and is
+serialized before the transaction that overwrote it. The validator-committer therefore receives accepted
+transactions with their reads dropped (read-writes become blind writes); the transactions themselves, and
+so their signatures, are unchanged. Early-aborted transactions are reported with ABORTED_MVCC_CONFLICT.
+
+Cycle detection is exact (graph search) instead of the paper's Bloom filters, which only add false-positive
+aborts. Committed transactions older than fsWindowBlocks (max_span) blocks leave the graph, like the paper's
+pruning and relay filters; a read of a version older than that window is aborted, as Fabric would.
+*/
+
+package dependencygraph
+
+import (
+	"fmt"
+	"os"
+	"sort"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/hyperledger/fabric-x-common/api/applicationpb"
+	"github.com/hyperledger/fabric-x-common/api/committerpb"
+
+	"github.com/hyperledger/fabric-x-committer/api/servicepb"
+	fscommon "github.com/hyperledger/fabric-x-committer/service/coordinator/dependencygraph/fabricsharp/common"
+)
+
+// FabricSharpOn enables the FabricSharp baseline: FX_FABRICSHARP=1 runs the authors' scheduler
+// (epr_fabricsharp_orig.go), FX_FABRICSHARP=exact the idealized reimplementation in this file.
+var FabricSharpOn = os.Getenv("FX_FABRICSHARP") == "1" || fsExact
+
+var fsExact = os.Getenv("FX_FABRICSHARP") == "exact"
+
+// fsWindowBlocks is the paper's max_span (Section 4.6; fixed to 10 in its experiments, Section 5.2):
+// committed transactions older than that many blocks leave the graph, and a read whose overwriting write
+// left the window is aborted. FX_FS_SPAN overrides it (sensitivity runs only).
+var fsWindowBlocks = fsSpan()
+
+func fsSpan() uint64 {
+	var n uint64
+	if _, err := fmt.Sscanf(os.Getenv("FX_FS_SPAN"), "%d", &n); err != nil || n == 0 {
+		return 10
+	}
+	return n
+}
+
+var (
+	fsAcceptedCnt, fsAbortedCnt, fsStaleAcceptedCnt, fsBlocks atomic.Int64
+	fsStripped                                                sync.Map // tx ID -> VC namespaces without reads
+	fsState                                                   = newFabricSharp()
+)
+
+func init() {
+	if !FabricSharpOn {
+		return
+	}
+	go func() {
+		for range time.Tick(5 * time.Second) {
+			logger.Infof("PILOT_FABRICSHARP blocks=%d accepted=%d stale_accepted=%d early_aborted=%d "+
+				"span_dropped=%d deserted=%d no_snapshot=%d exact=%v",
+				fsBlocks.Load(), fsAcceptedCnt.Load(), fsStaleAcceptedCnt.Load(), fsAbortedCnt.Load(),
+				fsSpanDroppedCnt.Load(), fscommon.Warnings.Load(), fsNoSnapCnt.Load(), fsExact)
+		}
+	}()
+}
+
+type fsNode struct {
+	succ   map[*fsNode]struct{}
+	block  uint64
+	pruned bool
+}
+
+type fsWriter struct {
+	ver int64
+	n   *fsNode
+}
+
+type fsKey struct {
+	known   bool
+	cur     int64 // version of the latest committed write
+	writers []fsWriter
+	readers []*fsNode
+}
+
+type fabricSharp struct {
+	keys  map[string]*fsKey
+	nodes []*fsNode // committed, in commit order
+}
+
+func newFabricSharp() *fabricSharp { return &fabricSharp{keys: map[string]*fsKey{}} }
+
+type fsAccess struct {
+	reads  map[string]int64
+	writes map[string]bool
+}
+
+func fsVer(v *uint64) int64 {
+	if v == nil {
+		return -1 // the key did not exist
+	}
+	return int64(*v) //nolint:gosec
+}
+
+func fsCompositeKey(ns string, k []byte) string { return ns + "\x00" + string(k) }
+
+// fsAccesses returns the keys a transaction reads (with the versions read) and writes; ok is false for
+// transactions touching a system namespace, which are left alone.
+func fsAccesses(tx *servicepb.TxWithRef) (fsAccess, bool) {
+	a := fsAccess{reads: map[string]int64{}, writes: map[string]bool{}}
+	if tx.Content == nil {
+		return a, false
+	}
+	for _, ns := range tx.Content.Namespaces {
+		if ns.NsId == committerpb.MetaNamespaceID || ns.NsId == committerpb.ConfigNamespaceID {
+			return a, false
+		}
+		for _, r := range ns.ReadsOnly {
+			a.reads[fsCompositeKey(ns.NsId, r.Key)] = fsVer(r.Version)
+		}
+		for _, rw := range ns.ReadWrites {
+			k := fsCompositeKey(ns.NsId, rw.Key)
+			a.reads[k] = fsVer(rw.Version)
+			a.writes[k] = true
+		}
+		for _, w := range ns.BlindWrites {
+			a.writes[fsCompositeKey(ns.NsId, w.Key)] = true
+		}
+	}
+	return a, true
+}
+
+// key returns the state of a key, pruning entries that left the window.
+func (f *fabricSharp) key(k string, cutoff uint64) *fsKey {
+	ks := f.keys[k]
+	if ks == nil {
+		ks = &fsKey{}
+		f.keys[k] = ks
+	}
+	if len(ks.writers) > 1 && ks.writers[0].n.block < cutoff {
+		i := sort.Search(len(ks.writers)-1, func(i int) bool { return ks.writers[i].n.block >= cutoff })
+		ks.writers = append([]fsWriter(nil), ks.writers[i:]...) // keep at least the last writer
+	}
+	if len(ks.readers) > 0 && ks.readers[0].block < cutoff {
+		i := sort.Search(len(ks.readers), func(i int) bool { return ks.readers[i].block >= cutoff })
+		ks.readers = append([]*fsNode(nil), ks.readers[i:]...)
+	}
+	return ks
+}
+
+// reaches reports whether any node in from reaches any node in to.
+func fsReaches(from, to map[*fsNode]struct{}) bool {
+	if len(from) == 0 || len(to) == 0 {
+		return false
+	}
+	seen := map[*fsNode]bool{}
+	stack := make([]*fsNode, 0, len(from))
+	for n := range from {
+		stack = append(stack, n)
+	}
+	for len(stack) > 0 {
+		n := stack[len(stack)-1]
+		stack = stack[:len(stack)-1]
+		if seen[n] || n.pruned {
+			continue
+		}
+		seen[n] = true
+		if _, ok := to[n]; ok {
+			return true
+		}
+		for s := range n.succ {
+			if !seen[s] {
+				stack = append(stack, s)
+			}
+		}
+	}
+	return false
+}
+
+// FabricSharpBlock reorders a block's transactions and moves the early-aborted ones to its rejected list.
+// It must be called for blocks in block order, from one goroutine.
+func FabricSharpBlock(blk *servicepb.CoordinatorBatch) {
+	if len(blk.Txs) == 0 {
+		return
+	}
+	fsBlocks.Add(1)
+	if !fsExact {
+		fabricSharpOrigBlock(blk)
+		return
+	}
+	f := fsState
+	blockNum := blk.Txs[0].Ref.BlockNum
+	var cutoff uint64
+	if blockNum > fsWindowBlocks {
+		cutoff = blockNum - fsWindowBlocks
+	}
+
+	var (
+		passthrough []*servicepb.TxWithRef
+		keep        []*servicepb.TxWithRef
+		pend        []*fsNode
+		acc         []fsAccess
+		staleRead   []bool
+		pw          = map[string][]*fsNode{}
+		pr          = map[string][]*fsNode{}
+	)
+	for _, tx := range blk.Txs {
+		a, ok := fsAccesses(tx)
+		if !ok {
+			passthrough = append(passthrough, tx)
+			continue
+		}
+		n := &fsNode{succ: map[*fsNode]struct{}{}, block: blockNum}
+		preds, succs := map[*fsNode]struct{}{}, map[*fsNode]struct{}{}
+		abort, stale := false, false
+		for k, v := range a.reads {
+			ks := f.key(k, cutoff)
+			if !ks.known || v > ks.cur { // first sight, or a base version we could not see (e.g. genesis)
+				ks.known, ks.cur = true, v
+			}
+			if v < ks.cur {
+				stale = true
+				covered := false
+				for _, w := range ks.writers {
+					if w.ver > v {
+						succs[w.n] = struct{}{} // anti-rw on a committed writer
+						if w.ver == v+1 {
+							covered = true
+						}
+					}
+				}
+				if !covered { // the overwriting write left the window
+					abort = true
+				}
+			}
+			for _, w := range ks.writers {
+				if w.ver == v {
+					preds[w.n] = struct{}{} // n-wr
+				}
+			}
+			for _, p := range pw[k] {
+				succs[p] = struct{}{} // anti-rw on a pending writer
+			}
+		}
+		for k := range a.writes {
+			ks := f.key(k, cutoff)
+			if l := len(ks.writers); l > 0 {
+				preds[ks.writers[l-1].n] = struct{}{} // ww
+			}
+			for _, r := range ks.readers {
+				preds[r] = struct{}{} // rw (committed)
+			}
+			for _, r := range pr[k] {
+				preds[r] = struct{}{} // rw (pending)
+			}
+		}
+		if !abort {
+			for s := range succs {
+				if _, ok := preds[s]; ok {
+					abort = true
+					break
+				}
+			}
+		}
+		if abort || fsReaches(succs, preds) {
+			fsAbortedCnt.Add(1)
+			blk.Rejected = append(blk.Rejected, &committerpb.TxStatus{
+				Ref: tx.Ref, Status: committerpb.Status_ABORTED_MVCC_CONFLICT,
+			})
+			continue
+		}
+		for p := range preds {
+			if !p.pruned { // a pruned node left the window (the last writer of a key is kept for ww): no edge
+				p.succ[n] = struct{}{}
+			}
+		}
+		for s := range succs {
+			n.succ[s] = struct{}{}
+		}
+		i := len(pend)
+		pend, acc, keep, staleRead = append(pend, n), append(acc, a), append(keep, tx), append(staleRead, stale)
+		for k := range a.reads {
+			pr[k] = append(pr[k], pend[i])
+		}
+		for k := range a.writes {
+			pw[k] = append(pw[k], pend[i])
+		}
+	}
+
+	// Algorithm 3: topological order of the accepted transactions (ties: arrival order).
+	idx := make(map[*fsNode]int, len(pend))
+	for i, n := range pend {
+		idx[n] = i
+	}
+	indeg := make([]int, len(pend))
+	for _, n := range pend {
+		for s := range n.succ {
+			if j, ok := idx[s]; ok {
+				indeg[j]++
+			}
+		}
+	}
+	order := make([]int, 0, len(pend))
+	ready := []int{}
+	for i := range pend {
+		if indeg[i] == 0 {
+			ready = append(ready, i)
+		}
+	}
+	for len(ready) > 0 {
+		sort.Ints(ready)
+		i := ready[0]
+		ready = ready[1:]
+		order = append(order, i)
+		for s := range pend[i].succ {
+			if j, ok := idx[s]; ok {
+				if indeg[j]--; indeg[j] == 0 {
+					ready = append(ready, j)
+				}
+			}
+		}
+	}
+	if len(order) != len(pend) { // cannot happen: Algorithm 2 keeps the graph acyclic
+		panic("FabricSharp: cyclic pending schedule")
+	}
+
+	// restore c-ww in commit order and commit
+	lastW := map[string]*fsNode{}
+	out := make([]*servicepb.TxWithRef, 0, len(passthrough)+len(order))
+	out = append(out, passthrough...)
+	for _, i := range order {
+		n, a := pend[i], acc[i]
+		for k := range a.writes {
+			if p := lastW[k]; p != nil {
+				p.succ[n] = struct{}{}
+			}
+			lastW[k] = n
+		}
+		for k := range a.reads {
+			ks := f.keys[k]
+			ks.readers = append(ks.readers, n)
+		}
+		for k := range a.writes {
+			ks := f.keys[k]
+			if !ks.known {
+				ks.known, ks.cur = true, -1 // a blind write to a key never seen: created at version 0
+			}
+			ks.cur++
+			ks.writers = append(ks.writers, fsWriter{ver: ks.cur, n: n})
+		}
+		f.nodes = append(f.nodes, n)
+		tx := keep[i]
+		fsStripped.Store(tx.Ref.TxId, fsWithoutReads(tx.Content.Namespaces))
+		out = append(out, tx)
+		fsAcceptedCnt.Add(1)
+		if staleRead[i] {
+			fsStaleAcceptedCnt.Add(1)
+		}
+	}
+	blk.Txs = out
+
+	// prune nodes that left the window
+	j := 0
+	for j < len(f.nodes) && f.nodes[j].block < cutoff {
+		f.nodes[j].pruned, f.nodes[j].succ = true, nil
+		j++
+	}
+	f.nodes = f.nodes[j:]
+}
+
+// fsWithoutReads copies a transaction's namespaces for the validator-committer, dropping read versions.
+func fsWithoutReads(nss []*applicationpb.TxNamespace) []*applicationpb.TxNamespace {
+	out := make([]*applicationpb.TxNamespace, len(nss))
+	for i, ns := range nss {
+		c := &applicationpb.TxNamespace{NsId: ns.NsId, NsVersion: ns.NsVersion}
+		c.BlindWrites = append(c.BlindWrites, ns.BlindWrites...)
+		for _, rw := range ns.ReadWrites {
+			c.BlindWrites = append(c.BlindWrites, &applicationpb.Write{Key: rw.Key, Value: rw.Value})
+		}
+		out[i] = c
+	}
+	return out
+}
+
+// fsVCNamespaces returns the namespaces the validator-committer receives for a transaction.
+func fsVCNamespaces(tx *servicepb.TxWithRef) []*applicationpb.TxNamespace {
+	if FabricSharpOn && tx.Ref != nil {
+		if v, ok := fsStripped.LoadAndDelete(tx.Ref.TxId); ok {
+			return v.([]*applicationpb.TxNamespace) //nolint:forcetypeassert
+		}
+	}
+	return tx.Content.Namespaces
+}
diff --git a/service/coordinator/dependencygraph/epr_fabricsharp_orig.go b/service/coordinator/dependencygraph/epr_fabricsharp_orig.go
new file mode 100644
index 0000000..285daaa
--- /dev/null
+++ b/service/coordinator/dependencygraph/epr_fabricsharp_orig.go
@@ -0,0 +1,200 @@
+/*
+Baseline (not upstream): FabricSharp (Ruan et al., SIGMOD'20) with the authors' scheduler
+(fabricsharp/sharpscheduler and fabricsharp/common, branch sigmod20, ported unchanged; see
+port_orig_baselines.py): Bloom-filter reachability with relay filters, LevelDB indices of committed reads
+and writes, max_span = TXN_SPAN_LIMIT (default 10, as in the paper's experiments). FX_FABRICSHARP=1
+selects it; FX_FABRICSHARP=exact keeps the idealized reimplementation of epr_fabricsharp.go.
+
+Glue, the counterpart of the original orderer's blockcutter (scheduleMsg / Cut): every block is one cut.
+Its transactions go through ProcessTxn in block order and ProcessBlk returns the commit order. A transaction
+ProcessTxn refuses (snapshot older than max_span, a cycle, or a Bloom false positive between pending
+transactions, "DESERT") is aborted early with ABORTED_MVCC_CONFLICT. Non-endorser transactions (system
+namespaces) are put ahead, as in the original.
+
+Snapshot. FabricSharp's peers record, as the block number of every read version, the height of the snapshot
+the transaction was simulated against (snapshotbasedtxmgr/helper.go); the orderer takes it as the
+transaction's snapshot. Fabric-X versions are per-key counters, so the endorser carries its snapshot height
+in a blind write to "fssnap:<tx hash>" (FX_FS_SNAP=1, code/evm/patch_fs_snapshot.py), which is stripped
+before validation. The endorser reads its height before it opens its state snapshot, which can therefore be
+newer; the snapshot used is the larger of that height and the commit block of every version read. Both
+bound the true snapshot from below, and no read key was written between them and the true snapshot (the
+version read would be newer), so the dependencies are those of the true snapshot.
+*/
+
+package dependencygraph
+
+import (
+	"bytes"
+	"encoding/hex"
+	"os"
+	"strconv"
+	"strings"
+	"sync/atomic"
+
+	"github.com/hyperledger/fabric-x-common/api/applicationpb"
+	"github.com/hyperledger/fabric-x-common/api/committerpb"
+
+	"github.com/hyperledger/fabric-x-committer/api/servicepb"
+	"github.com/hyperledger/fabric-x-committer/service/coordinator/dependencygraph/fabricsharp/sharpscheduler"
+)
+
+const fsSnapPrefix = "fssnap:"
+
+var (
+	fsOrig                                   *sharpscheduler.TxnScheduler
+	fsOrigSpan                               = fsOrigSpanLimit()
+	fsHist                                   = map[string]*fsVerHist{}
+	fsSpanDroppedCnt, fsNoSnapCnt, fsLastBlk atomic.Int64
+)
+
+// fsOrigSpanLimit is the original's GetFSharpTxnSpanLimitWithDefault.
+func fsOrigSpanLimit() uint64 {
+	if limit, err := strconv.Atoi(os.Getenv("TXN_SPAN_LIMIT")); err == nil && limit > 0 {
+		return uint64(limit)
+	}
+	return 10
+}
+
+// fsVerHist maps the versions of a key to the blocks that committed them: version base+1+i was committed in
+// blocks[i]; older versions count as committed in block 0.
+type fsVerHist struct {
+	base   int64
+	blocks []uint64
+}
+
+func (h *fsVerHist) blockOf(v int64) uint64 {
+	if i := v - h.base - 1; i >= 0 && i < int64(len(h.blocks)) {
+		return h.blocks[i]
+	}
+	return 0
+}
+
+// fsOrigTx extracts what the original's scheduleMsg extracts from a Fabric envelope.
+func fsOrigTx(tx *servicepb.TxWithRef) (reads map[string]int64, writes []string, snap int64, ok bool) {
+	reads, snap = map[string]int64{}, -1
+	if tx.Content == nil || tx.Ref == nil {
+		return nil, nil, 0, false
+	}
+	for _, ns := range tx.Content.Namespaces {
+		if ns.NsId == committerpb.MetaNamespaceID || ns.NsId == committerpb.ConfigNamespaceID {
+			return nil, nil, 0, false
+		}
+		for _, r := range ns.ReadsOnly {
+			reads[fsOrigKey(ns.NsId, r.Key)] = fsVer(r.Version)
+		}
+		for _, rw := range ns.ReadWrites {
+			k := fsOrigKey(ns.NsId, rw.Key)
+			reads[k] = fsVer(rw.Version)
+			writes = append(writes, k)
+		}
+		for _, w := range ns.BlindWrites {
+			if strings.HasPrefix(string(w.Key), fsSnapPrefix) {
+				if h, err := strconv.ParseInt(string(w.Value), 10, 64); err == nil {
+					snap = h
+				}
+				continue
+			}
+			writes = append(writes, fsOrigKey(ns.NsId, w.Key))
+		}
+	}
+	return reads, writes, snap, true
+}
+
+// fsOrigKey qualifies a key with its namespace for the original scheduler, whose LevelDB indices use 0x00 as
+// separator (Fabric chaincode keys contain none): keys containing 0x00 are hex-encoded.
+func fsOrigKey(ns string, k []byte) string {
+	if bytes.IndexByte(k, 0) < 0 {
+		return ns + "/" + string(k)
+	}
+	return ns + "/0x" + hex.EncodeToString(k)
+}
+
+func fabricSharpOrigBlock(blk *servicepb.CoordinatorBatch) {
+	blockNum := blk.Txs[0].Ref.BlockNum
+	if fsOrig == nil {
+		fsOrig = sharpscheduler.NewTxnScheduler(fsOrigSpan, "/tmp/d16_fabricsharp_store")
+	}
+	fsLastBlk.Store(int64(blockNum)) //nolint:gosec
+	var passthrough []*servicepb.TxWithRef
+	pending := make(map[string]*servicepb.TxWithRef, len(blk.Txs))
+	pendingWrites := make(map[string][]string, len(blk.Txs))
+	for _, tx := range blk.Txs {
+		reads, writes, snap, ok := fsOrigTx(tx)
+		if !ok {
+			passthrough = append(passthrough, tx)
+			continue
+		}
+		readKeys := make([]string, 0, len(reads))
+		snapshot := blockNum // no read keys: the original sets the snapshot to the next block height
+		if len(reads) > 0 {
+			if snap < 0 {
+				fsNoSnapCnt.Add(1)
+				snap = 0
+			}
+			s := uint64(snap) //nolint:gosec
+			for k, v := range reads {
+				readKeys = append(readKeys, k)
+				h := fsHist[k]
+				if h == nil || v > h.base+int64(len(h.blocks)) { // first sight, or versions we did not see
+					fsHist[k] = &fsVerHist{base: v}
+					continue
+				}
+				if b := h.blockOf(v); b > s {
+					s = b
+				}
+			}
+			snapshot = s
+		}
+		if fsOrigSpan < blockNum && snapshot < blockNum-fsOrigSpan {
+			fsSpanDroppedCnt.Add(1)
+		}
+		if fsOrig.ProcessTxn(readKeys, writes, snapshot, blockNum, tx.Ref.TxId) {
+			pending[tx.Ref.TxId] = tx
+			pendingWrites[tx.Ref.TxId] = writes
+			continue
+		}
+		fsAbortedCnt.Add(1)
+		blk.Rejected = append(blk.Rejected, &committerpb.TxStatus{
+			Ref: tx.Ref, Status: committerpb.Status_ABORTED_MVCC_CONFLICT,
+		})
+	}
+	schedule := fsOrig.ProcessBlk(blockNum)
+	out := make([]*servicepb.TxWithRef, 0, len(passthrough)+len(schedule))
+	out = append(out, passthrough...)
+	for _, id := range schedule {
+		tx := pending[id]
+		for _, k := range pendingWrites[id] { // every scheduled write commits (no concurrency validation)
+			if h := fsHist[k]; h != nil {
+				h.blocks = append(h.blocks, blockNum)
+				if len(h.blocks) > 64 && h.blocks[0]+fsOrigSpan+2 < blockNum { // blocks before the span no longer matter
+					i := 0
+					for i < len(h.blocks) && h.blocks[i]+fsOrigSpan+2 < blockNum {
+						i++
+					}
+					h.base += int64(i)
+					h.blocks = append([]uint64(nil), h.blocks[i:]...)
+				}
+			}
+		}
+		fsStripped.Store(id, fsOrigVCNamespaces(tx.Content.Namespaces))
+		out = append(out, tx)
+		fsAcceptedCnt.Add(1)
+	}
+	blk.Txs = out
+}
+
+// fsOrigVCNamespaces copies a transaction's namespaces for the validator-committer without read versions
+// (FabricSharp validates no concurrency at peers) and without the snapshot carrier.
+func fsOrigVCNamespaces(nss []*applicationpb.TxNamespace) []*applicationpb.TxNamespace {
+	out := fsWithoutReads(nss)
+	for _, ns := range out {
+		w := ns.BlindWrites[:0]
+		for _, x := range ns.BlindWrites {
+			if !strings.HasPrefix(string(x.Key), fsSnapPrefix) {
+				w = append(w, x)
+			}
+		}
+		ns.BlindWrites = w
+	}
+	return out
+}
diff --git a/service/coordinator/dependencygraph/epr_fabricsharp_orig_test.go b/service/coordinator/dependencygraph/epr_fabricsharp_orig_test.go
new file mode 100644
index 0000000..8cb3102
--- /dev/null
+++ b/service/coordinator/dependencygraph/epr_fabricsharp_orig_test.go
@@ -0,0 +1,107 @@
+package dependencygraph
+
+// Baseline: glue of the authors' FabricSharp scheduler (epr_fabricsharp_orig.go).
+
+import (
+	"strconv"
+	"testing"
+
+	"github.com/hyperledger/fabric-x-common/api/applicationpb"
+	"github.com/stretchr/testify/require"
+
+	"github.com/hyperledger/fabric-x-committer/api/servicepb"
+)
+
+// fsSnapTx is fsTx with the endorser's snapshot height carried as in patch_fs_snapshot.py.
+func fsSnapTx(block uint64, num uint32, id string, snap int, op fsOp) *servicepb.TxWithRef {
+	tx := fsTx(block, num, id, op)
+	ns := tx.Content.Namespaces[0]
+	ns.BlindWrites = append(ns.BlindWrites, &applicationpb.Write{
+		Key: []byte(fsSnapPrefix + id), Value: []byte(strconv.Itoa(snap)),
+	})
+	return tx
+}
+
+func fsOrigReset() {
+	fsOrig, fsHist = nil, map[string]*fsVerHist{}
+}
+
+func TestFabricSharpOrig(t *testing.T) {
+	on, exact := FabricSharpOn, fsExact
+	FabricSharpOn, fsExact = true, false
+	defer func() { FabricSharpOn, fsExact = on, exact; fsOrigReset() }()
+
+	t.Run("hot-key read-modify-write keeps one per block", func(t *testing.T) {
+		fsOrigReset()
+		kept, aborted := fsRun(t, 1,
+			fsSnapTx(1, 0, "a", 0, fsOp{rmw: map[string]int64{"k": 5}}),
+			fsSnapTx(1, 1, "b", 0, fsOp{rmw: map[string]int64{"k": 5}}),
+			fsSnapTx(1, 2, "c", 0, fsOp{rmw: map[string]int64{"k": 5}}))
+		require.Equal(t, []string{"a"}, kept)
+		require.Equal(t, []string{"b", "c"}, aborted)
+	})
+
+	t.Run("snapshot older than max_span is dropped", func(t *testing.T) {
+		fsOrigReset()
+		kept, aborted := fsRun(t, 30,
+			fsSnapTx(30, 0, "old", 3, fsOp{read: map[string]int64{"x": 0}, write: []string{"y"}}),
+			fsSnapTx(30, 1, "new", 25, fsOp{read: map[string]int64{"x": 0}, write: []string{"z"}}))
+		require.Equal(t, []string{"new"}, kept)
+		require.Equal(t, []string{"old"}, aborted)
+	})
+
+	t.Run("a version committed after the carried height raises the snapshot", func(t *testing.T) {
+		fsOrigReset()
+		fsRun(t, 1, fsSnapTx(1, 0, "seed", 0, fsOp{rmw: map[string]int64{"k": 0}})) // k: version 1 in block 1
+		fsRun(t, 15, fsSnapTx(15, 0, "w", 14, fsOp{rmw: map[string]int64{"k": 1}})) // k: version 2 in block 15
+		// r read version 2, so its snapshot is at least block 15 whatever its carried height says
+		kept, _ := fsRun(t, 22, fsSnapTx(22, 0, "r", 3, fsOp{read: map[string]int64{"k": 2}, write: []string{"q"}}))
+		require.Equal(t, []string{"r"}, kept, "snapshot = block 15 >= 22-10, although the carrier says 3")
+	})
+
+	t.Run("validator sees no reads and no snapshot carrier", func(t *testing.T) {
+		fsOrigReset()
+		tx := fsSnapTx(1, 0, "s", 0, fsOp{read: map[string]int64{"A": 0}, rmw: map[string]int64{"B": 0}})
+		kept, _ := fsRun(t, 1, tx)
+		require.Equal(t, []string{"s"}, kept)
+		ns := fsVCNamespaces(tx)
+		require.Empty(t, ns[0].ReadsOnly)
+		require.Empty(t, ns[0].ReadWrites)
+		require.Len(t, ns[0].BlindWrites, 1)
+		require.Equal(t, "B", string(ns[0].BlindWrites[0].Key))
+	})
+
+	t.Run("write skew through a committed transaction aborts", func(t *testing.T) {
+		fsOrigReset()
+		fsRun(t, 1, fsSnapTx(1, 0, "t1", 0, fsOp{read: map[string]int64{"B": 0}, rmw: map[string]int64{"A": 0}}))
+		// t2 simulated at block 0 (before t1): reads A (t1 overwrote it) and writes B (t1 read it)
+		kept, aborted := fsRun(t, 2, fsSnapTx(2, 0, "t2", 0, fsOp{read: map[string]int64{"A": 0}, rmw: map[string]int64{"B": 0}}))
+		require.Empty(t, kept)
+		require.Equal(t, []string{"t2"}, aborted)
+	})
+
+	t.Run("random hot-key stress: no panic, every transaction kept or aborted", func(t *testing.T) {
+		fsOrigReset()
+		rnd := uint64(42)
+		next := func(n int) int { rnd = rnd*6364136223846793005 + 1442695040888963407; return int(rnd>>33) % n }
+		for b := uint64(1); b <= 300; b++ {
+			var txs []*servicepb.TxWithRef
+			for i := 0; i < 20; i++ {
+				op := fsOp{read: map[string]int64{}, rmw: map[string]int64{}}
+				for j := 0; j < 2; j++ {
+					k := string(rune('A' + next(6)))
+					if next(2) == 0 {
+						op.read[k] = int64(next(3))
+					} else {
+						op.rmw[k] = int64(next(3))
+					}
+				}
+				snap := int(b) - 1 - next(3)
+				txs = append(txs, fsSnapTx(b, uint32(i), "t"+strconv.Itoa(int(b))+"_"+strconv.Itoa(i), snap, op)) //nolint:gosec
+			}
+			blk := &servicepb.CoordinatorBatch{Txs: txs}
+			require.NotPanics(t, func() { FabricSharpBlock(blk) })
+			require.Equal(t, 20, len(blk.Txs)+len(blk.Rejected))
+		}
+	})
+}
diff --git a/service/coordinator/dependencygraph/epr_fabricsharp_test.go b/service/coordinator/dependencygraph/epr_fabricsharp_test.go
new file mode 100644
index 0000000..122c472
--- /dev/null
+++ b/service/coordinator/dependencygraph/epr_fabricsharp_test.go
@@ -0,0 +1,154 @@
+package dependencygraph
+
+import (
+	"testing"
+
+	"github.com/hyperledger/fabric-x-common/api/applicationpb"
+	"github.com/hyperledger/fabric-x-common/api/committerpb"
+	"github.com/stretchr/testify/require"
+
+	"github.com/hyperledger/fabric-x-committer/api/servicepb"
+)
+
+type fsOp struct {
+	read  map[string]int64 // key -> version read (-1: absent)
+	write []string
+	rmw   map[string]int64 // read-modify-write
+}
+
+func fsTx(block uint64, num uint32, id string, op fsOp) *servicepb.TxWithRef {
+	ns := &applicationpb.TxNamespace{NsId: "basic"}
+	ver := func(v int64) *uint64 {
+		if v < 0 {
+			return nil
+		}
+		u := uint64(v) //nolint:gosec
+		return &u
+	}
+	for k, v := range op.read {
+		ns.ReadsOnly = append(ns.ReadsOnly, &applicationpb.Read{Key: []byte(k), Version: ver(v)})
+	}
+	for k, v := range op.rmw {
+		ns.ReadWrites = append(ns.ReadWrites, &applicationpb.ReadWrite{Key: []byte(k), Version: ver(v), Value: []byte("x")})
+	}
+	for _, k := range op.write {
+		ns.BlindWrites = append(ns.BlindWrites, &applicationpb.Write{Key: []byte(k), Value: []byte("x")})
+	}
+	return &servicepb.TxWithRef{
+		Ref:     &committerpb.TxRef{BlockNum: block, TxNum: num, TxId: id},
+		Content: &applicationpb.Tx{Namespaces: []*applicationpb.TxNamespace{ns}},
+	}
+}
+
+func fsRun(t *testing.T, block uint64, txs ...*servicepb.TxWithRef) (kept []string, aborted []string) {
+	t.Helper()
+	blk := &servicepb.CoordinatorBatch{Txs: txs}
+	FabricSharpBlock(blk)
+	for _, tx := range blk.Txs {
+		kept = append(kept, tx.Ref.TxId)
+	}
+	for _, r := range blk.Rejected {
+		aborted = append(aborted, r.Ref.TxId)
+	}
+	return kept, aborted
+}
+
+func TestFabricSharp(t *testing.T) {
+	on, exact := FabricSharpOn, fsExact
+	FabricSharpOn, fsExact = true, true // the idealized reimplementation (FX_FABRICSHARP=exact)
+	defer func() { FabricSharpOn, fsExact = on, exact }()
+	t.Run("hot-key read-modify-write keeps one per version", func(t *testing.T) {
+		fsState = newFabricSharp()
+		kept, aborted := fsRun(t, 1,
+			fsTx(1, 0, "a", fsOp{rmw: map[string]int64{"k": 5}}),
+			fsTx(1, 1, "b", fsOp{rmw: map[string]int64{"k": 5}}),
+			fsTx(1, 2, "c", fsOp{rmw: map[string]int64{"k": 5}}))
+		require.Equal(t, []string{"a"}, kept)
+		require.Equal(t, []string{"b", "c"}, aborted)
+		// next block: a stale read-modify-write (read 5, a wrote 6) is a lost update
+		kept, aborted = fsRun(t, 2, fsTx(2, 0, "d", fsOp{rmw: map[string]int64{"k": 5}}),
+			fsTx(2, 1, "e", fsOp{rmw: map[string]int64{"k": 6}}))
+		require.Equal(t, []string{"e"}, kept)
+		require.Equal(t, []string{"d"}, aborted)
+	})
+
+	t.Run("stale read without cycle is serialized before the overwriter", func(t *testing.T) {
+		fsState = newFabricSharp()
+		_, aborted := fsRun(t, 1, fsTx(1, 0, "w", fsOp{rmw: map[string]int64{"A": 0}})) // A: 0 -> 1
+		require.Empty(t, aborted)
+		// reads A at the old version 0 and writes B: serializable before w (Fabric/Fabric++ would abort)
+		kept, aborted := fsRun(t, 2, fsTx(2, 0, "s", fsOp{read: map[string]int64{"A": 0}, rmw: map[string]int64{"B": 0}}))
+		require.Equal(t, []string{"s"}, kept)
+		require.Empty(t, aborted)
+		ns := fsVCNamespaces(fsTx(2, 0, "s", fsOp{}))
+		require.Empty(t, ns[0].ReadsOnly)
+		require.Empty(t, ns[0].ReadWrites)
+		require.Len(t, ns[0].BlindWrites, 1)
+	})
+
+	t.Run("write skew cycle through a committed transaction aborts", func(t *testing.T) {
+		fsState = newFabricSharp()
+		// t1 reads B@0 and writes A; committed
+		fsRun(t, 1, fsTx(1, 0, "t1", fsOp{read: map[string]int64{"B": 0}, rmw: map[string]int64{"A": 0}}))
+		// t2 read A@0 (stale: t1 wrote A) and writes B (t1 read B): t2 -> t1 (anti-rw), t1 -> t2 (rw)
+		kept, aborted := fsRun(t, 2, fsTx(2, 0, "t2", fsOp{read: map[string]int64{"A": 0}, rmw: map[string]int64{"B": 0}}))
+		require.Empty(t, kept)
+		require.Equal(t, []string{"t2"}, aborted)
+	})
+
+	t.Run("last writer that left the window is not given new edges", func(t *testing.T) {
+		fsState = newFabricSharp()
+		fsRun(t, 1, fsTx(1, 0, "w", fsOp{rmw: map[string]int64{"k": 0}})) // k: 0 -> 1
+		for b := uint64(2); b < 2+fsWindowBlocks+2; b++ {                 // unrelated blocks: w leaves the window
+			fsRun(t, b, fsTx(b, 0, "x"+string(rune('a'+b)), fsOp{rmw: map[string]int64{"other": int64(b - 2)}}))
+		}
+		b := uint64(2 + fsWindowBlocks + 2)
+		kept, aborted := fsRun(t, b, fsTx(b, 0, "late", fsOp{rmw: map[string]int64{"k": 1}}))
+		require.Equal(t, []string{"late"}, kept)
+		require.Empty(t, aborted)
+	})
+
+	t.Run("random hot-key stress: no panic, accepted schedules stay acyclic", func(t *testing.T) {
+		fsState = newFabricSharp()
+		rnd := uint64(42)
+		next := func(n int) int { rnd = rnd*6364136223846793005 + 1442695040888963407; return int(rnd>>33) % n }
+		ver := map[string]int64{}
+		for b := uint64(1); b <= 2000; b++ {
+			var txs []*servicepb.TxWithRef
+			for i := 0; i < 20; i++ {
+				op := fsOp{read: map[string]int64{}, rmw: map[string]int64{}}
+				for j := 0; j < 2; j++ {
+					k := string(rune('A' + next(4))) // 4 hot keys
+					stale := int64(next(3))          // read 0-2 versions behind
+					v := ver[k] - stale
+					if v < 0 {
+						v = 0
+					}
+					if next(2) == 0 {
+						op.read[k] = v
+					} else {
+						op.rmw[k] = v
+					}
+				}
+				txs = append(txs, fsTx(b, uint32(i), "t"+string(rune(b))+string(rune(i)), op)) //nolint:gosec
+			}
+			blk := &servicepb.CoordinatorBatch{Txs: txs}
+			require.NotPanics(t, func() { FabricSharpBlock(blk) })
+			require.Equal(t, 20, len(blk.Txs)+len(blk.Rejected))
+			for _, tx := range blk.Txs { // advance the versions the accepted transactions wrote
+				for _, rw := range tx.Content.Namespaces[0].ReadWrites {
+					ver[string(rw.Key)]++
+				}
+			}
+		}
+	})
+
+	t.Run("pending reader is ordered before a pending blind writer", func(t *testing.T) {
+		fsState = newFabricSharp()
+		kept, aborted := fsRun(t, 1,
+			fsTx(1, 0, "w", fsOp{write: []string{"k"}}),
+			fsTx(1, 1, "r", fsOp{read: map[string]int64{"k": 3}, write: []string{"j"}}))
+		require.Empty(t, aborted)
+		require.Equal(t, []string{"r", "w"}, kept)
+	})
+}
diff --git a/service/coordinator/dependencygraph/epr_fpp_orig.go b/service/coordinator/dependencygraph/epr_fpp_orig.go
new file mode 100644
index 0000000..a81093b
--- /dev/null
+++ b/service/coordinator/dependencygraph/epr_fpp_orig.go
@@ -0,0 +1,94 @@
+/*
+Baseline (not upstream): Fabric++ (Sharma et al., SIGMOD'19) with the original scheduler shipped with
+FabricSharp (fabricsharp/fppscheduler, ported unchanged; see port_orig_baselines.py). HTFabric (CIKM'24)
+uses the same code as Fabric++, whose authors did not publish theirs.
+
+Glue, the counterpart of the original orderer's blockcutter: every block is one cut. Its transactions go
+through ScheduleTxn in block order with their (ns-qualified) read keys, the versions read and their write
+keys; ProcessBlk returns the commit order. Transactions left out of it (cycle victims, or a block exceeding
+the scheduler's key capacity) are aborted early; the scheduler's in-block "invalid" transactions (two
+reads of different versions of a key) stay in the block, as in the original, and the validator decides.
+Fabric-X versions are per-key counters: version v becomes {BlockNum: v+1}, an absent key {0, 0}, which keeps
+the only property the scheduler uses (equality).
+*/
+
+package dependencygraph
+
+import (
+	"github.com/hyperledger/fabric-x-common/api/committerpb"
+
+	"github.com/hyperledger/fabric-x-committer/api/servicepb"
+	"github.com/hyperledger/fabric-x-committer/service/coordinator/dependencygraph/fabricsharp/fppscheduler"
+)
+
+func eprFppOrig(txs []*servicepb.TxWithRef) ([]*servicepb.TxWithRef, map[int]bool) {
+	if len(txs) < 2 {
+		return txs, nil
+	}
+	s := fppscheduler.NewTxnScheduler(uint32(len(txs))) //nolint:gosec
+	var passthrough []*servicepb.TxWithRef
+	byID := make(map[string]*servicepb.TxWithRef, len(txs))
+	var order []string // arrival order of the scheduled ones
+	rejected := map[string]bool{}
+	for _, tx := range txs {
+		if tx.Content == nil || tx.Ref == nil {
+			passthrough = append(passthrough, tx)
+			continue
+		}
+		system := false
+		var reads []fppscheduler.Read
+		var writes []string
+		for _, ns := range tx.Content.Namespaces {
+			if ns.NsId == committerpb.MetaNamespaceID || ns.NsId == committerpb.ConfigNamespaceID {
+				system = true
+				break
+			}
+			for _, rw := range ns.ReadWrites {
+				k := constructCompositeKey(ns.NsId, rw.Key)
+				writes = append(writes, k)
+				reads = append(reads, fppscheduler.Read{Key: k, Version: fppVersion(rw.Version)})
+			}
+			for _, w := range ns.BlindWrites {
+				writes = append(writes, constructCompositeKey(ns.NsId, w.Key))
+			}
+			for _, r := range ns.ReadsOnly {
+				reads = append(reads, fppscheduler.Read{Key: constructCompositeKey(ns.NsId, r.Key), Version: fppVersion(r.Version)})
+			}
+		}
+		if system {
+			passthrough = append(passthrough, tx) // non-endorser transactions are put ahead, as in the original
+			continue
+		}
+		id := tx.Ref.TxId
+		byID[id] = tx
+		order = append(order, id)
+		if !s.ScheduleTxn(reads, writes, 0, id) {
+			rejected[id] = true
+		}
+	}
+	schedule := s.ProcessBlk(0)
+	res := make([]*servicepb.TxWithRef, 0, len(txs))
+	res = append(res, passthrough...)
+	in := make(map[string]bool, len(schedule))
+	for _, id := range schedule {
+		in[id] = true
+		res = append(res, byID[id])
+	}
+	abortIdx := map[int]bool{}
+	for _, id := range order {
+		if !in[id] {
+			abortIdx[len(res)] = true
+			res = append(res, byID[id])
+		}
+	}
+	eprReorderBatches.Add(1)
+	eprReorderAborted.Add(int64(len(abortIdx)))
+	return res, abortIdx
+}
+
+func fppVersion(v *uint64) *fppscheduler.Version {
+	if v == nil {
+		return &fppscheduler.Version{}
+	}
+	return &fppscheduler.Version{BlockNum: *v + 1}
+}
diff --git a/service/coordinator/dependencygraph/epr_fpp_orig_test.go b/service/coordinator/dependencygraph/epr_fpp_orig_test.go
