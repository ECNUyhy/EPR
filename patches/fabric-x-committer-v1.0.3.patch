+var eprDepGraph = os.Getenv("FX_EPR2") == "1"
+
+// eprNoGuardDG (FX_EPR_NOGUARD): baseline in which all deltas commute, guards ignored.
+var eprNoGuardDG = os.Getenv("FX_EPR_NOGUARD") == "1"
+
+// eprCommutes reports whether a read-write value is an unconditional guarded delta, i.e. a credit
+// whose lower bound is MinInt64 and therefore can never fail. Only credits commute:
+// a debit's guard outcome depends on order, so debits keep ordinary read-write dependencies, which
+// keeps guard decisions in ledger order (deterministic across committers).
+//
+// EVM endorsers emit EPRD2 ("EPRD2" | delta | lower | upper | width): a credit there is delta >= 0,
+// lower <= delta and no upper bound, which can never fail on a non-negative stored word (the VC
+// range-checks the word); it must match the VC's eprIsCredit2. As in the VC, EPRD2 is recognized on
+// storage keys (k) only.
+func eprCommutes(k, v []byte) bool {
+	if !eprDepGraph {
+		return false
+	}
+	if len(v) == 21 && bytes.HasPrefix(v, []byte("EPRD1")) {
+		return bytes.Equal(v[13:], []byte{0x80, 0, 0, 0, 0, 0, 0, 0})
+	}
+	if len(v) == 30 && bytes.HasPrefix(v, []byte("EPRD2")) && eprStorageKey(k) {
+		if eprNoGuardDG { // FabricCRDT-style baseline: every delta is an unguarded counter update
+			return true
+		}
+		be := func(b []byte) int64 {
+			var x uint64
+			for _, c := range b {
+				x = x<<8 | uint64(c)
+			}
+			return int64(x) //nolint:gosec
+		}
+		d, l, u := be(v[5:13]), be(v[13:21]), be(v[21:29])
+		return d >= 0 && l <= d && u == 1<<63-1
+	}
+	return false
+}
