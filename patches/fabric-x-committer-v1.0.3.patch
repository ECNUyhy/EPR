@@ -0,0 +1,50 @@
+package dependencygraph
+
+// Baseline: glue of the original Fabric++ scheduler (epr_fpp_orig.go).
+
+import (
+	"testing"
+
+	"github.com/hyperledger/fabric-x-common/api/applicationpb"
+	"github.com/hyperledger/fabric-x-common/api/committerpb"
+	"github.com/stretchr/testify/require"
+
+	"github.com/hyperledger/fabric-x-committer/api/servicepb"
+)
+
+func TestFppOrig(t *testing.T) {
+	keys := makeTestKeys(t, 1)
+	t.Run("reader is scheduled before the writer", func(t *testing.T) {
+		writer := createTxForTest(t, 0, nsID1ForTest, nil, [][]byte{keys[0]}, nil)
+		reader := createTxForTest(t, 1, nsID1ForTest, [][]byte{keys[0]}, nil, nil)
+		out, aborted := eprFppOrig([]*servicepb.TxWithRef{writer, reader})
+		require.Empty(t, aborted)
+		require.Equal(t, []*servicepb.TxWithRef{reader, writer}, out)
+	})
+	t.Run("read-modify-write cycle aborts one transaction", func(t *testing.T) {
+		a := createTxForTest(t, 0, nsID1ForTest, nil, [][]byte{keys[0]}, nil)
+		b := createTxForTest(t, 1, nsID1ForTest, nil, [][]byte{keys[0]}, nil)
+		out, aborted := eprFppOrig([]*servicepb.TxWithRef{a, b})
+		require.Len(t, out, 2)
+		require.Equal(t, map[int]bool{1: true}, aborted)
+	})
+	t.Run("different versions of a key read in a block stay for the validator", func(t *testing.T) {
+		v4, v5 := uint64(4), uint64(5)
+		a := createTxForTest(t, 0, nsID1ForTest, [][]byte{keys[0]}, nil, nil)
+		b := createTxForTest(t, 1, nsID1ForTest, [][]byte{keys[0]}, nil, nil)
+		a.Content.Namespaces[0].ReadsOnly[0].Version = &v5
+		b.Content.Namespaces[0].ReadsOnly[0].Version = &v4
+		out, aborted := eprFppOrig([]*servicepb.TxWithRef{a, b})
+		require.Empty(t, aborted)
+		require.ElementsMatch(t, []*servicepb.TxWithRef{a, b}, out)
+	})
+	t.Run("system transactions are put ahead", func(t *testing.T) {
+		w := createTxForTest(t, 0, nsID1ForTest, nil, [][]byte{keys[0]}, nil)
+		r := createTxForTest(t, 1, nsID1ForTest, [][]byte{keys[0]}, nil, nil)
+		sys := &servicepb.TxWithRef{Ref: createTxForTest(t, 2, nsID1ForTest, nil, nil, nil).Ref, Content: &applicationpb.Tx{
+			Namespaces: []*applicationpb.TxNamespace{{NsId: committerpb.MetaNamespaceID}},
+		}}
+		out, _ := eprFppOrig([]*servicepb.TxWithRef{w, r, sys})
+		require.Equal(t, sys, out[0])
+	})
+}
diff --git a/service/coordinator/dependencygraph/epr_reorder.go b/service/coordinator/dependencygraph/epr_reorder.go
new file mode 100644
index 0000000..03b9480
--- /dev/null
+++ b/service/coordinator/dependencygraph/epr_reorder.go
@@ -0,0 +1,246 @@
+/*
+Baseline (not upstream): Fabric++ in-block reordering with early abort (Sharma et al., SIGMOD'19), in the
+Fabric-X coordinator. FX_REORDER=1 runs the original Fabric++ scheduler shipped with FabricSharp
+(epr_fpp_orig.go; the authors of Fabric++ did not publish theirs). FX_REORDER=own runs the
+reimplementation below, where the transactions of every incoming batch (one block) are reordered before
+dependency construction:
+
+  1. conflict graph: Ti -> Tj (Ti must precede Tj) if Ti reads a key that Tj writes; placing a reader
+     after a writer of the same block would make its read stale;
+  2. cycle breaking: within every strongly connected component with more than one transaction, the
+     transaction with the most conflict edges inside the component is aborted early (ties: the later one)
+     until no cycle remains;
+  3. the remaining transactions are topologically sorted (ties: original order); aborted ones keep their
+     position and carry ABORTED_MVCC_CONFLICT, as a validator would assign.
+
+The procedure is deterministic, so all committers reorder identically.
+*/
+
+package dependencygraph
+
+import (
+	"os"
+	"sort"
+	"sync/atomic"
+	"time"
+
+	"github.com/hyperledger/fabric-x-common/api/committerpb"
+
+	"github.com/hyperledger/fabric-x-committer/api/servicepb"
+)
+
+var (
+	eprReorderOn                         = os.Getenv("FX_REORDER") == "1" || eprReorderOwn
+	eprReorderOwn                        = os.Getenv("FX_REORDER") == "own"
+	eprReorderAborted, eprReorderBatches atomic.Int64
+)
+
+func init() {
+	if !eprReorderOn {
+		return
+	}
+	go func() {
+		for range time.Tick(5 * time.Second) {
+			logger.Infof("PILOT_REORDER batches=%d early_aborted=%d", eprReorderBatches.Load(), eprReorderAborted.Load())
+		}
+	}()
+}
+
+// eprReorder returns the batch's transactions in the order Fabric++ would commit them and the indices
+// (into the returned slice) of the transactions it aborts early.
+func eprReorder(txs []*servicepb.TxWithRef) ([]*servicepb.TxWithRef, map[int]bool) {
+	if !eprReorderOwn {
+		return eprFppOrig(txs)
+	}
+	n := len(txs)
+	if n < 2 {
+		return txs, nil
+	}
+	reads := make([]map[string]bool, n)
+	writes := make([]map[string]bool, n)
+	readers := map[string][]int{}
+	for i, tx := range txs {
+		reads[i], writes[i] = map[string]bool{}, map[string]bool{}
+		if tx.Content == nil {
+			continue
+		}
+		for _, ns := range tx.Content.Namespaces {
+			for _, r := range ns.ReadsOnly {
+				reads[i][constructCompositeKey(ns.NsId, r.Key)] = true
+			}
+			for _, rw := range ns.ReadWrites {
+				k := constructCompositeKey(ns.NsId, rw.Key)
+				reads[i][k] = true
+				writes[i][k] = true
+			}
+			for _, w := range ns.BlindWrites {
+				writes[i][constructCompositeKey(ns.NsId, w.Key)] = true
+			}
+		}
+		for k := range reads[i] {
+			readers[k] = append(readers[k], i)
+		}
+	}
+	out := make([]map[int]bool, n) // i -> j: i must precede j
+	in := make([]map[int]bool, n)
+	for i := range out {
+		out[i], in[i] = map[int]bool{}, map[int]bool{}
+	}
+	for j := range txs {
+		for k := range writes[j] {
+			for _, i := range readers[k] {
+				if i != j {
+					out[i][j], in[j][i] = true, true
+				}
+			}
+		}
+	}
+	alive := make([]bool, n)
+	for i := range alive {
+		alive[i] = true
+	}
+	aborted := map[int]bool{}
+	for {
+		comps := eprSCC(n, alive, out)
+		cyclic := false
+		for _, c := range comps {
+			if len(c) < 2 {
+				continue
+			}
+			cyclic = true
+			inC := map[int]bool{}
+			for _, v := range c {
+				inC[v] = true
+			}
+			victim, best := -1, -1
+			for _, v := range c {
+				d := 0
+				for u := range out[v] {
+					if inC[u] {
+						d++
+					}
+				}
+				for u := range in[v] {
+					if inC[u] {
+						d++
+					}
+				}
+				if d > best || (d == best && v > victim) {
+					victim, best = v, d
+				}
+			}
+			alive[victim] = false
+			aborted[victim] = true
+		}
+		if !cyclic {
+			break
+		}
+	}
+	// Kahn's algorithm over the surviving transactions, ties broken by original position
+	indeg := make([]int, n)
+	for i := range txs {
+		if !alive[i] {
+			continue
+		}
+		for u := range in[i] {
+			if alive[u] {
+				indeg[i]++
+			}
+		}
+	}
+	var ready []int
+	for i := range txs {
+		if alive[i] && indeg[i] == 0 {
+			ready = append(ready, i)
+		}
+	}
+	order := make([]int, 0, n)
+	for len(ready) > 0 {
+		sort.Ints(ready)
+		v := ready[0]
+		ready = ready[1:]
+		order = append(order, v)
+		for u := range out[v] {
+			if alive[u] {
+				indeg[u]--
+				if indeg[u] == 0 {
+					ready = append(ready, u)
+				}
+			}
+		}
+	}
+	res := make([]*servicepb.TxWithRef, 0, n)
+	abortIdx := map[int]bool{}
+	for _, v := range order {
+		res = append(res, txs[v])
+	}
+	idx := make([]int, 0, len(aborted))
+	for v := range aborted {
+		idx = append(idx, v)
+	}
+	sort.Ints(idx)
+	for _, v := range idx {
+		abortIdx[len(res)] = true
+		res = append(res, txs[v])
+	}
+	eprReorderBatches.Add(1)
+	eprReorderAborted.Add(int64(len(aborted)))
+	return res, abortIdx
+}
+
+// eprSCC returns the strongly connected components of the alive vertices (Tarjan, iterative order by index).
+func eprSCC(n int, alive []bool, out []map[int]bool) [][]int {
+	index, low := make([]int, n), make([]int, n)
+	onStack := make([]bool, n)
+	for i := range index {
+		index[i] = -1
+	}
+	var stack []int
+	var comps [][]int
+	next := 0
+	var strong func(v int)
+	strong = func(v int) {
+		index[v], low[v] = next, next
+		next++
+		stack = append(stack, v)
+		onStack[v] = true
+		succ := make([]int, 0, len(out[v]))
+		for u := range out[v] {
+			succ = append(succ, u)
+		}
+		sort.Ints(succ)
+		for _, u := range succ {
+			if !alive[u] {
+				continue
+			}
+			if index[u] == -1 {
+				strong(u)
+				low[v] = min(low[v], low[u])
+			} else if onStack[u] {
+				low[v] = min(low[v], index[u])
+			}
+		}
+		if low[v] == index[v] {
+			var c []int
+			for {
+				w := stack[len(stack)-1]
+				stack = stack[:len(stack)-1]
+				onStack[w] = false
+				c = append(c, w)
+				if w == v {
+					break
+				}
+			}
+			comps = append(comps, c)
+		}
+	}
+	for v := 0; v < n; v++ {
+		if alive[v] && index[v] == -1 {
+			strong(v)
+		}
+	}
+	return comps
+}
+
+// eprEarlyAbortStatus is the status of a transaction Fabric++ aborts early.
+var eprEarlyAbortStatus = committerpb.Status_ABORTED_MVCC_CONFLICT
diff --git a/service/coordinator/dependencygraph/epr_reorder_test.go b/service/coordinator/dependencygraph/epr_reorder_test.go
new file mode 100644
index 0000000..ea25892
--- /dev/null
+++ b/service/coordinator/dependencygraph/epr_reorder_test.go
@@ -0,0 +1,37 @@
+package dependencygraph
+
+// Baseline: Fabric++-style reordering.
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/hyperledger/fabric-x-committer/api/servicepb"
+)
+
+func TestEPRReorderReadersBeforeWriters(t *testing.T) {
+	own := eprReorderOwn
+	eprReorderOwn = true // the reimplementation (FX_REORDER=own)
+	defer func() { eprReorderOwn = own }()
+	keys := makeTestKeys(t, 1)
+	writer := createTxForTest(t, 0, nsID1ForTest, nil, [][]byte{keys[0]}, nil) // reads and writes k
+	reader := createTxForTest(t, 1, nsID1ForTest, [][]byte{keys[0]}, nil, nil) // only reads k
+	out, aborted := eprReorder([]*servicepb.TxWithRef{writer, reader})
+	require.Empty(t, aborted, "no cycle: nothing aborted")
+	require.Equal(t, []*servicepb.TxWithRef{reader, writer}, out, "the reader is moved before the writer")
+}
+
+func TestEPRReorderBreaksReadModifyWriteCycles(t *testing.T) {
+	own := eprReorderOwn
+	eprReorderOwn = true // the reimplementation (FX_REORDER=own)
+	defer func() { eprReorderOwn = own }()
+	keys := makeTestKeys(t, 1)
+	var txs []*servicepb.TxWithRef
+	for i := range 5 {
+		txs = append(txs, createTxForTest(t, i, nsID1ForTest, nil, [][]byte{keys[0]}, nil))
+	}
+	out, aborted := eprReorder(txs)
+	require.Len(t, out, 5)
+	require.Len(t, aborted, 4, "read-modify-writes of one key: only one can commit, as in plain EOV")
+}
diff --git a/service/coordinator/dependencygraph/epr_ward.go b/service/coordinator/dependencygraph/epr_ward.go
new file mode 100644
index 0000000..42f9d00
--- /dev/null
+++ b/service/coordinator/dependencygraph/epr_ward.go
@@ -0,0 +1,80 @@
+/*
+Baseline (not upstream): the WARD ordering of HTFabric (Song et al., CIKM'24), in the Fabric-X coordinator.
+With FX_WARD=1 the transactions of every incoming batch (one block) are reordered before dependency
+construction, without aborting any: write-conflict degree ascending, then read-conflict degree descending,
+ties in the original order. Following the paper's Definitions 3.2-3.3 and its Figure 4 (its Algorithm 1 lists
+the two degree tables the other way round), the in-degree of a key is the number of transactions writing it
+and its out-degree the number reading it; wc(T) sums the out-degrees of T's write keys (how many transactions
+T's writes can invalidate) and rc(T) the in-degrees of T's read keys (how many can invalidate T).
+Combined with the parallel re-execution of d16reexec_v2 (-parallel), this is the HTFabric baseline.
+*/
+
+package dependencygraph
+
+import (
+	"os"
+	"sort"
+
+	"github.com/hyperledger/fabric-x-committer/api/servicepb"
+)
+
+var eprWardOn = os.Getenv("FX_WARD") == "1"
+
+func eprWard(txs []*servicepb.TxWithRef) []*servicepb.TxWithRef {
+	n := len(txs)
+	if n < 2 {
+		return txs
+	}
+	type rw struct{ reads, writes []string }
+	sets := make([]rw, n)
+	writers, readers := map[string]int{}, map[string]int{}
+	for i, tx := range txs {
+		if tx.Content == nil {
+			continue
+		}
+		for _, ns := range tx.Content.Namespaces {
+			for _, r := range ns.ReadsOnly {
+				k := ns.NsId + "\x00" + string(r.Key)
+				sets[i].reads = append(sets[i].reads, k)
+				readers[k]++
+			}
+			for _, x := range ns.ReadWrites {
+				k := ns.NsId + "\x00" + string(x.Key)
+				sets[i].reads = append(sets[i].reads, k)
+				sets[i].writes = append(sets[i].writes, k)
+				readers[k]++
+				writers[k]++
+			}
+			for _, w := range ns.BlindWrites {
+				k := ns.NsId + "\x00" + string(w.Key)
+				sets[i].writes = append(sets[i].writes, k)
+				writers[k]++
+			}
+		}
+	}
+	wc, rc := make([]int, n), make([]int, n)
+	for i := range sets {
+		for _, k := range sets[i].writes {
+			wc[i] += readers[k]
+		}
+		for _, k := range sets[i].reads {
+			rc[i] += writers[k]
+		}
+	}
+	idx := make([]int, n)
+	for i := range idx {
+		idx[i] = i
+	}
+	sort.SliceStable(idx, func(a, b int) bool {
+		i, j := idx[a], idx[b]
+		if wc[i] != wc[j] {
+			return wc[i] < wc[j] // write ascending
+		}
+		return rc[i] > rc[j] // read descending; stable sort keeps the original order on ties
+	})
+	out := make([]*servicepb.TxWithRef, n)
+	for p, i := range idx {
+		out[p] = txs[i]
+	}
+	return out
+}
