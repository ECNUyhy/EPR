@@ -0,0 +1,38 @@
+package vc
+
+import (
+	"math/big"
+	"testing"
+)
+
+func TestEPRProgramCodecAndEval(t *testing.T) {
+	// out = (x * y) / (x + 7), guard x > 3
+	p := &EPRProgram{
+		Keys: []string{"kx", "ky", "kout"},
+		Nodes: []EPRProgNode{
+			{Op: EPROpVar, A: 0, B: -1, C: -1},
+			{Op: EPROpVar, A: 1, B: -1, C: -1},
+			{Op: 0x02, A: 0, B: 1, C: -1},
+			{Op: EPROpConst, A: -1, B: -1, C: -1, Const: []byte{7}},
+			{Op: 0x01, A: 0, B: 3, C: -1},
+			{Op: 0x04, A: 2, B: 4, C: -1},
+			{Op: EPROpConst, A: -1, B: -1, C: -1, Const: []byte{3}},
+			{Op: 0x11, A: 0, B: 6, C: -1},
+		},
+		Guards:  []EPRProgGuard{{Node: 7, Kind: 1, Value: []byte{1}}},
+		Outputs: []EPRProgOut{{Key: 2, Node: 5}},
+	}
+	q, ok := DecodeEPRProgram(p.Encode())
+	if !ok {
+		t.Fatal("decode failed")
+	}
+	vals := map[string][]byte{"kx": big.NewInt(10).Bytes(), "ky": big.NewInt(34).Bytes()}
+	out, ok := q.Eval(func(k string) []byte { return vals[k] })
+	if !ok || new(big.Int).SetBytes(out["kout"]).Int64() != 20 { // 340 / 17
+		t.Fatalf("eval: ok=%v out=%x", ok, out["kout"])
+	}
+	vals["kx"] = big.NewInt(2).Bytes()
+	if _, ok := q.Eval(func(k string) []byte { return vals[k] }); ok {
+		t.Fatal("guard x > 3 should fail")
+	}
+}
diff --git a/service/vc/epr_reexec.go b/service/vc/epr_reexec.go
new file mode 100644
index 0000000..5925448
--- /dev/null
+++ b/service/vc/epr_reexec.go
@@ -0,0 +1,322 @@
+/*
+Baseline (not upstream): post-order re-execution at the validator-committer, XOX / HTFabric / ReX style.
+
+With FX_REEXEC_URL set, the VC re-executes every transaction whose stale reads it would otherwise repair:
+it sends the raw transactions of the batch, in ledger order, to a colocated EVM service (d16reexec_v2) that
+executes them against the latest committed state in this database, and waits for the result on the
+commit path. Endorsers attach each raw transaction as a blind write to a unique key "evmtx:<hash>"
+(a re-executing committer needs the transaction input, as in XOX); the VC strips these writes before
+commit. The committed values are cross-checked against the EPR evaluation of the same transactions: by
+Lemmas 1-2 they must be equal, and mismatches are counted.
+
+Early gossip (HTFabric, CIKM'24, Sec. 4.2; FX_EARLY_GOSSIP=1): the validator first passes on the batch
+without the re-executed transactions, which the committer commits (and so makes visible to endorsers) at
+once, then re-executes and passes on the rest. The two parts share no key: a batch the coordinator dispatches
+holds no conflicting transactions.
+
+Re-executing every invalid transaction (FX_REEXEC_ALL=1, XOX and HTFabric): a transaction with a stale read
+that EPR cannot repair is not aborted but re-executed too, and its re-executed storage writes replace its
+endorsed ones (as blind writes: the committer fetches their versions); a reverted re-execution aborts it.
+Without it, only the transactions EPR repairs are re-executed (cost only) and the rest abort.
+*/
+
+package vc
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"os"
+	"sort"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/hyperledger/fabric-x-common/api/committerpb"
+)
+
+var (
+	eprReexecAll   = os.Getenv("FX_REEXEC_ALL") == "1"
+	eprEarlyGossip = os.Getenv("FX_EARLY_GOSSIP") == "1"
+	eprLateWork    sync.Map // *validatedTransactions -> *eprLate (early gossip: re-execution deferred)
+	eprReexecURL   = os.Getenv("FX_REEXEC_URL")
+	eprRawTxPrefix = []byte("evmtx:")
+	eprReexecHTTP  = &http.Client{Timeout: 60 * time.Second}
+
+	eprReexecCalls, eprReexecTxs, eprReexecMicros atomic.Int64
+	eprReexecCompared, eprReexecMismatch          atomic.Int64
+	// per-transaction outcome: re-execution succeeded iff EPR committed the transaction
+	eprReexecTxCompared, eprReexecTxMismatch atomic.Int64
+)
+
+// eprStripRawTxs removes the raw-transaction carrier writes from every write set and returns them per tx.
+func (v *validatedTransactions) eprStripRawTxs() map[TxID][]byte {
+	out := map[TxID][]byte{}
+	for _, tw := range []transactionToWrites{v.validTxNonBlindWrites, v.validTxBlindWrites, v.newWrites} {
+		for tx, nsw := range tw {
+			for _, w := range nsw {
+				for i := 0; i < len(w.keys); {
+					if bytes.HasPrefix(w.keys[i], eprRawTxPrefix) {
+						out[tx] = w.values[i]
+						w.keys = append(w.keys[:i], w.keys[i+1:]...)
+						w.values = append(w.values[:i], w.values[i+1:]...)
+						w.versions = append(w.versions[:i], w.versions[i+1:]...)
+						continue
+					}
+					i++
+				}
+			}
+		}
+	}
+	return out
+}
+
+// eprReexecute re-executes the given transactions (ledger order) through the colocated EVM service and
+// returns the final value of every storage key they wrote and, per transaction, whether it succeeded.
+func (v *validatedTransactions) eprReexecute(ctx context.Context, txs map[TxID]bool, raws map[TxID][]byte) (map[string][]byte, map[TxID]bool, map[TxID]map[string][]byte, error) {
+	order := make([]TxID, 0, len(txs))
+	for tx := range txs {
+		if raws[tx] != nil {
+			order = append(order, tx)
+		}
+	}
+	if len(order) == 0 {
+		return nil, nil, nil, nil
+	}
+	sort.Slice(order, func(a, b int) bool {
+		ha, hb := v.txIDToHeight[order[a]], v.txIDToHeight[order[b]]
+		if ha == nil || hb == nil {
+			return string(order[a]) < string(order[b])
+		}
+		if ha.BlockNum != hb.BlockNum {
+			return ha.BlockNum < hb.BlockNum
+		}
+		return ha.TxNum < hb.TxNum
+	})
+	req := struct {
+		Txs    [][]byte   `json:"txs"`
+		Keys   []string   `json:"keys"`    // endorsed read keys of these txs: the service prefetches them in one query
+		TxKeys [][]string `json:"tx_keys"` // per transaction (request order): its endorsed read keys (HTFabric's TSP)
+	}{}
+	pos := make(map[TxID]int, len(order))
+	for i, tx := range order {
+		req.Txs = append(req.Txs, raws[tx])
+		pos[tx] = i
+	}
+	req.TxKeys = make([][]string, len(order))
+	seenKey := map[string]bool{}
+	for cr, ids := range v.readToTxIDs {
+		for _, id := range ids {
+			if i, ok := pos[id]; ok {
+				req.TxKeys[i] = append(req.TxKeys[i], cr.key)
+				if !seenKey[cr.key] {
+					seenKey[cr.key] = true
+					req.Keys = append(req.Keys, cr.key)
+				}
+			}
+		}
+	}
+	body, _ := json.Marshal(req)
+	start := time.Now()
+	hr, err := http.NewRequestWithContext(ctx, http.MethodPost, eprReexecURL, bytes.NewReader(body))
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	resp, err := eprReexecHTTP.Do(hr)
+	if err != nil {
+		return nil, nil, nil, fmt.Errorf("reexec: %w", err)
+	}
+	defer resp.Body.Close()
+	var out struct {
+		Final    map[string][]byte   `json:"final"`
+		OK       []bool              `json:"ok"`
+		TxWrites []map[string][]byte `json:"tx_writes"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&out); err != nil {
+		return nil, nil, nil, fmt.Errorf("reexec decode: %w", err)
+	}
+	oks := make(map[TxID]bool, len(order))
+	txw := make(map[TxID]map[string][]byte, len(order))
+	for i, tx := range order {
+		if i < len(out.OK) {
+			oks[tx] = out.OK[i]
+		}
+		if i < len(out.TxWrites) {
+			txw[tx] = out.TxWrites[i]
+		}
+	}
+	eprReexecCalls.Add(1)
+	eprReexecTxs.Add(int64(len(order)))
+	eprReexecMicros.Add(time.Since(start).Microseconds())
+	return out.Final, oks, txw, nil
+}
+
+// eprReexecCompare counts keys whose re-executed value differs from EPR's evaluated value.
+func eprReexecCompare(final map[string][]byte, epr map[string][]byte) {
+	for k, rv := range final {
+		ev, ok := epr[k]
+		if !ok {
+			continue
+		}
+		eprReexecCompared.Add(1)
+		if !bytes.Equal(bytes.TrimLeft(rv, "\x00"), bytes.TrimLeft(ev, "\x00")) {
+			eprReexecMismatch.Add(1)
+		}
+	}
+}
+
+// EPRReexecStats reports the re-execution baseline counters.
+func EPRReexecStats() (calls, txs, micros, compared, mismatch int64) {
+	return eprReexecCalls.Load(), eprReexecTxs.Load(), eprReexecMicros.Load(), eprReexecCompared.Load(), eprReexecMismatch.Load()
+}
+
+// eprReexecCompareTxs counts transactions whose re-execution outcome differs from EPR's validity decision.
+func eprReexecCompareTxs(oks map[TxID]bool, failed map[TxID]bool) {
+	for tx, ok := range oks {
+		eprReexecTxCompared.Add(1)
+		if ok == failed[tx] {
+			eprReexecTxMismatch.Add(1)
+		}
+	}
+}
+
+// EPRReexecTxStats reports the per-transaction outcome comparison.
+func EPRReexecTxStats() (compared, mismatch int64) {
+	return eprReexecTxCompared.Load(), eprReexecTxMismatch.Load()
+}
+
+// eprLate is the deferred re-execution of a batch under early gossip.
+type eprLate struct {
+	txs  map[TxID]bool
+	raws map[TxID][]byte
+	all  map[TxID]string // committed from re-execution (FX_REEXEC_ALL): tx -> namespace
+}
+
+// eprSplitEarlyGossip moves the transactions whose re-execution was deferred out of v into a second batch,
+// which it returns with the deferred work (nil if there is none).
+func (v *validatedTransactions) eprSplitEarlyGossip() (*validatedTransactions, *eprLate) {
+	w, ok := eprLateWork.LoadAndDelete(v)
+	if !ok {
+		return nil, nil
+	}
+	late := w.(*eprLate) //nolint:forcetypeassert
+	lv := &validatedTransactions{
+		validTxNonBlindWrites: transactionToWrites{},
+		validTxBlindWrites:    transactionToWrites{},
+		newWrites:             transactionToWrites{},
+		readToTxIDs:           readToTransactions{},
+		invalidTxStatus:       map[TxID]committerpb.Status{},
+		txIDToHeight:          v.txIDToHeight,
+		eprCredits:            map[TxID][]eprCreditEntry{},
+	}
+	moveW := func(from, to transactionToWrites) {
+		for tx, nsw := range from {
+			if late.txs[tx] {
+				to[tx] = nsw
+				delete(from, tx)
+			}
+		}
+	}
+	moveW(v.validTxNonBlindWrites, lv.validTxNonBlindWrites)
+	moveW(v.validTxBlindWrites, lv.validTxBlindWrites)
+	moveW(v.newWrites, lv.newWrites)
+	for tx, st := range v.invalidTxStatus {
+		if late.txs[tx] {
+			lv.invalidTxStatus[tx] = st
+			delete(v.invalidTxStatus, tx)
+		}
+	}
+	for tx, c := range v.eprCredits {
+		if late.txs[tx] {
+			lv.eprCredits[tx] = c
+			delete(v.eprCredits, tx)
+		}
+	}
+	for cr, ids := range v.readToTxIDs {
+		var early, rest []TxID
+		for _, id := range ids {
+			if late.txs[id] {
+				rest = append(rest, id)
+			} else {
+				early = append(early, id)
+			}
+		}
+		if len(rest) > 0 {
+			lv.readToTxIDs[cr] = rest
+			if len(early) > 0 {
+				v.readToTxIDs[cr] = early
+			} else {
+				delete(v.readToTxIDs, cr)
+			}
+		}
+	}
+	return lv, late
+}
+
+// eprRunLate re-executes the deferred transactions of the batch on the commit path.
+func (v *validatedTransactions) eprRunLate(ctx context.Context, late *eprLate) error {
+	_, oks, txw, err := v.eprReexecute(ctx, late.txs, late.raws)
+	eprEarlyGossipBatches.Add(1)
+	if err == nil && len(late.all) > 0 {
+		v.eprApplyReexecWrites(late.all, oks, txw)
+	}
+	return err
+}
+
+var eprEarlyGossipBatches atomic.Int64
+
+var eprReexecAllCommitted, eprReexecAllReverted, eprReexecAllNewKeys atomic.Int64
+
+// EPRReexecAllStats reports the transactions committed from re-execution, the reverted ones, and the
+// re-executed storage writes to keys the endorsed write set did not have (a changed execution path).
+func EPRReexecAllStats() (committed, reverted, newKeys int64) {
+	return eprReexecAllCommitted.Load(), eprReexecAllReverted.Load(), eprReexecAllNewKeys.Load()
+}
+
+// eprApplyReexecWrites commits the re-executed outcome of the given transactions: their storage writes
+// (endorsed or EPR-evaluated) are replaced by the re-executed ones, as blind writes whose versions the
+// committer fetches; a transaction whose re-execution reverted is aborted.
+func (v *validatedTransactions) eprApplyReexecWrites(all map[TxID]string, oks map[TxID]bool, txw map[TxID]map[string][]byte) {
+	storage := []byte("str:")
+	var reverted []TxID
+	for tx, ns := range all { // the namespace of its conflicting read: EPR may already have dropped its writes
+		endorsed := map[string]bool{}
+		for _, tw := range []transactionToWrites{v.validTxNonBlindWrites, v.validTxBlindWrites, v.newWrites} {
+			for _, w := range tw[tx] {
+				for i := 0; i < len(w.keys); {
+					if bytes.HasPrefix(w.keys[i], storage) {
+						endorsed[string(w.keys[i])] = true
+						w.keys = append(w.keys[:i], w.keys[i+1:]...)
+						w.values = append(w.values[:i], w.values[i+1:]...)
+						w.versions = append(w.versions[:i], w.versions[i+1:]...)
+						continue
+					}
+					i++
+				}
+			}
+		}
+		if !oks[tx] || ns == "" {
+			reverted = append(reverted, tx)
+			continue
+		}
+		delete(v.invalidTxStatus, tx) // EPR may have failed its guard; re-execution decides
+		keys := make([]string, 0, len(txw[tx]))
+		for k := range txw[tx] {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			if !endorsed[k] {
+				eprReexecAllNewKeys.Add(1)
+			}
+			v.validTxBlindWrites.getOrCreate(tx, ns).append([]byte(k), txw[tx][k], 0)
+		}
+		eprReexecAllCommitted.Add(1)
+	}
+	if len(reverted) > 0 {
+		eprReexecAllReverted.Add(int64(len(reverted)))
+		v.updateInvalidTxs(reverted, committerpb.Status_ABORTED_MVCC_CONFLICT)
+	}
+}
diff --git a/service/vc/epr_reexec_test.go b/service/vc/epr_reexec_test.go
new file mode 100644
index 0000000..4a6bc85
--- /dev/null
+++ b/service/vc/epr_reexec_test.go
@@ -0,0 +1,103 @@
+package vc
+
+// HTFabric baseline: the early-gossip split (epr_reexec.go).
+
+import (
+	"testing"
+
+	"github.com/hyperledger/fabric-x-common/api/committerpb"
+	"github.com/stretchr/testify/require"
+)
+
+func TestEPREarlyGossipSplit(t *testing.T) {
+	v := &validatedTransactions{
+		validTxNonBlindWrites: transactionToWrites{},
+		validTxBlindWrites:    transactionToWrites{},
+		newWrites:             transactionToWrites{},
+		readToTxIDs:           readToTransactions{},
+		invalidTxStatus:       map[TxID]committerpb.Status{"bad": committerpb.Status_ABORTED_MVCC_CONFLICT},
+		txIDToHeight:          transactionIDToHeight{},
+	}
+	v.validTxNonBlindWrites.getOrCreate("valid", "ns").append([]byte("a"), []byte("1"), 1)
+	v.validTxNonBlindWrites.getOrCreate("redo", "ns").append([]byte("b"), []byte("2"), 1)
+	v.newWrites.getOrCreate("redo", "ns").append([]byte("c"), []byte("3"), 0)
+	shared := newCmpRead("ns", []byte("r"), nil)
+	v.readToTxIDs[shared] = []TxID{"valid", "redo"}
+	v.readToTxIDs[newCmpRead("ns", []byte("b"), nil)] = []TxID{"redo"}
+
+	lv, late := v.eprSplitEarlyGossip()
+	require.Nil(t, lv, "nothing deferred: no split")
+	require.Nil(t, late)
+
+	eprLateWork.Store(v, &eprLate{txs: map[TxID]bool{"redo": true, "bad": true}})
+	lv, late = v.eprSplitEarlyGossip()
+	require.NotNil(t, lv)
+	require.True(t, late.txs["redo"])
+	require.Contains(t, v.validTxNonBlindWrites, TxID("valid"))
+	require.NotContains(t, v.validTxNonBlindWrites, TxID("redo"))
+	require.Contains(t, lv.validTxNonBlindWrites, TxID("redo"))
+	require.Contains(t, lv.newWrites, TxID("redo"))
+	require.Empty(t, v.newWrites)
+	require.Equal(t, committerpb.Status_ABORTED_MVCC_CONFLICT, lv.invalidTxStatus["bad"])
+	require.Empty(t, v.invalidTxStatus)
+	require.Equal(t, []TxID{"valid"}, v.readToTxIDs[shared])
+	require.Equal(t, []TxID{"redo"}, lv.readToTxIDs[shared])
+	require.Len(t, v.readToTxIDs, 1)
+	require.Len(t, lv.readToTxIDs, 2)
+	_, again := eprLateWork.Load(v)
+	require.False(t, again, "the deferred work is consumed")
+}
+
+func TestEPRApplyReexecWrites(t *testing.T) {
+	v := &validatedTransactions{
+		validTxNonBlindWrites: transactionToWrites{},
+		validTxBlindWrites:    transactionToWrites{},
+		newWrites:             transactionToWrites{},
+		readToTxIDs:           readToTransactions{},
+		invalidTxStatus:       map[TxID]committerpb.Status{"guard": committerpb.Status_ABORTED_MVCC_CONFLICT},
+		txIDToHeight:          transactionIDToHeight{},
+	}
+	// ok: endorsed storage write replaced, non-storage write kept, a new key from a changed path added
+	v.validTxNonBlindWrites.getOrCreate("ok", "basic").append([]byte("str:a"), []byte("stale"), 3)
+	v.validTxNonBlindWrites.getOrCreate("ok", "basic").append([]byte("acc:x:nonce"), []byte("n"), 1)
+	// reverted: aborted
+	v.validTxNonBlindWrites.getOrCreate("rev", "basic").append([]byte("str:b"), []byte("stale"), 2)
+	// guard: EPR failed its guard (writes dropped, invalid); re-execution succeeds and decides
+	// (its writes are gone, as updateInvalidTxs leaves them)
+	all := map[TxID]string{"ok": "basic", "rev": "basic", "guard": "basic"}
+	oks := map[TxID]bool{"ok": true, "rev": false, "guard": true}
+	txw := map[TxID]map[string][]byte{
+		"ok":    {"str:a": []byte("fresh"), "str:new": []byte("y")},
+		"guard": {"str:c": []byte("z")},
+	}
+	v.eprApplyReexecWrites(all, oks, txw)
+
+	ok := v.validTxNonBlindWrites["ok"]["basic"]
+	require.Equal(t, [][]byte{[]byte("acc:x:nonce")}, ok.keys, "storage writes leave the non-blind set")
+	bw := v.validTxBlindWrites["ok"]["basic"]
+	require.Equal(t, [][]byte{[]byte("str:a"), []byte("str:new")}, bw.keys)
+	require.Equal(t, [][]byte{[]byte("fresh"), []byte("y")}, bw.values)
+	require.Equal(t, committerpb.Status_ABORTED_MVCC_CONFLICT, v.invalidTxStatus["rev"])
+	require.NotContains(t, v.validTxNonBlindWrites, TxID("rev"))
+	require.NotContains(t, v.invalidTxStatus, TxID("guard"))
+	require.Equal(t, [][]byte{[]byte("str:c")}, v.validTxBlindWrites["guard"]["basic"].keys)
+}
+
+func TestEPRNoStorageWrites(t *testing.T) {
+	v := &validatedTransactions{
+		validTxNonBlindWrites: transactionToWrites{},
+		validTxBlindWrites:    transactionToWrites{},
+		newWrites:             transactionToWrites{},
+	}
+	v.validTxNonBlindWrites.getOrCreate("query", "basic").append([]byte("acc:0x1:nonce"), []byte("1"), 1)
+	v.validTxNonBlindWrites.getOrCreate("transfer", "basic").append([]byte("acc:0x2:nonce"), []byte("1"), 1)
+	v.newWrites.getOrCreate("transfer", "basic").append([]byte("str:0xa:0x1"), []byte("5"), 0)
+	require.True(t, v.eprNoStorageWrites([]TxID{"query"}), "a nonce write alone is not a storage write")
+	require.False(t, v.eprNoStorageWrites([]TxID{"transfer"}))
+	require.False(t, v.eprNoStorageWrites([]TxID{"query", "transfer"}), "every reader must be read-only")
+	require.False(t, v.eprNoStorageWrites(nil))
+	// a write to another account field (a balance) disqualifies it as well
+	v.validTxBlindWrites.getOrCreate("paying", "basic").append([]byte("acc:0x3:nonce"), []byte("1"), 1)
+	v.validTxNonBlindWrites.getOrCreate("paying", "basic").append([]byte("acc:0x3:bal"), []byte("9"), 1)
+	require.False(t, v.eprNoStorageWrites([]TxID{"paying"}))
+}
diff --git a/service/vc/epr_stale_test.go b/service/vc/epr_stale_test.go
new file mode 100644
index 0000000..dbb643f
--- /dev/null
+++ b/service/vc/epr_stale_test.go
@@ -0,0 +1,152 @@
+package vc
+
+// Stale reads are decided per transaction, so a batch and any split of it abort exactly the same readers, and a
+// reader that keeps its stale read takes no part in the batch's evaluation. Committed values are served as
+// prefetched, so these tests need no database.
+
+import (
+	"context"
+	"math"
+	"slices"
+	"sort"
+	"testing"
+
+	"github.com/hyperledger/fabric-x-common/api/committerpb"
+	"github.com/stretchr/testify/require"
+)
+
+// eprRunStale runs the VC's EPR step on one batch whose transactions read the given keys at a stale version
+// (stale: key -> readers). It returns the readers that keep a stale read, and the batch.
+func eprRunStale(t *testing.T, nb transactionToWrites, committed map[string]eprState, stale map[string][]TxID,
+	keys ...string) ([]TxID, *validatedTransactions) {
+	t.Helper()
+	oldOn, oldFast, oldRO := eprEnabled, eprFastPath, eprROSnapshot
+	eprEnabled, eprFastPath, eprROSnapshot = true, false, true
+	t.Cleanup(func() { eprEnabled, eprFastPath, eprROSnapshot = oldOn, oldFast, oldRO })
+	pf := &eprPrefetched{state: map[string]eprState{}, queried: map[string]bool{}, done: make(chan bool)}
+	close(pf.done)
+	for _, k := range keys {
+		pf.queried[eprTestNs+"\x00"+k] = true
+		if st, ok := committed[k]; ok {
+			pf.state[eprTestNs+"\x00"+k] = st
+		}
+	}
+	conflicts := namespaceToReads{}
+	rt := readToTransactions{}
+	for k, txs := range stale {
+		ver := uint64(0)
+		conflicts.getOrCreate(eprTestNs).append([]byte(k), &ver)
+		rt[newCmpRead(eprTestNs, []byte(k), &ver)] = append([]TxID{}, txs...)
+	}
+	v := &validatedTransactions{
+		validTxNonBlindWrites: nb,
+		validTxBlindWrites:    transactionToWrites{},
+		newWrites:             transactionToWrites{},
+		invalidTxStatus:       map[TxID]committerpb.Status{},
+		readToTxIDs:           rt,
+		eprPreWait:            func() *eprPrefetched { return pf },
+	}
+	rem, err := v.pilotRepairDeltas(context.Background(), nil, conflicts)
+	require.NoError(t, err)
+	var kept []TxID
+	for nsID, rc := range rem {
+		for i, key := range rc.keys {
+			kept = append(kept, v.readToTxIDs[newCmpRead(nsID, key, rc.versions[i])]...)
+		}
+	}
+	sort.Slice(kept, func(i, j int) bool { return kept[i] < kept[j] })
+	return slices.Compact(kept), v
+}
+
+const (
+	eprStH = "str:0xa:0x1" // hot balance
+	eprStK = "str:0xa:0x2" // another slot
+)
+
+// the transactions of the tests: a covered delta on H, a query (only a nonce write), a plain writer, a query
+// that also moves an account balance, and a delta on H that also has an uncovered stale read of K
+func eprStaleTxs() transactionToWrites {
+	nb := transactionToWrites{}
+	nb.getOrCreate("d1", eprTestNs).append([]byte(eprStH), eprTestDelta(5, 0, math.MaxInt64), 1)
+	nb.getOrCreate("q1", eprTestNs).append([]byte("acc:0xq:nonce"), eprTestWord(1), 1)
+	nb.getOrCreate("x1", eprTestNs).append([]byte(eprStK), eprTestWord(7), 1)
+	nb.getOrCreate("q2", eprTestNs).append([]byte("acc:0xq:balance"), eprTestWord(3), 1)
+	nb.getOrCreate("d2", eprTestNs).append([]byte(eprStH), eprTestDelta(7, 0, math.MaxInt64), 1)
+	return nb
+}
+
+// eprSubset returns fresh copies of the given transactions (a run rewrites the writes it evaluates)
+func eprSubset(_ transactionToWrites, txs ...TxID) transactionToWrites {
+	fresh := eprStaleTxs()
+	out := transactionToWrites{}
+	for _, tx := range txs {
+		out[tx] = fresh[tx]
+	}
+	return out
+}
+
+func TestEPRStaleReadsPerTransaction(t *testing.T) {
+	committed := map[string]eprState{eprStH: {value: eprTestWord(100), version: 1}, eprStK: {value: eprTestWord(0), version: 1}}
+	all := eprStaleTxs()
+
+	// (a) a covered delta, a query and a plain reader share one stale read: only the plain reader keeps it
+	kept, v := eprRunStale(t, eprSubset(all, "d1", "q1", "x1"), committed,
+		map[string][]TxID{eprStH: {"d1", "q1", "x1"}}, eprStH, eprStK)
+	require.Equal(t, []TxID{"x1"}, kept)
+	val, _, ok := eprWriteOf(v.validTxNonBlindWrites, "d1", eprStH)
+	require.True(t, ok)
+	require.Equal(t, eprTestWord(105), val)
+
+	// (b) a query that also writes an account balance is not a query: it keeps its stale read
+	kept, _ = eprRunStale(t, eprSubset(all, "q2"), committed, map[string][]TxID{eprStH: {"q2"}}, eprStH)
+	require.Equal(t, []TxID{"q2"}, kept)
+
+	// (c) the batch and every single transaction of it keep the same readers; a query alone is committed at
+	// its snapshot too (no early return for batches without signed content)
+	batch := []TxID{"d1", "q1", "x1", "q2"}
+	keptBatch, _ := eprRunStale(t, eprSubset(all, batch...), committed, map[string][]TxID{eprStH: batch}, eprStH, eprStK)
+	var keptSingles []TxID
+	for _, tx := range batch {
+		k, _ := eprRunStale(t, eprSubset(all, tx), committed, map[string][]TxID{eprStH: {tx}}, eprStH, eprStK)
+		keptSingles = append(keptSingles, k...)
+	}
+	sort.Slice(keptSingles, func(i, j int) bool { return keptSingles[i] < keptSingles[j] })
+	require.Equal(t, keptBatch, keptSingles)
+	require.Equal(t, []TxID{"q2", "x1"}, keptBatch)
+
+	// (d) a delta whose transaction keeps another stale read (K, uncovered) is left out of the evaluation: the
+	// valid delta d2 on H lands on the committed 100, not on 100 + 5
+	kept, v = eprRunStale(t, eprSubset(all, "d1", "d2"), committed,
+		map[string][]TxID{eprStH: {"d1", "d2"}, eprStK: {"d1"}}, eprStH, eprStK)
+	require.Equal(t, []TxID{"d1"}, kept)
+	val, _, ok = eprWriteOf(v.validTxNonBlindWrites, "d2", eprStH)
+	require.True(t, ok)
+	require.Equal(t, eprTestWord(107), val)
+}
+
+func TestEPRStaleKeepPerTransaction(t *testing.T) {
+	kind := map[TxID]string{"d1": "delta", "q1": "query", "x1": "plain"}
+	keep, nr, ns := eprStaleKeep([]TxID{"d1", "q1", "x1"},
+		func(tx TxID) bool { return kind[tx] == "delta" }, func(tx TxID) bool { return kind[tx] == "query" })
+	require.Equal(t, []TxID{"x1"}, keep)
+	require.Equal(t, 1, nr)
+	require.Equal(t, 1, ns)
+}
+
+// A delta that brings a contract-storage balance to zero writes it as the endorser does (no value), so a key's
+// bytes do not depend on whether it was endorsed or evaluated; other values keep the 32-byte word.
+func TestEPRZeroStorageCanonical(t *testing.T) {
+	committed := map[string]eprState{eprStH: {value: eprTestWord(100), version: 1}, eprStK: {value: eprTestWord(40), version: 1}}
+	nb := transactionToWrites{}
+	nb.getOrCreate("z1", eprTestNs).append([]byte(eprStH), eprTestDelta(-100, 0, math.MaxInt64), 1)
+	nb.getOrCreate("z2", eprTestNs).append([]byte(eprStK), eprTestDelta(-30, 0, math.MaxInt64), 1)
+	_, v := eprRunStale(t, nb, committed, map[string][]TxID{}, eprStH, eprStK)
+	val, _, ok := eprWriteOf(v.validTxNonBlindWrites, "z1", eprStH)
+	require.True(t, ok)
+	require.NotNil(t, val)
+	require.Empty(t, val)
+	val, _, ok = eprWriteOf(v.validTxNonBlindWrites, "z2", eprStK)
+	require.True(t, ok)
+	require.Equal(t, eprTestWord(10), val)
+	require.Equal(t, make([]byte, 8), eprCanonStorage("acc:0xq:balance", make([]byte, 8)))
+}
diff --git a/service/vc/epr_vc2_test.go b/service/vc/epr_vc2_test.go
new file mode 100644
index 0000000..2cbd4b6
--- /dev/null
+++ b/service/vc/epr_vc2_test.go
@@ -0,0 +1,49 @@
+package vc
+
+import (
+	"math"
+	"testing"
+)
+
+func TestPilotEPRD2Codec(t *testing.T) {
+	enc := func(d, l, u int64, w byte) []byte {
+		b := append([]byte{}, eprMagic2...)
+		for _, x := range []int64{d, l, u} {
+			b = append(b, eprEncodeBalance(x)...)
+		}
+		return append(b, w)
+	}
+	d, l, u, w, ok := eprDecode2(enc(-5, 0, math.MaxInt64, 32))
+	if !ok || d != -5 || l != 0 || u != math.MaxInt64 || w != 32 {
+		t.Fatalf("decode2: %d %d %d %d %v", d, l, u, w, ok)
+	}
+	if _, _, _, _, ok := eprDecode2(enc(1, 1, 1, 7)); ok {
+		t.Fatal("bad width accepted")
+	}
+	if _, _, ok := eprDecode(enc(1, 1, 1, 8)); ok {
+		t.Fatal("EPRD2 decoded as EPRD1")
+	}
+	word := eprEncodeWidth(123456789, 32)
+	if len(word) != 32 {
+		t.Fatal("width")
+	}
+	if x, ok := eprBalanceOK(word); !ok || x != 123456789 {
+		t.Fatalf("word parse %d %v", x, ok)
+	}
+	if x, ok := eprBalanceOK(nil); !ok || x != 0 {
+		t.Fatal("empty")
+	}
+	big := make([]byte, 32)
+	big[0] = 1
+	if _, ok := eprBalanceOK(big); ok {
+		t.Fatal("out-of-range word accepted")
+	}
+	hi := make([]byte, 32)
+	hi[24] = 0x80
+	if _, ok := eprBalanceOK(hi); ok {
+		t.Fatal("word >= 2^63 accepted")
+	}
+	if _, ok := eprBalanceOK([]byte{1, 2, 3}); ok {
+		t.Fatal("odd length accepted")
+	}
+}
